---
import { Image } from "astro:assets";
import { render, type CollectionEntry } from "astro:content";
import FontSizeControl from "../components/FontSizeControl.astro";
import Giscus from "../components/Giscus.astro";
import MermaidSupport from "../components/MermaidSupport.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { siteConfig } from "../config/site";
import { getSeriesPosts, postHref } from "../utils/collections";
import { estimateReadingMinutes, normalizeTaxonomy } from "../utils/content";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const body = "body" in post && typeof post.body === "string" ? post.body : "";
const dateFormatter = new Intl.DateTimeFormat("zh-TW", { dateStyle: "long" });
const index = posts.findIndex((item) => item.id === post.id);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 ? posts[index + 1] : undefined;
const seriesPosts = post.data.series
  ? getSeriesPosts(posts, post.data.series)
  : [];
const canonical = post.data.canonicalUrl;
const pageUrl = new URL(postHref(post), Astro.site);
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
  inLanguage: siteConfig.language,
  mainEntityOfPage: canonical ?? pageUrl.href,
  author: {
    "@type": "Person",
    name: siteConfig.author,
    url: siteConfig.github,
  },
  publisher: { "@type": "Person", name: siteConfig.author },
  image: post.data.cover
    ? new URL(post.data.cover.src, Astro.site).href
    : new URL(siteConfig.defaultSocialImage, Astro.site).href,
  keywords: post.data.tags.join(", "),
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover?.src}
  canonicalUrl={canonical}
  type="article"
  publishDate={post.data.publishDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  jsonLd={articleJsonLd}
>
  <article class="page shell">
    <header class="article-header">
      {
        post.data.draft && (
          <p class="eyebrow">草稿預覽，不會出現在 production build</p>
        )
      }
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      <p class="article-header__description">{post.data.description}</p>

      <div class="article-meta">
        <div class="meta-item">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <time datetime={post.data.publishDate.toISOString()}>
            發布於 {dateFormatter.format(post.data.publishDate)}
          </time>
        </div>
        {
          post.data.updatedDate && (
            <>
              <span class="meta-dot">·</span>
              <time datetime={post.data.updatedDate.toISOString()}>
                更新於 {dateFormatter.format(post.data.updatedDate)}
              </time>
            </>
          )
        }
        <span class="meta-dot">·</span>
        <div class="meta-item">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span>{estimateReadingMinutes(body)} 分鐘閱讀</span>
        </div>
      </div>

      <div class="article-toolbar">
        <ul class="tag-list" aria-label="文章標籤">
          {
            post.data.tags.map((tag) => (
              <li>
                <a
                  class="tag"
                  href={`/tags/${encodeURIComponent(normalizeTaxonomy(tag))}/`}
                >
                  {tag}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="article-tools">
          <FontSizeControl />
        </div>
      </div>
    </header>

    {
      post.data.cover && (
        <Image
          class="article-cover"
          src={post.data.cover}
          alt={post.data.coverAlt ?? ""}
          widths={[640, 960, 1280]}
          sizes="(min-width: 1200px) 1120px, calc(100vw - 2rem)"
          loading="eager"
        />
      )
    }

    <div class="article-body">
      <TableOfContents headings={headings} />
      <div class="prose">
        <Content />
      </div>
    </div>
    <MermaidSupport />

    <footer class="article-footer">
      {
        post.data.repositoryUrl && (
          <p class="article-repo-link">
            <a class="text-link" href={post.data.repositoryUrl}>
              <span>查看本文相關 repository</span>
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
          </p>
        )
      }
      {
        post.data.series && seriesPosts.length > 0 && (
          <section class="series-section" aria-labelledby="series-posts">
            <h2 id="series-posts">同系列文章：{post.data.series}</h2>
            <ol class="series-list">
              {seriesPosts.map((item) => (
                <li>
                  <a
                    href={postHref(item)}
                    aria-current={item.id === post.id ? "page" : undefined}
                  >
                    {item.data.title}
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )
      }
      {
        (older || newer) && (
          <nav class="post-nav" aria-label="上一篇與下一篇">
            {older ? (
              <a href={postHref(older)}>
                <span>上一篇（較舊）</span>
                <strong>{older.data.title}</strong>
              </a>
            ) : (
              <span />
            )}
            {newer && (
              <a href={postHref(newer)}>
                <span>下一篇（較新）</span>
                <strong>{newer.data.title}</strong>
              </a>
            )}
          </nav>
        )
      }
      <Giscus />
    </footer>
  </article>
</BaseLayout>

<style>
  .article-body {
    display: grid;
    /* minmax(0, 1fr)：grid item 的自動最小尺寸是 min-content，
       不壓成 0 的話表格的 min-width 會把整篇內文撐出容器 */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
  }

  /* .prose 帶 margin-inline: auto，grid item 有自動邊界時 stretch 會失效，
     改用 fit-content 計算而撐出軌道；明確給 width 才會跟著軌道走 */
  .article-body .prose {
    min-width: 0;
    width: 100%;
  }

  /* 74rem 版心扣掉 46rem 內文後仍有餘裕，寬螢幕才把目錄挪到側欄。 */
  @media (min-width: 72rem) {
    .article-body {
      grid-template-columns: minmax(0, 1fr) 15rem;
      align-items: start;
      column-gap: var(--space-2xl);
    }

    .article-body :global(.toc) {
      grid-column: 2;
      grid-row: 1;
    }

    .article-body .prose {
      grid-column: 1;
      grid-row: 1;
    }
  }
  .series-section {
    padding: var(--space-xl);
    border-radius: var(--radius-lg);
    border: var(--rule-hair) solid var(--color-rule);
    background: var(--color-paper-2);
    display: grid;
    gap: var(--space-md);
  }

  .series-section h2 {
    font-size: var(--text-md);
    font-weight: 700;
  }

  .series-list {
    display: grid;
    gap: var(--space-xs);
    padding-inline-start: 1.25rem;
    margin: 0;
  }

  .series-list a {
    color: var(--color-ink-2);
    font-weight: 600;
    text-decoration: none;
  }

  .series-list a[aria-current="page"] {
    color: var(--color-accent);
    font-weight: 700;
  }

  .series-list a:hover {
    color: var(--color-accent);
  }
</style>
