---
import { Image } from "astro:assets";
import { render, type CollectionEntry } from "astro:content";
import FontSizeControl from "../components/FontSizeControl.astro";
import Giscus from "../components/Giscus.astro";
import MermaidSupport from "../components/MermaidSupport.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { siteConfig } from "../config/site";
import { getSeriesPosts, postHref } from "../utils/collections";
import { estimateReadingMinutes, normalizeTaxonomy } from "../utils/content";
import { buildShareUrls } from "../utils/share";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const body = "body" in post && typeof post.body === "string" ? post.body : "";
const dateFormatter = new Intl.DateTimeFormat("zh-TW", { dateStyle: "long" });
const index = posts.findIndex((item) => item.id === post.id);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 ? posts[index + 1] : undefined;
const seriesPosts = post.data.series
  ? getSeriesPosts(posts, post.data.series)
  : [];
const canonical = post.data.canonicalUrl;
const pageUrl = new URL(postHref(post), Astro.site);
const shareUrls = buildShareUrls({
  title: post.data.title,
  pageUrl: pageUrl.href,
  canonicalUrl: canonical,
});
const personId = new URL("/about/#person", Astro.site).href;
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
  inLanguage: siteConfig.language,
  mainEntityOfPage: canonical ?? pageUrl.href,
  author: { "@id": personId },
  publisher: { "@id": personId },
  image: post.data.cover
    ? new URL(post.data.cover.src, Astro.site).href
    : new URL(siteConfig.defaultSocialImage, Astro.site).href,
  keywords: post.data.tags.join(", "),
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover?.src}
  imageAlt={post.data.coverAlt}
  canonicalUrl={canonical}
  type="article"
  publishDate={post.data.publishDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  jsonLd={articleJsonLd}
>
  <article class="page shell">
    <header class="article-header">
      {
        post.data.draft && (
          <p class="eyebrow">草稿預覽，不會出現在 production build</p>
        )
      }
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      <p class="article-header__description">{post.data.description}</p>

      <div class="article-meta">
        <div class="meta-item">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <time datetime={post.data.publishDate.toISOString()}>
            發布於 {dateFormatter.format(post.data.publishDate)}
          </time>
        </div>
        {
          post.data.updatedDate && (
            <>
              <span class="meta-dot">·</span>
              <time datetime={post.data.updatedDate.toISOString()}>
                更新於 {dateFormatter.format(post.data.updatedDate)}
              </time>
            </>
          )
        }
        <span class="meta-dot">·</span>
        <div class="meta-item">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span>{estimateReadingMinutes(body)} 分鐘閱讀</span>
        </div>
      </div>

      <div class="article-toolbar">
        <ul class="tag-list" aria-label="文章標籤">
          {
            post.data.tags.map((tag) => (
              <li>
                <a
                  class="tag"
                  href={`/tags/${encodeURIComponent(normalizeTaxonomy(tag))}/`}
                >
                  {tag}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="article-tools">
          <FontSizeControl />
        </div>
      </div>
    </header>

    {
      post.data.cover && (
        <Image
          class="article-cover"
          src={post.data.cover}
          alt={post.data.coverAlt ?? ""}
          widths={[640, 960, 1280]}
          sizes="(min-width: 1200px) 1120px, calc(100vw - 2rem)"
          loading="eager"
        />
      )
    }

    <div class="article-body">
      <TableOfContents headings={headings} />
      <div class="prose">
        <Content />
      </div>
    </div>
    <MermaidSupport />

    <footer class="article-footer">
      <section class="article-share" aria-labelledby="article-share-title">
        <h2 id="article-share-title">分享這篇文章</h2>
        <div class="article-share__actions">
          <a
            href={shareUrls.x}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="分享到 X"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.211l-5.13-6.817-5.967 6.817H1.803l7.73-8.835L1.254 2.25H8.08l4.638 6.176L18.244 2.25Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"
              ></path>
            </svg>
            <span>X</span>
          </a>
          <a
            href={shareUrls.linkedIn}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="分享到 LinkedIn"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M20.452 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.851-3.037-1.853 0-2.136 1.446-2.136 2.939v5.667H9.357V9h3.413v1.561h.048c.476-.9 1.637-1.849 3.37-1.849 3.601 0 4.267 2.37 4.267 5.455v6.285ZM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125ZM7.114 20.452H3.555V9h3.559v11.452Z"
              ></path>
            </svg>
            <span>LinkedIn</span>
          </a>
          <a
            href={shareUrls.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="分享到 Facebook"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.095 10.125 24v-8.437H7.078v-3.49h3.047V9.413c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.235 2.686.235v2.97h-1.513c-1.49 0-1.956.931-1.956 1.886v2.266h3.328l-.532 3.49h-2.796V24C19.612 23.095 24 18.1 24 12.073Z"
              ></path>
            </svg>
            <span>Facebook</span>
          </a>
          <button
            type="button"
            data-share-copy
            data-share-url={shareUrls.shareUrl}
            aria-label="複製文章連結"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="9" y="9" width="13" height="13" rx="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
              ></path>
            </svg>
            <span>複製連結</span>
          </button>
        </div>
        <p class="article-share__status" data-share-status aria-live="polite">
        </p>
      </section>
      {
        post.data.repositoryUrl && (
          <p class="article-repo-link">
            <a
              class="text-link"
              href={post.data.repositoryUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>查看本文相關 repository</span>
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
              </svg>
            </a>
          </p>
        )
      }
      {
        post.data.series && seriesPosts.length > 0 && (
          <section class="series-section" aria-labelledby="series-posts">
            <h2 id="series-posts">同系列文章：{post.data.series}</h2>
            <ol class="series-list">
              {seriesPosts.map((item) => (
                <li>
                  <a
                    href={postHref(item)}
                    aria-current={item.id === post.id ? "page" : undefined}
                  >
                    {item.data.title}
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )
      }
      {
        (older || newer) && (
          <nav class="post-nav" aria-label="上一篇與下一篇">
            {older ? (
              <a href={postHref(older)}>
                <span>上一篇（較舊）</span>
                <strong>{older.data.title}</strong>
              </a>
            ) : (
              <span />
            )}
            {newer && (
              <a href={postHref(newer)}>
                <span>下一篇（較新）</span>
                <strong>{newer.data.title}</strong>
              </a>
            )}
          </nav>
        )
      }
      <Giscus />
    </footer>
  </article>
</BaseLayout>

<script>
  import { copyShareUrl } from "../utils/share";

  const copyButton =
    document.querySelector<HTMLButtonElement>("[data-share-copy]");
  const shareStatus = document.querySelector<HTMLElement>(
    "[data-share-status]",
  );

  copyButton?.addEventListener("click", async () => {
    const message = await copyShareUrl(
      navigator.clipboard,
      copyButton.dataset.shareUrl ?? "",
    );
    if (shareStatus) shareStatus.textContent = message;
  });
</script>

<style>
  .article-share {
    display: grid;
    gap: var(--space-sm);
  }

  .article-share h2 {
    color: var(--color-ink);
    font-size: var(--text-md);
  }

  .article-share__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .article-share__actions a,
  .article-share__actions button {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.7rem;
    border: var(--rule-hair) solid var(--color-rule-2);
    border-radius: var(--radius-sm);
    background: var(--color-card);
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1;
    transition:
      border-color var(--dur-micro) var(--ease-out),
      color var(--dur-micro) var(--ease-out),
      transform var(--dur-micro) var(--ease-out);
  }

  .article-share__actions svg {
    width: 1.1rem;
    height: 1.1rem;
    flex: 0 0 auto;
  }

  .article-share__actions a:hover,
  .article-share__actions button:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-1px);
  }

  .article-share__status {
    min-height: 1.5em;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .article-body {
    display: grid;
    /* minmax(0, 1fr)：grid item 的自動最小尺寸是 min-content，
       不壓成 0 的話表格的 min-width 會把整篇內文撐出容器 */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
  }

  /* .prose 帶 margin-inline: auto，grid item 有自動邊界時 stretch 會失效，
     改用 fit-content 計算而撐出軌道；明確給 width 才會跟著軌道走 */
  .article-body .prose {
    min-width: 0;
    width: 100%;
  }

  /* 74rem 版心扣掉 46rem 內文後仍有餘裕，寬螢幕才把目錄挪到側欄。 */
  @media (min-width: 72rem) {
    .article-body {
      grid-template-columns: minmax(0, 1fr) 15rem;
      align-items: start;
      column-gap: var(--space-2xl);
    }

    .article-body :global(.toc) {
      grid-column: 2;
      grid-row: 1;
    }

    .article-body .prose {
      grid-column: 1;
      grid-row: 1;
    }
  }
  .series-section {
    padding: var(--space-xl);
    border-radius: var(--radius-lg);
    border: var(--rule-hair) solid var(--color-rule);
    background: var(--color-paper-2);
    display: grid;
    gap: var(--space-md);
  }

  .series-section h2 {
    font-size: var(--text-md);
    font-weight: 700;
  }

  .series-list {
    display: grid;
    gap: var(--space-xs);
    padding-inline-start: 1.25rem;
    margin: 0;
  }

  .series-list a {
    color: var(--color-ink-2);
    font-weight: 600;
    text-decoration: none;
  }

  .series-list a[aria-current="page"] {
    color: var(--color-accent);
    font-weight: 700;
  }

  .series-list a:hover {
    color: var(--color-accent);
  }
</style>
