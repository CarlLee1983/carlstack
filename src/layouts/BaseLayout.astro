---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Seo from "../components/Seo.astro";
import { siteConfig } from "../config/site";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonicalUrl?: string;
  type?: "website" | "article";
  publishDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.description,
  image,
  imageAlt,
  canonicalUrl,
  type,
  publishDate,
  updatedDate,
  tags,
  jsonLd,
  noindex = false,
} = Astro.props;
const personId = new URL("/about/#person", Astro.site).href;
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": new URL("/#website", Astro.site).href,
      name: siteConfig.name,
      description: siteConfig.description,
      inLanguage: siteConfig.language,
      url: Astro.site?.href,
      author: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: siteConfig.author,
      url: new URL("/about/", Astro.site).href,
      sameAs: [siteConfig.github],
    },
  ],
};
const jsonLdItems = [
  websiteJsonLd,
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
];
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.name} RSS`}
      href="/rss.xml"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Seo
      title={title}
      description={description}
      path={Astro.url.pathname}
      image={image}
      imageAlt={imageAlt}
      canonicalUrl={canonicalUrl}
      type={type}
      publishDate={publishDate}
      updatedDate={updatedDate}
      tags={tags}
      noindex={noindex}
    />
    {
      jsonLdItems.map((item) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(item).replace(/</g, "\\u003c")}
        />
      ))
    }
    <script is:inline>
      // localStorage 保存的是使用者的明確選擇（沒有值代表跟隨系統）；
      // data-theme 一律寫入解析後的結果，讓元件只需要判斷 [data-theme="dark"]。
      const systemDark = matchMedia("(prefers-color-scheme: dark)");
      const savedTheme = localStorage.getItem("carlstack-theme");
      const resolveTheme = () =>
        savedTheme === "light" || savedTheme === "dark"
          ? savedTheme
          : systemDark.matches
            ? "dark"
            : "light";
      document.documentElement.dataset.theme = resolveTheme();
      if (savedTheme !== "light" && savedTheme !== "dark") {
        systemDark.addEventListener("change", (event) => {
          document.documentElement.dataset.theme = event.matches
            ? "dark"
            : "light";
        });
      }

      const savedFontScale = localStorage.getItem("carlstack-font-scale");
      if (savedFontScale) {
        document.documentElement.dataset.fontScale = savedFontScale;
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳至主要內容</a>
    <Header />
    <main id="main-content" data-pagefind-body={noindex ? undefined : ""}>
      <slot />
    </main>
    <Footer />
    {
      analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
  </body>
</html>
