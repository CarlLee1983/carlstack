    viewBox="0 0 960 620"
    role="img"
    aria-labelledby="ddd-mm-diagram-title ddd-mm-diagram-desc"
  >
    <title id="ddd-mm-diagram-title">
      模組化單體（Modular Monolith）與 AI Agent 語義隔離防禦體系
