    >
  </svg>
</LabFigure>

<script>
  import { initialStep, play } from "../utils/lab/index.ts";
  import type {
    EdgeDecision,
    KioskStatus,
    PlaybackAuthState,
    ViewerId,
  } from "../utils/lab/index.ts";
  import {
    along,
    roundTrip,
    segmentPath,
    staggered,
    translate,
    type Vec,
  } from "../utils/lab-geometry.ts";
  import {
    mountLabFigure,
    partsOf,
    placeBead,
    setFlag,
    setLevel,
  } from "../utils/lab-player.ts";

  // 由 build script 依等角投影算好的常數：世界座標每單位在 viewBox 中的位移、錨點與脈衝路線。
  const GEO: {
    VX: Vec;
    VY: Vec;
    VZ: Vec;
    ARM_C: Vec;
    ARM_L: number;
    SAND_H: number;
    TICKET_OUT: number;
    SHUTTER_TRAVEL: number;
    ROUTES: Record<
      | "viewer"
      | "newcomer"
      | "probeViewer"
      | "probeNewcomer"
      | "kioskViewer"
      | "kioskNewcomer"
      | "origin",
      Vec[]
    >;
  } = {
    VX: [1.603, 0.463],
    VY: [-0.925, 0.801],
    VZ: [0, -1.603],
    ARM_C: [378.2, 199.4],
    ARM_L: 13,
    SAND_H: 16,
    TICKET_OUT: 4,
    SHUTTER_TRAVEL: 13,
    ROUTES: {
      viewer: [
        [389.8, 186.2],
        [347.3, 223.1],
        [449.8, 252.7],
      ],
      newcomer: [
        [389.8, 186.2],
        [347.3, 223.1],
        [247.9, 194.4],
      ],
      probeViewer: [
        [449.8, 252.7],
        [347.3, 223.1],
        [362.1, 210.3],
      ],
      kioskViewer: [
        [474.8, 259.9],
        [474.8, 215.1],
        [152.8, 38.7],
        [152.8, 93.2],
      ],
      kioskNewcomer: [
        [256.9, 197],
        [256.9, 152.1],
        [152.8, 38.7],
        [152.8, 93.2],
      ],
      probeNewcomer: [
        [247.9, 194.4],
        [347.3, 223.1],
        [362.1, 210.3],
      ],
      origin: [
        [464.7, 173.7],
        [439.5, 166.4],
      ],
    },
  };

  const MECHANISM = "playback-auth";
  const VIEWERS: ViewerId[] = ["viewer", "newcomer"];
  const KEYS = [
    "shutter",
    "ticket",
    "arm",
    "sandViewer",
    "sandNewcomer",
    "segment",
    "probe",
    "kiosk",
    "origin",
  ] as const;
  const KIOSK_LAMP: Record<KioskStatus, string> = {
    idle: "off",
    issuing: "on",
    unavailable: "red",
  };
  const GATE_LAMP: Record<EdgeDecision, string> = {
    none: "off",
    allowed: "green",
    denied: "red",
  };
  const PROBE_ROUTE: Record<ViewerId, Vec[]> = {
    viewer: GEO.ROUTES.probeViewer,
    newcomer: GEO.ROUTES.probeNewcomer,
  };
  const KIOSK_ROUTE: Record<ViewerId, Vec[]> = {
    viewer: GEO.ROUTES.kioskViewer,
    newcomer: GEO.ROUTES.kioskNewcomer,
  };
  type AuthMotion = Record<(typeof KEYS)[number], number>;

  /** 由一步的 state 算出各連續量的目標值；脈衝的目標固定為 1，出發點由 render 決定。 */
  function targetsOf(state: PlaybackAuthState): AuthMotion {
    return {
      shutter: state.kiosk === "unavailable" ? 1 : 0,
      ticket: state.kiosk === "issuing" ? 1 : 0,
      arm: state.edge.decision === "allowed" ? Math.PI / 2 : 0,
      sandViewer: state.viewers.viewer.pass.share,
      sandNewcomer: state.viewers.newcomer.pass.share,
      segment: 1,
      probe: 1,
      kiosk: 1,
      origin: 1,
    };
  }

  function query(root: HTMLElement) {
    const { svg, one, lamp } = partsOf(root, "售票亭圖");
    const route = (name: string) =>
      Array.from(
        one<SVGGElement>(
          `.vpa-beads[data-route="${name}"]`,
        ).querySelectorAll<SVGCircleElement>("circle"),
      );
    return {
      lamps: {
        kiosk: lamp("kiosk"),
        origin: lamp("origin"),
        cache: lamp("cache"),
        gate: lamp("gate"),
      },
      shutter: one<SVGGElement>(".vpa-shutter"),
      ticket: one<SVGGElement>(".vpa-ticket"),
      arms: svg.querySelectorAll<SVGPathElement>(".vpa-arm, .vpa-arm__edge"),
      sand: {
        viewer: one<SVGGElement>('.vpa-pass[data-viewer="viewer"] .vpa-sand'),
        newcomer: one<SVGGElement>(
          '.vpa-pass[data-viewer="newcomer"] .vpa-sand',
        ),
      },
      passes: {
        viewer: one<SVGGElement>('.vpa-pass[data-viewer="viewer"]'),
        newcomer: one<SVGGElement>('.vpa-pass[data-viewer="newcomer"]'),
      },
      screens: {
        viewer: one<SVGGElement>('.vpa-screen[data-viewer="viewer"]'),
        newcomer: one<SVGGElement>('.vpa-screen[data-viewer="newcomer"]'),
      },
      appDiscs: svg.querySelectorAll<SVGGElement>('[data-counter="app"]'),
      cdnDiscs: svg.querySelectorAll<SVGGElement>('[data-counter="cdn"]'),
      segmentBeads: route("segment"),
      probeBeads: route("probe"),
      kioskBeads: route("kiosk"),
      kioskBeadGroup: one<SVGGElement>('.vpa-beads[data-route="kiosk"]'),
      buffers: {
        viewer: svg.querySelectorAll<SVGGElement>(
          '.vpa-screen[data-viewer="viewer"] .vpa-buffer',
        ),
        newcomer: svg.querySelectorAll<SVGGElement>(
          '.vpa-screen[data-viewer="newcomer"] .vpa-buffer',
        ),
      },
      originBeads: route("origin"),
    };
  }

  function mount(root: HTMLElement) {
    const parts = query(root);
    // 目前各種脈衝走哪條路。
    let segmentRoute: Vec[] = GEO.ROUTES.viewer;
    let probeRoute: Vec[] = GEO.ROUTES.probeViewer;
    let kioskRoute: Vec[] = GEO.ROUTES.kioskViewer;

    function draw(at: AuthMotion) {
      parts.shutter.setAttribute(
        "transform",
        translate(GEO.VZ, (1 - at.shutter) * GEO.SHUTTER_TRAVEL),
      );
      parts.ticket.setAttribute(
        "transform",
        translate(GEO.VY, at.ticket * GEO.TICKET_OUT),
      );
      // 閘臂在 xz 平面轉動：0 = 水平橫過輸送管，π/2 = 抬起。
      const tip = along(
        GEO.ARM_C,
        GEO.VX,
        GEO.VZ,
        -Math.cos(at.arm) * GEO.ARM_L,
        Math.sin(at.arm) * GEO.ARM_L,
      );
      const arm = segmentPath(GEO.ARM_C, tip);
      parts.arms.forEach((element) => element.setAttribute("d", arm));
      setLevel(parts.sand.viewer, at.sandViewer, GEO.VZ, GEO.SAND_H);
      setLevel(parts.sand.newcomer, at.sandNewcomer, GEO.VZ, GEO.SAND_H);
      // 三顆 segment 依序出發，看得出是一串請求。
      parts.segmentBeads.forEach((bead, index) =>
        placeBead(bead, segmentRoute, staggered(at.segment, index)),
      );
      // 被拒絕的請求走到閘門再折返；向售票亭要資格也是去了再回來。
      parts.probeBeads.forEach((bead) =>
        placeBead(bead, probeRoute, roundTrip(at.probe)),
      );
      parts.kioskBeads.forEach((bead) =>
        placeBead(bead, kioskRoute, roundTrip(at.kiosk)),
      );
      parts.originBeads.forEach((bead) =>
        placeBead(bead, GEO.ROUTES.origin, at.origin),
      );
    }

    function renderFlags(state: PlaybackAuthState) {
      parts.lamps.kiosk.dataset.state = KIOSK_LAMP[state.kiosk];
      parts.lamps.origin.dataset.state = state.originTouched ? "on" : "off";
      parts.lamps.cache.dataset.state =
        state.edge.requester && state.edge.cacheHit ? "green" : "off";
      parts.lamps.gate.dataset.state = GATE_LAMP[state.edge.decision];
      // 鐵捲門拉下時仍有人來要資格：門描紅邊，請求珠也是紅的。
      const refused =
        state.kiosk === "unavailable" && state.kioskRequester !== null;
      setFlag(parts.shutter, "data-refused", refused);
      // 珠子的顏色只在有人去售票亭時更新，回程途中不變色。
      if (state.kioskRequester)
        setFlag(parts.kioskBeadGroup, "data-refused", refused);
      setFlag(parts.ticket, "data-on", state.kiosk === "issuing");
      for (const id of VIEWERS) {
        parts.screens[id].dataset.player = state.viewers[id].player;
        setFlag(parts.passes[id], "data-held", state.viewers[id].pass.held);
        parts.buffers[id].forEach((cell, index) =>
          setFlag(cell, "data-on", index < state.viewers[id].buffer),
        );
      }
      parts.appDiscs.forEach((disc, index) =>
        setFlag(disc, "data-on", index < state.counters.appRequests),
      );
      parts.cdnDiscs.forEach((disc, index) =>
        setFlag(disc, "data-on", index < state.counters.cdnRequests),
      );
    }

    mountLabFigure(
      root,
      {
        initial: () => initialStep(MECHANISM),
        play: (id) => play(MECHANISM, id),
      },
      {
        targets: (step) => targetsOf(step.state),
        draw: (current) => draw(current as AuthMotion),
        render(step, _targets, ctx) {
          const { state } = step;
          const { requester, decision, fresh } = state.edge;
          if (fresh && requester && decision === "allowed") {
            segmentRoute = GEO.ROUTES[requester];
            ctx.jump({ segment: 0 });
          }
          if (fresh && requester && decision === "denied") {
            probeRoute = PROBE_ROUTE[requester];
            ctx.jump({ probe: 0 });
          }
          if (state.kioskRequester) {
            kioskRoute = KIOSK_ROUTE[state.kioskRequester];
            ctx.jump({ kiosk: 0 });
          }
          if (state.originTouched) ctx.jump({ origin: 0 });
          renderFlags(state);
        },
      },
    );
  }

  document
    .querySelectorAll<HTMLElement>('[data-lab-figure="playback-auth"]')
    .forEach(mount);
</script>

<style>
  /* 零件狀態 */
  .vpa-soft {
    filter: blur(4px);
  }
  .vpa-window {
    fill: color-mix(in oklab, var(--dg-surface), var(--color-code) 30%);
  }
  :global(:root[data-theme="dark"]) .vpa-window {
    fill: color-mix(in oklab, var(--dg-surface), var(--color-code) 75%);
  }
  .vpa-arm__edge,
  .vpa-arm {
    fill: none;
    stroke-linecap: round;
    vector-effect: none;
  }
  .vpa-arm__edge {
    stroke: var(--anatomy-hi);
    stroke-width: 3.2;
  }
  .vpa-arm {
    stroke: var(--anatomy-top);
    stroke-width: 1.8;
  }
  .vpa-bead {
    fill: var(--anatomy-lit);
    stroke: var(--anatomy-paper);
    stroke-width: 0.8;
  }
  .vpa-beads--probe .vpa-bead,
  .vpa-beads[data-refused] .vpa-bead {
    fill: var(--anatomy-red);
  }
  .vpa-shutter[data-refused] .iso-edge {
    stroke: var(--anatomy-red);
  }
  .vpa-buffer__cell {
    fill: transparent;
    transition: fill 0.35s ease;
  }
  .vpa-buffer[data-on] .vpa-buffer__cell {
    fill: var(--anatomy-lit);
  }

  .vpa-ticket,
  .vpa-disc,
  .vpa-glyph {
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .vpa-ticket[data-on],
  .vpa-disc[data-on],
  .vpa-screen[data-player="playing"] [data-glyph="playing"],
  .vpa-screen[data-player="stalled"] [data-glyph="stalled"],
  .vpa-screen[data-player="blocked"] [data-glyph="blocked"] {
    opacity: 1;
  }
  .vpa-ticket .iso-top,
  .vpa-disc[data-counter="cdn"] .iso-top {
    fill: color-mix(in oklab, var(--dg-surface), var(--anatomy-on) 35%);
  }
  .vpa-disc[data-counter="app"] .iso-top {
    fill: var(--anatomy-on);
  }
  .vpa-screen__face {
    fill: var(--anatomy-shade-1);
    transition: fill 0.35s ease;
  }
  .vpa-screen[data-player="playing"] .vpa-screen__face {
    fill: color-mix(in oklab, var(--dg-surface), var(--anatomy-on) 22%);
  }
  .vpa-sand .iso-top,
  .vpa-sand .iso-shade,
  .vpa-sand .iso-fill {
    fill: color-mix(in oklab, var(--dg-surface), var(--anatomy-on) 55%);
  }
  .vpa-pass:not([data-held]) .iso-line {
    stroke: var(--anatomy-faint);
  }

  @media (prefers-reduced-motion: reduce) {
    .vpa-screen__face,
    .vpa-ticket,
    .vpa-disc,
    .vpa-glyph {
      transition: none;
    }
  }
</style>
