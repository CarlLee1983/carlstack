---
// src/components/DddDomainStorytellingDiagram.astro
---

<figure class="ddd-story-diagram" aria-labelledby="ddd-story-diagram-caption">
  <!-- 桌面版 SVG (寬度 960，高度 600，大字級、高對比、清爽透氣、Anti-Quadrant) -->
  <svg
    class="ddd-story-diagram__desktop"
    viewBox="0 0 960 600"
    role="img"
    aria-labelledby="ddd-story-diagram-title ddd-story-diagram-desc"
  >
    <title id="ddd-story-diagram-title">
      Domain Storytelling 語法要素與同名異義詞解構全景
    </title>
    <desc id="ddd-story-diagram-desc">
      頂部展示 Domain Storytelling 三大核心語法要素（Actors、Work
      Objects、Activities）。主體四欄展示領域敘事從情境講述、同名異義詞暴露、通用語言銳化到限界上下文隔離的提煉流程。底部展示破除全域統一模型幻覺的架構防禦警示。
    </desc>

    <!-- 頂部：三語法要素導覽列 (高 52px) -->
    <g transform="translate(30, 20)">
      <rect width="900" height="52" rx="10" class="ddd-story-diagram__banner-bg"
      ></rect>
      <text x="24" y="32" class="ddd-story-diagram__banner-title"
        >領域敘事三大微觀要素：</text
      >

      <!-- 1. Actors (人/系統) -->
      <circle cx="215" cy="26" r="10" fill="#3b82f6"></circle>
      <text x="233" y="31" class="ddd-story-diagram__legend-text"
        >Actors 參與者（誰）</text
      >

      <!-- 2. Work Objects (資訊載體) -->
      <rect x="390" y="16" width="22" height="20" rx="3" fill="#10b981"></rect>
      <text x="420" y="31" class="ddd-story-diagram__legend-text"
        >Work Objects 工作物件（什麼）</text
      >

      <!-- 3. Activities (序號動作) -->
      <polygon points="630,16 648,26 630,36" fill="#f59e0b"></polygon>
      <text x="656" y="31" class="ddd-story-diagram__legend-text"
        >Activities 帶序號活動（做了什麼）</text
      >
    </g>

    <!-- 主體四欄：領域敘事語義提煉四步 (單欄寬 213px，間距 16px，高 355px) -->

    <!-- 1. 第一步：情境具象故事 (Concrete Scenario) -->
    <g transform="translate(30, 92)" class="ddd-story-diagram__col">
      <rect
        width="213"
        height="355"
        rx="10"
        class="ddd-story-diagram__main-card"></rect>
      <rect
        width="213"
        height="6"
        rx="3"
        class="ddd-story-diagram__col-strip ddd-story-diagram__col-strip--blue"
      ></rect>

      <!-- Header -->
      <g transform="translate(16, 24)">
        <text
          class="ddd-story-diagram__phase-tag ddd-story-diagram__phase-tag--blue"
          >STEP 1 · 具體場景</text
        >
        <text y="25" class="ddd-story-diagram__col-title">講述具體故事</text>
        <text y="46" class="ddd-story-diagram__col-subtitle"
          >拒絕抽象 · 畫出真實流動</text
        >
      </g>

      <line x1="16" y1="84" x2="197" y2="84" class="ddd-story-diagram__divider"
      ></line>

      <!-- Meta 區塊 -->
      <g transform="translate(16, 98)">
        <rect width="181" height="68" rx="6" class="ddd-story-diagram__meta-box"
        ></rect>
        <text x="12" y="22" class="ddd-story-diagram__meta-label"
          >敘事核心原則</text
        >
        <text
          x="12"
          y="42"
          class="ddd-story-diagram__meta-val ddd-story-diagram__meta-val--blue"
          >一次只講一個具體案例</text
        >
        <text x="12" y="58" class="ddd-story-diagram__meta-sub"
          >「VIP 客戶退換瑕疵品」真實案例</text
        >
      </g>

      <!-- 戰略要點 -->
      <g transform="translate(16, 180)">
        <text class="ddd-story-diagram__section-label">分析師推進要點</text>
        <text y="20" class="ddd-story-diagram__bullet"
          >• 邊聽專家講述邊在白板繪製</text
        >
        <text y="40" class="ddd-story-diagram__bullet"
          >• 箭頭加上嚴格序號（1, 2, 3）</text
        >
        <text y="60" class="ddd-story-diagram__bullet"
          >• 記錄資訊載體而非底層資料表</text
        >
        <text y="80" class="ddd-story-diagram__bullet"
          >• 讓業務專家一眼看出哪裡畫錯</text
        >
      </g>

      <!-- 處置底標 -->
      <g transform="translate(16, 290)">
        <rect
          width="181"
          height="48"
          rx="6"
          class="ddd-story-diagram__action-box"></rect>
        <text x="12" y="20" class="ddd-story-diagram__action-title"
          >分析師職責</text
        >
        <text x="12" y="38" class="ddd-story-diagram__action-desc"
          >即時圖解 · 驗證業務流動</text
        >
      </g>
    </g>

    <!-- 2. 第二步：同名異義暴露 (Polysemy Hunting) -->
    <g transform="translate(259, 92)" class="ddd-story-diagram__col">
      <rect
        width="213"
        height="355"
        rx="10"
        class="ddd-story-diagram__main-card"></rect>
      <rect
        width="213"
        height="6"
        rx="3"
        class="ddd-story-diagram__col-strip ddd-story-diagram__col-strip--red"
      ></rect>

      <!-- Header -->
      <g transform="translate(16, 24)">
        <text
          class="ddd-story-diagram__phase-tag ddd-story-diagram__phase-tag--red"
          >STEP 2 · 語義陷阱</text
        >
        <text y="25" class="ddd-story-diagram__col-title">捕捉同名異義詞</text>
        <text y="46" class="ddd-story-diagram__col-subtitle"
          >名詞相同 · 現實完全割裂</text
        >
      </g>

      <line x1="16" y1="84" x2="197" y2="84" class="ddd-story-diagram__divider"
      ></line>

      <!-- Meta 區塊 -->
      <g transform="translate(16, 98)">
        <rect
          width="181"
          height="68"
          rx="6"
          class="ddd-story-diagram__meta-box ddd-story-diagram__meta-box--red"
        ></rect>
        <text x="12" y="22" class="ddd-story-diagram__meta-label"
          >獵殺核心目標</text
        >
        <text
          x="12"
          y="42"
          class="ddd-story-diagram__meta-val ddd-story-diagram__meta-val--red"
          >同名異義（Polysemy）</text
        >
        <text x="12" y="58" class="ddd-story-diagram__meta-sub"
          >如「Order」在銷售、倉儲、財務</text
        >
      </g>

      <!-- 戰略要點 -->
      <g transform="translate(16, 180)">
        <text class="ddd-story-diagram__section-label">典型衝突場景</text>
        <text y="20" class="ddd-story-diagram__bullet"
          >• 銷售口中：Order 是購物車意向</text
        >
        <text y="40" class="ddd-story-diagram__bullet"
          >• 倉儲口中：Order 是出貨撿料單</text
        >
        <text y="60" class="ddd-story-diagram__bullet"
          >• 會計口中：Order 是應收帳款憑證</text
        >
        <text y="80" class="ddd-story-diagram__bullet"
          >• 強行揉合必然誕生 God Object</text
        >
      </g>

      <!-- 處置底標 -->
      <g transform="translate(16, 290)">
        <rect
          width="181"
          height="48"
          rx="6"
          class="ddd-story-diagram__action-box"></rect>
        <text x="12" y="20" class="ddd-story-diagram__action-title"
          >分析師職責</text
        >
        <text x="12" y="38" class="ddd-story-diagram__action-desc"
          >揭露分歧 · 標註語義撕裂</text
        >
      </g>
    </g>

    <!-- 3. 第三步：通用語言銳化 (Sharpen Ubiquitous Language) -->
    <g transform="translate(488, 92)" class="ddd-story-diagram__col">
      <rect
        width="213"
        height="355"
        rx="10"
        class="ddd-story-diagram__main-card"></rect>
      <rect
        width="213"
        height="6"
        rx="3"
        class="ddd-story-diagram__col-strip ddd-story-diagram__col-strip--emerald"
      ></rect>

      <!-- Header -->
      <g transform="translate(16, 24)">
        <text
          class="ddd-story-diagram__phase-tag ddd-story-diagram__phase-tag--emerald"
          >STEP 3 · 語義提純</text
        >
        <text y="25" class="ddd-story-diagram__col-title">提煉通用語言</text>
        <text y="46" class="ddd-story-diagram__col-subtitle"
          >一詞一意 · 拒絕模稜兩可</text
        >
      </g>

      <line x1="16" y1="84" x2="197" y2="84" class="ddd-story-diagram__divider"
      ></line>

      <!-- Meta 區塊 -->
      <g transform="translate(16, 98)">
        <rect width="181" height="68" rx="6" class="ddd-story-diagram__meta-box"
        ></rect>
        <text x="12" y="22" class="ddd-story-diagram__meta-label"
          >通用語言交付</text
        >
        <text
          x="12"
          y="42"
          class="ddd-story-diagram__meta-val ddd-story-diagram__meta-val--emerald"
          >精準概念替換</text
        >
        <text x="12" y="58" class="ddd-story-diagram__meta-sub"
          >放棄萬能名詞，賦予純淨命名</text
        >
      </g>

      <!-- 戰略要點 -->
      <g transform="translate(16, 180)">
        <text class="ddd-story-diagram__section-label">名詞銳化實務</text>
        <text y="20" class="ddd-story-diagram__bullet"
          >• 銷售端重命名為 SalesOrder</text
        >
        <text y="40" class="ddd-story-diagram__bullet"
          >• 倉儲端重命名為 DispatchOrder</text
        >
        <text y="60" class="ddd-story-diagram__bullet"
          >• 財務端重命名為 Invoice</text
        >
        <text y="80" class="ddd-story-diagram__bullet"
          >• 每個名詞定義專屬狀態不變量</text
        >
      </g>

      <!-- 處置底標 -->
      <g transform="translate(16, 290)">
        <rect
          width="181"
          height="48"
          rx="6"
          class="ddd-story-diagram__action-box"></rect>
        <text x="12" y="20" class="ddd-story-diagram__action-title"
          >分析師職責</text
        >
        <text x="12" y="38" class="ddd-story-diagram__action-desc"
          >精確命名 · 編寫領域詞典</text
        >
      </g>
    </g>

    <!-- 4. 第四步：確立純淨邊界 (Context Boundaries) -->
    <g transform="translate(717, 92)" class="ddd-story-diagram__col">
      <rect
        width="213"
        height="355"
        rx="10"
        class="ddd-story-diagram__main-card ddd-story-diagram__main-card--gold"
      ></rect>
      <rect
        width="213"
        height="6"
        rx="3"
        class="ddd-story-diagram__col-strip ddd-story-diagram__col-strip--gold"
      ></rect>

      <!-- Header -->
      <g transform="translate(16, 24)">
        <text
          class="ddd-story-diagram__phase-tag ddd-story-diagram__phase-tag--gold"
          >STEP 4 · 邊界確立</text
        >
        <text
          y="25"
          class="ddd-story-diagram__col-title ddd-story-diagram__col-title--gold"
          >劃定語義邊界</text
        >
        <text y="46" class="ddd-story-diagram__col-subtitle"
          >各司其職 · 消除全局依賴</text
        >
      </g>

      <line x1="16" y1="84" x2="197" y2="84" class="ddd-story-diagram__divider"
      ></line>

      <!-- Meta 區塊 -->
      <g transform="translate(16, 98)">
        <rect
          width="181"
          height="68"
          rx="6"
          class="ddd-story-diagram__meta-box ddd-story-diagram__meta-box--gold"
        ></rect>
        <text x="12" y="22" class="ddd-story-diagram__meta-label"
          >架構防線落實</text
        >
        <text
          x="12"
          y="42"
          class="ddd-story-diagram__meta-val ddd-story-diagram__meta-val--gold"
          >獨立 Bounded Context</text
        >
        <text x="12" y="58" class="ddd-story-diagram__meta-sub"
          >各自擁有高內聚的小模型</text
        >
      </g>

      <!-- 戰略要點 -->
      <g transform="translate(16, 180)">
        <text class="ddd-story-diagram__section-label">工程落地收益</text>
        <text y="20" class="ddd-story-diagram__bullet"
          >• 徹底杜絕 Nullable 欄位膨脹</text
        >
        <text y="40" class="ddd-story-diagram__bullet"
          >• 狀態機單純清晰，無跨界污染</text
        >
        <text y="60" class="ddd-story-diagram__bullet"
          >• 跨邊界僅透過 ID 與契約傳遞</text
        >
        <text y="80" class="ddd-story-diagram__bullet"
          >• 程式碼與業務溝通完全零摩擦</text
        >
      </g>

      <!-- 處置底標 -->
      <g transform="translate(16, 290)">
        <rect
          width="181"
          height="48"
          rx="6"
          class="ddd-story-diagram__action-box ddd-story-diagram__action-box--gold"
        ></rect>
        <text
          x="12"
          y="20"
          class="ddd-story-diagram__action-title ddd-story-diagram__action-title--gold"
          >分析師職責</text
        >
        <text x="12" y="38" class="ddd-story-diagram__action-desc"
          >界定邊界 · 杜絕大泥球</text
        >
      </g>
    </g>

    <!-- 底部：架構警示 (高 105px) -->
    <g transform="translate(30, 465)">
      <rect
        width="900"
        height="105"
        rx="10"
        class="ddd-story-diagram__warning-bg"></rect>
      <rect
        width="900"
        height="5"
        rx="2"
        class="ddd-story-diagram__warning-strip"></rect>

      <circle cx="36" cy="35" r="14" fill="#3b82f6" opacity="0.15"></circle>
      <text
        x="36"
        y="41"
        text-anchor="middle"
        font-size="16"
        font-weight="900"
        fill="#2563eb">i</text
      >
      <text x="62" y="40" class="ddd-story-diagram__warning-title"
        >系統分析師的核心警醒：拒絕「全局單一真實模型（Single Source of
        Truth）」的幼稚病</text
      >

      <g transform="translate(62, 54)">
        <text class="ddd-story-diagram__warning-bullet" x="0" y="16">
          <tspan font-weight="700">語義是局部的：</tspan> 沒有任何一個資料模型能夠在整間企業的所有部門中維持相同意義；試圖統一一切名詞，只會製造出誰都不敢維護的上帝實體。
        </text>
        <text class="ddd-story-diagram__warning-bullet" x="0" y="36">
          <tspan font-weight="700">故事驅動邊界：</tspan> 用具體的故事場景迫使隱藏在名詞背後的真實業務動作無所遁形，才是定義通用語言的唯一工程路徑。
        </text>
      </g>
    </g>
  </svg>

  <!-- 行動版 SVG (寬度 360，高度 1040，縱向堆疊卡片) -->
  <svg
    class="ddd-story-diagram__mobile"
    viewBox="0 0 360 1040"
    role="img"
    aria-labelledby="ddd-story-diagram-mobile-title ddd-story-diagram-mobile-desc"
  >
    <title id="ddd-story-diagram-mobile-title">
      Domain Storytelling 語義提煉四步工作流（行動版）
    </title>
    <desc id="ddd-story-diagram-mobile-desc">
      領域敘事四步驟縱向卡片版：講述具體故事、捕捉同名異義詞、提煉通用語言、劃定純淨限界上下文邊界。
    </desc>

    <!-- 頂部標題 (高 66px) -->
    <g transform="translate(16, 16)">
      <rect width="328" height="66" rx="8" class="ddd-story-diagram__banner-bg"
      ></rect>
      <text x="16" y="28" class="ddd-story-diagram__mobile-title"
        >Domain Storytelling 領域敘事</text
      >
      <text x="16" y="48" class="ddd-story-diagram__mobile-subtitle"
        >從微觀業務故事抓出同名異義與語義邊界</text
      >
    </g>

    <!-- 1. 具體場景 (高 205px) -->
    <g transform="translate(16, 96)">
      <rect width="328" height="205" rx="8" class="ddd-story-diagram__main-card"
      ></rect>
      <rect
        width="328"
        height="5"
        rx="2"
        class="ddd-story-diagram__col-strip ddd-story-diagram__col-strip--blue"
      ></rect>
      <text
        x="16"
        y="28"
        class="ddd-story-diagram__phase-tag ddd-story-diagram__phase-tag--blue"
        >STEP 1 · 具體場景（拒絕抽象）</text
      >
      <text x="16" y="52" class="ddd-story-diagram__col-title"
        >講述具體故事（Concrete Stories）</text
      >
      <text x="16" y="74" class="ddd-story-diagram__mobile-domain"
        >要素：Actors + Work Objects + Activities</text
      >
      <text x="16" y="102" class="ddd-story-diagram__mobile-text"
        >• 特徵：邊聽專家講述邊在白板畫出帶序號箭頭</text
      >
      <text x="16" y="124" class="ddd-story-diagram__mobile-text"
        >• 姿態：一次只講一個特定場景，不談泛化規則</text
      >
      <text x="16" y="146" class="ddd-story-diagram__mobile-text"
        >• 典型：「Alice 透過客服系統為訂單申請換貨」</text
      >
      <rect
        x="16"
        y="162"
        width="296"
        height="26"
        rx="4"
        class="ddd-story-diagram__action-box"></rect>
      <text x="24" y="179" class="ddd-story-diagram__mobile-action"
        >分析師姿態：即時視覺化圖解，驗證業務真實流動</text
      >
    </g>

    <!-- 2. 捕捉同名異義 (高 205px) -->
    <g transform="translate(16, 315)">
      <rect width="328" height="205" rx="8" class="ddd-story-diagram__main-card"
      ></rect>
      <rect
        width="328"
        height="5"
        rx="2"
        class="ddd-story-diagram__col-strip ddd-story-diagram__col-strip--red"
      ></rect>
      <text
        x="16"
        y="28"
        class="ddd-story-diagram__phase-tag ddd-story-diagram__phase-tag--red"
        >STEP 2 · 語義陷阱（名詞撕裂）</text
      >
      <text x="16" y="52" class="ddd-story-diagram__col-title"
        >捕捉同名異義詞（Polysemy）</text
      >
      <text x="16" y="74" class="ddd-story-diagram__mobile-domain"
        >陷阱：同一個詞在不同部門代表完全不同現實</text
      >
      <text x="16" y="102" class="ddd-story-diagram__mobile-text"
        >• 特徵：業務口中的 Order 只是意向，倉儲口中是撿料單</text
      >
      <text x="16" y="124" class="ddd-story-diagram__mobile-text"
        >• 姿態：敏銳辨識跨故事流轉時工作物件的內涵突變</text
      >
      <text x="16" y="146" class="ddd-story-diagram__mobile-text"
        >• 典型：試圖在資料庫建單一 Order 表必然製造上帝物件</text
      >
      <rect
        x="16"
        y="162"
        width="296"
        height="26"
        rx="4"
        class="ddd-story-diagram__action-box"></rect>
      <text x="24" y="179" class="ddd-story-diagram__mobile-action"
        >分析師姿態：拒絕統一全域模型，揪出語義分歧</text
      >
    </g>

    <!-- 3. 提煉通用語言 (高 205px) -->
    <g transform="translate(16, 534)">
      <rect width="328" height="205" rx="8" class="ddd-story-diagram__main-card"
      ></rect>
      <rect
        width="328"
        height="5"
        rx="2"
        class="ddd-story-diagram__col-strip ddd-story-diagram__col-strip--emerald"
      ></rect>
      <text
        x="16"
        y="28"
        class="ddd-story-diagram__phase-tag ddd-story-diagram__phase-tag--emerald"
        >STEP 3 · 語義提純（一詞一意）</text
      >
      <text x="16" y="52" class="ddd-story-diagram__col-title"
        >提煉通用語言（Ubiquitous Language）</text
      >
      <text x="16" y="74" class="ddd-story-diagram__mobile-domain"
        >產出：精準概念替換與詞典定義</text
      >
      <text x="16" y="102" class="ddd-story-diagram__mobile-text"
        >• 特徵：拆分為 SalesOrder、DispatchOrder、Invoice</text
      >
      <text x="16" y="124" class="ddd-story-diagram__mobile-text"
