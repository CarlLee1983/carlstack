---
interface Props {
  title: string;
  description: string;
  href?: string;
  action?: string;
}

const { title, description, href, action } = Astro.props;
---

<div class="empty-state">
  <strong>{title}</strong>
  <p>{description}</p>
  {
    href && action && (
      <a class="text-link" href={href}>
        {action} →
      </a>
    )
  }
</div>
