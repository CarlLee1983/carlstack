---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { postHref } from "../utils/collections";
import { estimateReadingMinutes } from "../utils/content";

interface Props {
  post: CollectionEntry<"blog">;
  headingLevel?: "h2" | "h3";
  /** card：獨立盒子，給格狀精選；row：以髮絲線分隔的編輯式列表，給時序清單 */
  variant?: "card" | "row";
}

const { post, headingLevel: Heading = "h2", variant = "card" } = Astro.props;
const cover = post.data.cover;
const body = "body" in post && typeof post.body === "string" ? post.body : "";
const date = new Intl.DateTimeFormat("zh-TW", {
  year: "numeric",
  month: "short",
  day: "numeric",
}).format(post.data.publishDate);
const primaryTag =
  post.data.tags && post.data.tags.length > 0 ? post.data.tags[0] : null;
---

<a
  class:list={[
    "article-card-item",
    `article-card-item--${variant}`,
    cover && "article-card-item--with-cover",
  ]}
  href={postHref(post)}
>
  {
    cover && (
      <Image
        class="article-card-item__cover"
        src={cover}
        alt=""
        widths={[220, 440]}
        sizes={
          variant === "row"
            ? "(min-width: 40rem) 8.5rem, 5.5rem"
            : "(min-width: 40rem) 9rem, 100vw"
        }
        loading="lazy"
      />
    )
  }
  <div class="article-card-item__content">
    <div class="article-card-item__meta">
      {primaryTag && <span class="tag-chip">{primaryTag}</span>}
      <div class="meta-item">
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>{estimateReadingMinutes(body)} 分鐘</span>
      </div>
      <span class="meta-dot">·</span>
      <time datetime={post.data.publishDate.toISOString()}>{date}</time>
      {post.data.draft && <span class="draft-pill">草稿</span>}
    </div>
    <Heading class="article-card-item__title">{post.data.title}</Heading>
    <p class="article-card-item__desc">{post.data.description}</p>
  </div>
  <div class="article-card-item__action" aria-hidden="true">
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line x1="5" y1="12" x2="19" y2="12"></line>
      <polyline points="12 5 19 12 12 19"></polyline>
    </svg>
  </div>
</a>

<style>
  .article-card-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "content action";
    gap: var(--space-lg);
    align-items: center;
    padding: var(--space-xl);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-card);
    box-shadow: var(--shadow-sm);
    color: inherit;
    text-decoration: none;
    transition:
      transform var(--dur-short) var(--ease-out),
      box-shadow var(--dur-short) var(--ease-out),
      border-color var(--dur-short) var(--ease-out),
      background-color var(--dur-short) var(--ease-out);
  }

  .article-card-item:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-accent);
    background: var(--color-card-hover);
  }

  .article-card-item__content {
    grid-area: content;
  }

  .article-card-item__action {
    grid-area: action;
  }

  .article-card-item__cover {
    grid-area: cover;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-md);
    background: var(--color-paper-2);
  }

  /* 封面在窄視窗跨滿整列，寬視窗才收成左側縮圖 */
  .article-card-item--with-cover {
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "cover cover"
      "content action";
  }

  @media (min-width: 40rem) {
    .article-card-item--with-cover {
      grid-template-columns: 9rem minmax(0, 1fr) auto;
      grid-template-areas: "cover content action";
    }

    .article-card-item__cover {
      aspect-ratio: 4 / 3;
    }
  }

  .article-card-item__content {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
  }

  .article-card-item__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-sm);
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-family: var(--font-display);
    margin-bottom: var(--space-2xs);
  }

  .tag-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.65rem;
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .meta-dot {
    color: var(--color-rule-2);
  }

  .draft-pill {
    padding: 0.1rem 0.5rem;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: var(--radius-pill);
    font-weight: 700;
  }

  .article-card-item__title {
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-ink);
    transition: color var(--dur-micro) var(--ease-out);
  }

  .article-card-item:hover .article-card-item__title {
    color: var(--color-accent);
  }

  .article-card-item__desc {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
    margin-top: var(--space-2xs);
  }

  .article-card-item__action {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-paper-2);
    color: var(--color-muted);
    transition: all var(--dur-micro) var(--ease-out);
    flex-shrink: 0;
  }

  .article-card-item:hover .article-card-item__action {
    background: var(--color-accent);
    color: #ffffff;
    transform: translateX(3px);
  }

  @media (max-width: 36rem) {
    .article-card-item--card {
      grid-template-columns: minmax(0, 1fr);
    }
    .article-card-item--card .article-card-item__action {
      display: none;
    }
  }

  /* Row：去掉盒子，靠髮絲線與留白分段；縮圖在窄視窗也留在左側，清單才不會被封面撐長 */
  .article-card-item--row {
    grid-template-columns: 5.5rem minmax(0, 1fr);
    grid-template-areas: "cover content";
    align-items: start;
    gap: var(--space-md) var(--space-lg);
    padding: var(--space-lg) 0;
    border: 0;
    border-block-start: var(--rule-hair) solid var(--color-rule);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .article-card-item--row:not(.article-card-item--with-cover) {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "content";
  }

  .article-card-item--row:hover {
    transform: none;
    box-shadow: none;
    border-color: var(--color-rule);
    background: transparent;
  }

  .article-card-item--row .article-card-item__cover {
    aspect-ratio: 1;
    border-radius: var(--radius-sm);
    transition: transform var(--dur-short) var(--ease-out);
  }

  .article-card-item--row:hover .article-card-item__cover {
    transform: scale(1.03);
  }

  .article-card-item--row .article-card-item__action {
    display: none;
  }

  /* 窄視窗 meta 會折行，分隔點落單反而像錯字，改用間距分隔 */
  .article-card-item--row .meta-dot {
    display: none;
  }

  .article-card-item--row .article-card-item__title {
    font-size: var(--text-md);
    line-height: 1.4;
  }

  .article-card-item--row .article-card-item__desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  @media (min-width: 40rem) {
    .article-card-item--row {
      grid-template-columns: 8.5rem minmax(0, 1fr) auto;
      grid-template-areas: "cover content action";
      align-items: center;
      padding-block: var(--space-xl);
    }

    .article-card-item--row .article-card-item__cover {
      aspect-ratio: 4 / 3;
      border-radius: var(--radius-md);
    }

    .article-card-item--row .article-card-item__action {
      display: grid;
      opacity: 0;
      transform: translateX(-0.35rem);
    }

    .article-card-item--row:hover .article-card-item__action,
    .article-card-item--row:focus-visible .article-card-item__action {
      opacity: 1;
      transform: translateX(0);
    }

    .article-card-item--row .article-card-item__title {
      font-size: var(--text-lg);
    }

    .article-card-item--row .meta-dot {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-card-item--row:hover .article-card-item__cover {
      transform: none;
    }
  }
</style>
