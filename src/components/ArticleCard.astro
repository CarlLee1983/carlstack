---
import type { CollectionEntry } from "astro:content";
import { postHref } from "../utils/collections";
import { estimateReadingMinutes } from "../utils/content";

interface Props {
  post: CollectionEntry<"blog">;
  headingLevel?: "h2" | "h3";
}

const { post, headingLevel: Heading = "h2" } = Astro.props;
const body = "body" in post && typeof post.body === "string" ? post.body : "";
const date = new Intl.DateTimeFormat("zh-TW", {
  year: "numeric",
  month: "short",
  day: "numeric",
}).format(post.data.publishDate);
const primaryTag =
  post.data.tags && post.data.tags.length > 0 ? post.data.tags[0] : null;
---

<a class="article-card-item" href={postHref(post)}>
  <div class="article-card-item__content">
    <div class="article-card-item__meta">
      {primaryTag && <span class="tag-chip">{primaryTag}</span>}
      <div class="meta-item">
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>{estimateReadingMinutes(body)} 分鐘</span>
      </div>
      <span class="meta-dot">·</span>
      <time datetime={post.data.publishDate.toISOString()}>{date}</time>
      {post.data.draft && <span class="draft-pill">草稿</span>}
    </div>
    <Heading class="article-card-item__title">{post.data.title}</Heading>
    <p class="article-card-item__desc">{post.data.description}</p>
  </div>
  <div class="article-card-item__action" aria-hidden="true">
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line x1="5" y1="12" x2="19" y2="12"></line>
      <polyline points="12 5 19 12 12 19"></polyline>
    </svg>
  </div>
</a>

<style>
  .article-card-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-lg);
    align-items: center;
    padding: var(--space-xl);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-card);
    box-shadow: var(--shadow-sm);
    color: inherit;
    text-decoration: none;
    transition:
      transform var(--dur-short) var(--ease-out),
      box-shadow var(--dur-short) var(--ease-out),
      border-color var(--dur-short) var(--ease-out),
      background-color var(--dur-short) var(--ease-out);
  }

  .article-card-item:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-accent);
    background: var(--color-card-hover);
  }

  .article-card-item__content {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
  }

  .article-card-item__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-sm);
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-family: var(--font-display);
    margin-bottom: var(--space-2xs);
  }

  .tag-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.65rem;
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .meta-dot {
    color: var(--color-rule-2);
  }

  .draft-pill {
    padding: 0.1rem 0.5rem;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: var(--radius-pill);
    font-weight: 700;
  }

  .article-card-item__title {
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-ink);
    transition: color var(--dur-micro) var(--ease-out);
  }

  .article-card-item:hover .article-card-item__title {
    color: var(--color-accent);
  }

  .article-card-item__desc {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
    margin-top: var(--space-2xs);
  }

  .article-card-item__action {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-paper-2);
    color: var(--color-muted);
    transition: all var(--dur-micro) var(--ease-out);
    flex-shrink: 0;
  }

  .article-card-item:hover .article-card-item__action {
    background: var(--color-accent);
    color: #ffffff;
    transform: translateX(3px);
  }

  @media (max-width: 36rem) {
    .article-card-item {
      grid-template-columns: minmax(0, 1fr);
    }
    .article-card-item__action {
      display: none;
    }
  }
</style>
