    font-weight: 800;
    fill: var(--dg-ink);
  }

  .sir-diag__desc {
    font-family: var(--font-body);
    font-size: 12px;
    fill: var(--dg-ink-2);
  }

  .sir-diag__subcard {
    fill: var(--dg-surface-2);
    stroke: var(--dg-rule);
    stroke-width: 1;
  }

  .sir-diag__subcard--danger {
