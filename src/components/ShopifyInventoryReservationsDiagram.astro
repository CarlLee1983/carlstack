    font-family: var(--font-body);
    font-size: 11px;
    fill: var(--dg-muted);
  }

  .sir-diag__dot--cyan {
    fill: #0284c7;
  }
  :global(:root[data-theme="dark"]) .sir-diag__dot--cyan {
    fill: #38bdf8;
  }

  .sir-diag__dot-text {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 800;
    fill: #ffffff;
  }
  :global(:root[data-theme="dark"]) .sir-diag__dot-text {
    fill: #0f172a;
  }

  .sir-diag__item-title {
    font-family: var(--font-body);
    font-size: 12px;
