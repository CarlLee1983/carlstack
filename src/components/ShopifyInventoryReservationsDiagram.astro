    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .sir-diag__badge--rose {
    fill: #e11d48;
  }
  :global(:root[data-theme="dark"]) .sir-diag__badge--rose {
    fill: #fb7185;
  }

  .sir-diag__badge--cyan {
    fill: #0284c7;
  }
  :global(:root[data-theme="dark"]) .sir-diag__badge--cyan {
    fill: #38bdf8;
  }

  .sir-diag__badge--gold {
    fill: #d97706;
  }
  :global(:root[data-theme="dark"]) .sir-diag__badge--gold {
    fill: #fbbf24;
  }

  .sir-diag__title {
    font-family: var(--font-body);
