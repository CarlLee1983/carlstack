    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
  }

  .sir-diag__subhead--rose {
    fill: #e11d48;
  }
  :global(:root[data-theme="dark"]) .sir-diag__subhead--rose {
    fill: #fb7185;
  }

  .sir-diag__subhead--cyan {
    fill: #0284c7;
  }
  :global(:root[data-theme="dark"]) .sir-diag__subhead--cyan {
    fill: #38bdf8;
  }

  .sir-diag__subhead--gold {
    fill: #d97706;
  }
  :global(:root[data-theme="dark"]) .sir-diag__subhead--gold {
