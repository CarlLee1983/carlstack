  }

  /* Mobile Semantic Cards */
  @media (max-width: 48rem) {
    .sir-diag__desktop {
      display: none !important;
    }

    .sir-diag__mobile {
      display: flex !important;
      flex-direction: column;
      gap: 1.25rem;
    }

