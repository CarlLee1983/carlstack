<script>
  import { initialStep, play } from "../utils/lab/index.ts";
  import type {
    LabStep,
    PublishGateReadout,
    PublishGateState,
    WorkerStatus,
  } from "../utils/lab/index.ts";

  type Step = LabStep<PublishGateState, PublishGateReadout>;
  type Vec = [number, number];

  // 由 build script 依等角投影算好的常數：世界座標每單位在 viewBox 中的位移與錨點。
  const GEO: {
    VX: Vec;
    VY: Vec;
    VZ: Vec;
    DIAL_C: Vec;
    PIVOT_C: Vec;
    DIAL_R: number;
    LEASE_R: number;
    LEVER_L: number;
    LEVER_TILT: number;
    POS: Record<"home" | "work" | "bounce" | "submit" | "seat", number>;
    PRESS_TRAVEL: number;
    SLIP_UP: { saved: number; returned: number };
    TAG_UP: number;
    LEASE_FULL_S: number;
  } = {
    VX: [1.718, 0.537],
    VY: [-1.074, 0.859],
    VZ: [0, -1.755],
    DIAL_C: [368.116, 63.889],
    PIVOT_C: [515.902, 197.806],
    DIAL_R: 11,
    LEASE_R: 6.2,
    LEVER_L: 23,
    LEVER_TILT: 0.62,
    POS: { home: -114, work: -80, bounce: -70, submit: -24, seat: 28 },
    PRESS_TRAVEL: 10,
    SLIP_UP: { saved: 9, returned: 12 },
    TAG_UP: 4,
    LEASE_FULL_S: 120,
  };

  const STEP_MS = 1100;
  const LEAD_MS = 500;
  const BOUNCE_MS = 450;
  const TAU = 0.28;
  const MECHANISM = "publish-gate";

  const LANE_POS: Record<WorkerStatus, number> = {
    idle: GEO.POS.home,
    working: GEO.POS.work,
    offline: GEO.POS.home,
    submitting: GEO.POS.submit,
    rejected: GEO.POS.bounce,
    accepted: GEO.POS.seat,
    failed: GEO.POS.home,
  };

  const WORKER_LAMP: Record<WorkerStatus, string> = {
    idle: "off",
    working: "on",
    offline: "off",
    submitting: "on",
    rejected: "red",
    accepted: "off",
    failed: "red",
  };

  const fmt = (value: number) => Math.round(value * 10) / 10;
  const mix = (a: Vec, b: Vec, sa: number, sb: number): Vec => [
    a[0] * sa + b[0] * sb,
    a[1] * sa + b[1] * sb,
  ];
  const translate = (v: Vec, amount: number) =>
    `translate(${fmt(v[0] * amount)} ${fmt(v[1] * amount)})`;

  // 刻度盤平面上的點：角度 0 指向 -y（後方輸送臂），順時針增加。
  const onDial = (theta: number, radius: number): Vec => {
    const offset = mix(GEO.VX, GEO.VY, Math.sin(theta), -Math.cos(theta));
    return [
      GEO.DIAL_C[0] + offset[0] * radius,
      GEO.DIAL_C[1] + offset[1] * radius,
    ];
  };

  const tokenAngle = (token: string) => {
    const match = /attempt\s*([ab])\s*$/.exec(token);
    if (!match) return Math.PI / 2;
    return match[1] === "a" ? 0 : Math.PI;
  };

  const leaseShare = (lease: string) => {
    const match = /^(\d+):(\d+)$/.exec(lease.trim());
    if (!match) return 0;
    const seconds = Number(match[1]) * 60 + Number(match[2]);
    return Math.min(1, seconds / GEO.LEASE_FULL_S);
  };

  const leverAngle = (assetId: string | null) => {
    const match = assetId ? /-([ab])$/.exec(assetId) : null;
    if (!match) return 0;
    return match[1] === "a" ? -GEO.LEVER_TILT : GEO.LEVER_TILT;
  };

  function mount(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>("[data-vpg-stage]");
    const svg = root.querySelector<SVGSVGElement>("svg");
    if (!stage || !svg) return;
    const one = <T extends Element>(selector: string) => {
      const found = svg.querySelector<T>(selector);
      if (!found) throw new Error(`驗印閘門缺少零件：${selector}`);
      return found;
    };
    const lanes = {
      a: one<SVGGElement>('.vpg-lane[data-lane="a"]'),
      b: one<SVGGElement>('.vpg-lane[data-lane="b"]'),
    };
    const lamp = (name: string) => one<SVGGElement>(`[data-lamp="${name}"]`);
    const lamps = {
      workerA: lamp("worker-a"),
      workerB: lamp("worker-b"),
      seatA: lamp("seat-a"),
      seatB: lamp("seat-b"),
      verify: lamp("gate-verify"),
      accept: lamp("gate-accept"),
      reject: lamp("gate-reject"),
    };
    const press = one<SVGGElement>(".vpg-press");
    const slip = one<SVGGElement>(".vpg-slip");
    const tag = one<SVGGElement>(".vpg-tag");
    const deadJob = one<SVGGElement>(".vpg-dead-job");
    const needle = one<SVGPathElement>(".vpg-needle");
    const lease = one<SVGPathElement>(".vpg-lease");
    const rods = svg.querySelectorAll<SVGPathElement>(
      ".vpg-lever__rod, .vpg-lever__rod-edge",
    );
    const knob = one<SVGCircleElement>(".vpg-lever__knob");
    const attemptPips = svg.querySelectorAll<SVGGElement>(
      '[data-pip="attempt"]',
    );
    const switchPips = svg.querySelectorAll<SVGGElement>('[data-pip="switch"]');
    const readouts = root.querySelectorAll<HTMLElement>("[data-readout]");
    const note = root.querySelector<HTMLElement>("[data-vpg-note]");
    const buttons = root.querySelectorAll<HTMLButtonElement>("[data-scenario]");
    const reset = root.querySelector<HTMLButtonElement>("[data-vpg-reset]");
    const staticNote = root.dataset.staticNote ?? "";
    const still = matchMedia("(prefers-reduced-motion: reduce)");

    // 會連續移動的量：current 以指數趨近 target。
    const keys = [
      "a",
      "b",
      "press",
      "slip",
      "tag",
      "needle",
      "lease",
      "lever",
    ] as const;
    type Key = (typeof keys)[number];
    const target: Record<Key, number> = {
      a: GEO.POS.home,
      b: GEO.POS.home,
      press: 0,
      slip: 0,
      tag: 0,
      needle: Math.PI / 2,
      lease: 0,
      lever: 0,
    };
    const current: Record<Key, number> = { ...target };
    const laneStatus: Record<"a" | "b", WorkerStatus> = {
      a: "idle",
      b: "idle",
    };

    let timers: number[] = [];
    let frame = 0;
    let last = 0;
    let visible = false;

    const later = (fn: () => void, ms: number) => {
      timers.push(window.setTimeout(fn, ms));
    };
    const cancel = () => {
      timers.forEach((id) => window.clearTimeout(id));
      timers = [];
    };

    function draw() {
      lanes.a.setAttribute("transform", translate(GEO.VX, current.a));
      lanes.b.setAttribute("transform", translate(GEO.VX, current.b));
      press.setAttribute(
        "transform",
        translate(GEO.VZ, -GEO.PRESS_TRAVEL * current.press),
      );
      slip.setAttribute("transform", translate(GEO.VZ, current.slip));
      tag.setAttribute("transform", translate(GEO.VZ, current.tag));

      const tail = onDial(current.needle, -2.6);
      const tip = onDial(current.needle, GEO.DIAL_R - 3.4);
      needle.setAttribute(
        "d",
        `M${fmt(tail[0])} ${fmt(tail[1])}L${fmt(tip[0])} ${fmt(tip[1])}`,
      );

      const share = current.lease;
      if (share < 0.004) {
        lease.setAttribute("d", "");
      } else {
        const count = Math.max(2, Math.ceil(share * 64));
        const points: string[] = [];
        for (let index = 0; index <= count; index++) {
          const [x, y] = onDial(
            (index / count) * share * Math.PI * 2,
            GEO.LEASE_R,
          );
          points.push(`${index ? "L" : "M"}${fmt(x)} ${fmt(y)}`);
        }
        lease.setAttribute("d", points.join(""));
      }

      const reach = mix(
        GEO.VY,
        GEO.VZ,
        Math.sin(current.lever),
        Math.cos(current.lever),
      );
      const knobAt: Vec = [
        GEO.PIVOT_C[0] + reach[0] * GEO.LEVER_L,
        GEO.PIVOT_C[1] + reach[1] * GEO.LEVER_L,
      ];
      const rodPath = `M${fmt(GEO.PIVOT_C[0])} ${fmt(GEO.PIVOT_C[1])}L${fmt(knobAt[0])} ${fmt(knobAt[1])}`;
      rods.forEach((rod) => rod.setAttribute("d", rodPath));
      knob.setAttribute("cx", String(fmt(knobAt[0])));
      knob.setAttribute("cy", String(fmt(knobAt[1])));
    }

    function tick(now: number) {
      const dt = last ? Math.min((now - last) / 1000, 1 / 30) : 1 / 60;
      last = now;
      const ease = 1 - Math.exp(-dt / TAU);
      let moving = false;
      for (const key of keys) {
        const gap = target[key] - current[key];
        if (Math.abs(gap) < 0.002) {
          current[key] = target[key];
        } else {
          current[key] += gap * ease;
          moving = true;
        }
      }
      draw();
      frame = visible && moving ? requestAnimationFrame(tick) : 0;
    }

    function run() {
      if (still.matches) {
        Object.assign(current, target);
        draw();
        return;
      }
      if (!frame && visible) {
        last = 0;
        frame = requestAnimationFrame(tick);
      }
    }

    const setFlag = (element: Element, name: string, on: boolean) => {
      if (on) element.setAttribute(name, "");
      else element.removeAttribute(name);
    };

    function setLane(id: "a" | "b", status: WorkerStatus) {
      const previous = laneStatus[id];
      laneStatus[id] = status;
      lanes[id].dataset.status = status;
      // 被拒絕時先送到閘門口再彈回，看得出是「交件後被退」。
      if (status === "rejected" && previous !== "rejected" && !still.matches) {
        target[id] = GEO.POS.submit;
        later(() => {
          target[id] = LANE_POS.rejected;
          run();
        }, BOUNCE_MS);
      } else {
        target[id] = LANE_POS[status];
      }
    }

    function apply(step: Step, note_: string) {
      const { state, readout } = step;
      setLane("a", state.workers.a.status);
      setLane("b", state.workers.b.status);
      lamps.workerA.dataset.state = WORKER_LAMP[state.workers.a.status];
      lamps.workerB.dataset.state = WORKER_LAMP[state.workers.b.status];
      lamps.seatA.dataset.state =
        state.workers.a.status === "accepted" ? "green" : "off";
      lamps.seatB.dataset.state =
        state.workers.b.status === "accepted" ? "green" : "off";
      lamps.verify.dataset.state = state.gate === "verifying" ? "on" : "off";
      lamps.accept.dataset.state =
        state.gate === "accepted" || state.gate === "receipt-returned"
          ? "green"
          : "off";
      lamps.reject.dataset.state =
        state.gate === "rejected" || state.gate === "stopped" ? "red" : "off";

      attemptPips.forEach((pip, index) =>
        setFlag(pip, "data-on", index < state.attempts),
      );
      switchPips.forEach((pip, index) =>
        setFlag(pip, "data-on", index < state.pointer.switchCount),
      );
      setFlag(deadJob, "data-on", state.deadLetter.hasJob);
      setFlag(tag, "data-on", state.deadLetter.owner !== null);
      setFlag(slip, "data-lit", state.gate === "receipt-returned");
      setFlag(knob, "data-on", state.pointer.assetId !== null);

      target.press = state.gate === "verifying" ? 1 : 0;
      target.slip =
        state.pointer.switchCount === 0
          ? 0
          : state.gate === "receipt-returned"
            ? GEO.SLIP_UP.returned
            : GEO.SLIP_UP.saved;
      target.tag = state.deadLetter.owner !== null ? GEO.TAG_UP : 0;
      target.needle = tokenAngle(readout.activeToken);
      target.lease = leaseShare(readout.leaseRemaining);
      target.lever = leverAngle(state.pointer.assetId);

      readouts.forEach((element) => {
        const key = element.dataset.readout as keyof PublishGateReadout;
        element.textContent = readout[key];
      });
      if (note) note.textContent = note_;
      run();
    }

    function pressed(id: string | null) {
      buttons.forEach((button) =>
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.scenario === id),
        ),
      );
    }

    function startScenario(button: HTMLButtonElement) {
      const id = button.dataset.scenario ?? "";
      const label = button.textContent?.trim() ?? id;
      const steps = play(MECHANISM, id);
      cancel();
      pressed(id);
      // 先回到起點，再逐步播放；前一個情境的計時器已全部取消。
      apply(initialStep(MECHANISM), `播放中：${label}`);
      steps.forEach((step, index) => {
        const last_ = index === steps.length - 1;
        later(
          () =>
            apply(
              step,
              last_ && step.caption
                ? step.caption
                : `播放中：${label}（第 ${index + 1}／${steps.length} 步）`,
            ),
          LEAD_MS + index * STEP_MS,
        );
      });
    }

    buttons.forEach((button) =>
      button.addEventListener("click", () => startScenario(button)),
    );
    reset?.addEventListener("click", () => {
      cancel();
      pressed(null);
      apply(initialStep(MECHANISM), staticNote);
    });

    new IntersectionObserver(
      (entries) => {
        const newest = entries[entries.length - 1];
        if (!newest) return;
        visible = newest.isIntersecting;
        if (visible) run();
      },
      { rootMargin: "120px 0px" },
    ).observe(stage);

    root
      .querySelector<HTMLElement>("[data-vpg-controls]")
      ?.removeAttribute("hidden");
    root
      .querySelector<HTMLElement>("[data-vpg-hint]")
      ?.removeAttribute("hidden");
  }

  document.querySelectorAll<HTMLElement>("[data-vpg-root]").forEach(mount);
</script>

