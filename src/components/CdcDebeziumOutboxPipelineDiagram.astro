    }

    .cdc-mobile-card h4 {
      margin: 0 0 0.25rem 0;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--color-text-main, #0f172a);
    }
    :global(.dark) .cdc-mobile-card h4 {
      color: #f8fafc;
    }

    .cdc-mobile-card p {
      margin: 0.25rem 0;
