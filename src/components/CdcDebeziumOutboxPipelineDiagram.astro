    stroke: #f43f5e;
    fill: #fff1f2;
  }
  :global(.dark) .cdc-diagram__subcard--red {
    stroke: #be123c;
    fill: #4c0519;
  }

  .cdc-diagram__subcard--purple {
    stroke: #a855f7;
    fill: #faf5ff;
  }
  :global(.dark) .cdc-diagram__subcard--purple {
    stroke: #7e22ce;
