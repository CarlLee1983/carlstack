      font-weight: 700;
      display: block;
      margin-bottom: 0.25rem;
    }

    .grg-mobile-badge--grpc {
      color: #e11d48;
    }

    :global(.dark) .grg-mobile-badge--grpc {
      color: #fb7185;
    }

    .grg-mobile-badge--rest {
      color: #0891b2;
    }

    :global(.dark) .grg-mobile-badge--rest {
      color: #22d3ee;
    }

    .grg-mobile-badge--graphql {
      color: #9333ea;
    }

    :global(.dark) .grg-mobile-badge--graphql {
      color: #c084fc;
    }

    .grg-mobile-card h4 {
      margin: 0 0 0.25rem 0;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--color-text-main, #0f172a);
