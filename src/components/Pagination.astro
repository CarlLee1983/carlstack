---
import type { PaginationState } from "../utils/pagination";

interface Props {
  pagination: PaginationState<unknown>;
  label?: string;
}

const { pagination, label = "文章分頁" } = Astro.props;
const { current, total, prevHref, nextHref, pages } = pagination;
---

{
  total > 1 && (
    <nav class="pagination" aria-label={label}>
      {prevHref ? (
        <a class="pagination__step" href={prevHref} rel="prev">
          ← 上一頁
        </a>
      ) : (
        <span class="pagination__step is-disabled" aria-hidden="true">
          ← 上一頁
        </span>
      )}
      <ol class="pagination__pages">
        {pages.map((page) => (
          <li>
            {page.current ? (
              <span class="pagination__page is-current" aria-current="page">
                {page.number}
              </span>
            ) : (
              <a
                class="pagination__page"
                href={page.href}
                aria-label={`第 ${page.number} 頁`}
              >
                {page.number}
              </a>
            )}
          </li>
        ))}
      </ol>
      {nextHref ? (
        <a class="pagination__step" href={nextHref} rel="next">
          下一頁 →
        </a>
      ) : (
        <span class="pagination__step is-disabled" aria-hidden="true">
          下一頁 →
        </span>
      )}
      <p class="pagination__status">
        第 {current} / {total} 頁
      </p>
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding-block-start: var(--space-lg);
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  .pagination__pages {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pagination__step,
  .pagination__page {
    display: inline-flex;
    min-width: 2.25rem;
    align-items: center;
    justify-content: center;
    padding: var(--space-xs) var(--space-sm);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    transition: color var(--dur-micro) var(--ease-out);
  }

  a.pagination__step:hover,
  a.pagination__page:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .pagination__page.is-current {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .pagination__step.is-disabled {
    color: var(--color-faint);
    opacity: 0.5;
  }

  .pagination__status {
    flex-basis: 100%;
    color: var(--color-faint);
    font-size: var(--text-sm);
    text-align: center;
  }

  @media (max-width: 30rem) {
    .pagination__pages {
      order: 1;
      flex-basis: 100%;
      justify-content: center;
    }
  }
</style>
