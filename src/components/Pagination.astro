---
import type { PaginationState } from "../utils/pagination";

interface Props {
  pagination: PaginationState<unknown>;
  label?: string;
}

const { pagination, label = "文章分頁" } = Astro.props;
const { total, prevHref, nextHref, elements, pages } = pagination;
const displayItems =
  elements ?? pages.map((p) => ({ type: "page" as const, ...p }));
const pad = (value: number) => String(value).padStart(2, "0");
---

{
  total > 1 && (
    <nav class="pager" aria-label={label}>
      <div class="pager__step pager__step--prev">
        {prevHref ? (
          <a
            class="pager__nav-btn"
            href={prevHref}
            rel="prev"
            aria-label="前往上一頁"
          >
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="19" y1="12" x2="5" y2="12" />
              <polyline points="12 19 5 12 12 5" />
            </svg>
            <span class="pager__nav-text">上一頁</span>
          </a>
        ) : (
          <span class="pager__nav-btn is-disabled" aria-hidden="true">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="19" y1="12" x2="5" y2="12" />
              <polyline points="12 19 5 12 12 5" />
            </svg>
            <span class="pager__nav-text">上一頁</span>
          </span>
        )}
      </div>

      <ol class="pager__pages">
        {displayItems.map((item) => (
          <li>
            {item.type === "page" ? (
              item.current ? (
                <span class="pager__pill is-current" aria-current="page">
                  {pad(item.number)}
                </span>
              ) : (
                <a
                  class="pager__pill"
                  href={item.href}
                  aria-label={`第 ${item.number} 頁`}
                >
                  {pad(item.number)}
                </a>
              )
            ) : (
              <span class="pager__ellipsis" aria-hidden="true">
                &hellip;
              </span>
            )}
          </li>
        ))}
      </ol>

      <div class="pager__step pager__step--next">
        {nextHref ? (
          <a
            class="pager__nav-btn"
            href={nextHref}
            rel="next"
            aria-label="前往下一頁"
          >
            <span class="pager__nav-text">下一頁</span>
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        ) : (
          <span class="pager__nav-btn is-disabled" aria-hidden="true">
            <span class="pager__nav-text">下一頁</span>
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </span>
        )}
      </div>
    </nav>
  )
}

<style>
  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-width: 0;
    gap: var(--space-md);
    padding-block-start: var(--space-xl);
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  .pager__step--prev {
    justify-self: start;
  }

  .pager__step--next {
    justify-self: end;
  }

  /* 膠囊導覽按鈕（上一頁／下一頁） */
  .pager__nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    padding-inline: 1rem;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-pill);
    background: var(--color-card);
    color: var(--color-ink-2);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: all var(--dur-micro) var(--ease-out);
  }

  a.pager__nav-btn:hover {
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border-color: var(--color-accent);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  a.pager__nav-btn:active {
    transform: translateY(1px);
  }

  .pager__nav-btn.is-disabled {
    opacity: 0.4;
    cursor: not-allowed;
    background: transparent;
    border-color: var(--color-rule);
    box-shadow: none;
  }

  .pager__pages {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 頁碼膠囊 pill 按鈕 */
  .pager__pill {
    display: grid;
    place-items: center;
    min-width: 2.5rem;
    min-height: 2.5rem;
    padding-inline: 0.6rem;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-pill);
    background: var(--color-card);
    color: var(--color-ink-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: all var(--dur-micro) var(--ease-out);
  }

  a.pager__pill:hover {
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border-color: var(--color-accent);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  a.pager__pill:active {
    transform: translateY(1px);
  }

  .pager__pill.is-current {
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border-color: var(--color-accent);
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(185, 74, 43, 0.28);
  }

  .pager__ellipsis {
    display: grid;
    place-items: center;
    min-width: 1.75rem;
    min-height: 2.5rem;
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    user-select: none;
  }

  @media (max-width: 38rem) {
    .pager {
      grid-template-columns: 1fr 1fr;
      row-gap: var(--space-md);
    }

    .pager__pages {
      order: -1;
      grid-column: 1 / -1;
      justify-content: center;
    }

    .pager__nav-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
