---
import type { PaginationState } from "../utils/pagination";

interface Props {
  pagination: PaginationState<unknown>;
  label?: string;
}

const { pagination, label = "文章分頁" } = Astro.props;
const { total, prevHref, nextHref, pages } = pagination;
const pad = (value: number) => String(value).padStart(2, "0");
---

{
  total > 1 && (
    <nav class="pager" aria-label={label}>
      <div class="pager__step pager__step--prev">
        {prevHref && (
          <a class="text-link" href={prevHref} rel="prev">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="19" y1="12" x2="5" y2="12" />
              <polyline points="12 19 5 12 12 5" />
            </svg>
            <span>上一頁</span>
          </a>
        )}
      </div>

      <ol class="pager__pages">
        {pages.map((page) => (
          <li>
            {page.current ? (
              <span class="pager__page is-current" aria-current="page">
                {pad(page.number)}
              </span>
            ) : (
              <a
                class="pager__page"
                href={page.href}
                aria-label={`第 ${page.number} 頁`}
              >
                {pad(page.number)}
              </a>
            )}
          </li>
        ))}
      </ol>

      <div class="pager__step pager__step--next">
        {nextHref && (
          <a class="text-link" href={nextHref} rel="next">
            <span>下一頁</span>
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        )}
      </div>
    </nav>
  )
}

<style>
  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-width: 0;
    gap: var(--space-lg);
    padding-block-start: var(--space-lg);
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  /* 沒有上一頁／下一頁時欄位留白，頁碼才會固定在中線 */
  .pager__step--next {
    justify-self: end;
  }

  .pager__pages {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pager__page {
    display: block;
    padding-block-end: 0.35rem;
    border-block-end: 2px solid transparent;
    color: var(--color-faint);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: color var(--dur-micro) var(--ease-out);
  }

  a.pager__page:hover {
    color: var(--color-ink);
  }

  .pager__page.is-current {
    border-block-end-color: var(--color-accent);
    color: var(--color-ink);
  }

  @media (max-width: 34rem) {
    .pager {
      grid-template-columns: auto auto;
      justify-content: space-between;
      row-gap: var(--space-md);
    }

    .pager__pages {
      order: -1;
      grid-column: 1 / -1;
      justify-content: center;
    }
  }
</style>
