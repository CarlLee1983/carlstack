  }

  @media (max-width: 768px) {
    .stack-diagram__desktop {
      display: none;
    }

    .stack-diagram__mobile {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .stack-mobile-card {
      padding: 1rem;
      background: var(--dg-surface);
      border: 1px solid var(--dg-rule);
      border-radius: 10px;
