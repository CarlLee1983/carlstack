    stroke: #14b8a6;
    fill: #f0fdfa;
  }
  :global(:root[data-theme="dark"]) .stack-diagram__subcard--teal {
    stroke: #0f766e;
    fill: #042f2e;
  }

  .stack-diagram__subcard--gold {
    stroke: #fbbf24;
    fill: #fefce8;
  }
  :global(:root[data-theme="dark"]) .stack-diagram__subcard--gold {
    stroke: #d97706;
