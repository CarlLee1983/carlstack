  }
  :global(:root[data-theme="dark"]) .stack-diagram__header--gold {
    fill: #fbbf24;
  }

  .stack-diagram__header--green {
    fill: #047857;
  }
  :global(:root[data-theme="dark"]) .stack-diagram__header--green {
