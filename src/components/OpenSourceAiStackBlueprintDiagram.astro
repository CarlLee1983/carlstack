    }
    :global(:root[data-theme="dark"]) .stack-mobile-badge--indigo {
      color: #818cf8;
    }

    .stack-mobile-badge--pink {
      color: #be185d;
    }
    :global(:root[data-theme="dark"]) .stack-mobile-badge--pink {
      color: #f472b6;
    }

    .stack-mobile-badge--cyan {
      color: #0891b2;
    }
