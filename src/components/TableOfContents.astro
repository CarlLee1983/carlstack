---
import { buildToc, type MarkdownHeading } from "../utils/toc";

interface Props {
  headings: MarkdownHeading[];
  /** 少於這個數量就不值得占版面。 */
  minEntries?: number;
}

const { headings, minEntries = 3 } = Astro.props;
const entries = buildToc(headings);
const shouldRender = entries.length >= minEntries;
---

{
  shouldRender && (
    <nav class="toc" aria-labelledby="toc-title">
      <h2 class="toc__title" id="toc-title">
        目錄
      </h2>
      <ol class="toc__list">
        {entries.map((entry) => (
          <li>
            <a href={`#${entry.slug}`}>{entry.text}</a>
            {entry.children.length > 0 && (
              <ol class="toc__list toc__list--nested">
                {entry.children.map((child) => (
                  <li>
                    <a href={`#${child.slug}`}>{child.text}</a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc {
    padding: var(--space-lg);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-card);
  }

  .toc__title {
    margin-block-end: var(--space-sm);
    color: var(--color-faint);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .toc__list {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: toc;
  }

  .toc__list--nested {
    margin-block-start: var(--space-xs);
    padding-inline-start: var(--space-md);
    border-inline-start: var(--rule-hair) solid var(--color-rule);
  }

  .toc a {
    display: block;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
    text-decoration: none;
    text-wrap: pretty;
    transition: color var(--dur-micro) var(--ease-out);
  }

  .toc a:hover {
    color: var(--color-accent);
  }

  .toc__list--nested a {
    color: var(--color-faint);
    font-size: var(--text-xs);
  }

  @media (min-width: 72rem) {
    .toc {
      position: sticky;
      inset-block-start: 5rem;
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 0 0 0 var(--space-lg);
      border: none;
      border-inline-start: var(--rule-hair) solid var(--color-rule);
      border-radius: 0;
      background: none;
    }
  }
</style>
