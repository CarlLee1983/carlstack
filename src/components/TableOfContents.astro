---
import { buildToc, type MarkdownHeading } from "../utils/toc";

interface Props {
  headings: MarkdownHeading[];
  /** 少於這個數量就不值得占版面。 */
  minEntries?: number;
}

const { headings, minEntries = 3 } = Astro.props;
const entries = buildToc(headings);
const shouldRender = entries.length >= minEntries;
---

{
  shouldRender && (
    <nav class="toc" aria-labelledby="toc-title">
      <h2 class="toc__title" id="toc-title">
        目錄
      </h2>
      <ol class="toc__list">
        {entries.map((entry) => (
          <li>
            <a href={`#${entry.slug}`}>{entry.text}</a>
            {entry.children.length > 0 && (
              <ol class="toc__list toc__list--nested">
                {entry.children.map((child) => (
                  <li>
                    <a href={`#${child.slug}`}>{child.text}</a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc {
    padding: var(--space-lg);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-card);
  }

  .toc__title {
    margin-block-end: var(--space-sm);
    color: var(--color-faint);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .toc__list {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: toc;
  }

  .toc__list--nested {
    margin-block-start: var(--space-xs);
    padding-inline-start: var(--space-md);
    border-inline-start: var(--rule-hair) solid var(--color-rule);
  }

  .toc a {
    display: block;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
    text-decoration: none;
    text-wrap: pretty;
    transition: color var(--dur-micro) var(--ease-out);
  }

  .toc a:hover,
  .toc a[aria-current="true"] {
    color: var(--color-accent);
  }

  .toc__list > li > a[aria-current="true"] {
    font-weight: 700;
  }

  .toc__list--nested a {
    color: var(--color-faint);
    font-size: var(--text-xs);
  }

  .toc a {
    position: relative;
  }

  /* 目前章節：左側一小段主色，配合 sticky 側欄的髮絲線 */
  .toc a[aria-current="true"]::before {
    content: "";
    position: absolute;
    inset-block: 0.35em;
    inset-inline-start: calc(-1 * var(--space-lg) - 1px);
    width: 2px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
  }

  @media (min-width: 72rem) {
    .toc {
      position: sticky;
      inset-block-start: 5rem;
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 0 0 0 var(--space-lg);
      border: none;
      border-inline-start: var(--rule-hair) solid var(--color-rule);
      border-radius: 0;
      background: none;
    }
  }
</style>

<script>
  // 依「最後一個已經捲過 header 的標題」標記目錄目前章節；
  // 用 scroll 事件而非 IntersectionObserver，跳躍式捲動（點目錄、拉捲軸）也能對上。
  const toc = document.querySelector<HTMLElement>(".toc");
  if (toc) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>("a[href^='#']")];
    const pairs = links.flatMap((link) => {
      // 中文標題的 hash 會被百分號編碼，要先解碼才對得到 id
      const target = document.getElementById(
        decodeURIComponent(link.hash.slice(1)),
      );
      return target ? [{ link, target }] : [];
    });
    const threshold = 120;
    let ticking = false;

    const paint = () => {
      ticking = false;
      const atEnd =
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 2;
      const current = atEnd
        ? pairs.at(-1)
        : [...pairs]
            .reverse()
            .find(
              ({ target }) => target.getBoundingClientRect().top < threshold,
            );
      for (const { link } of pairs) {
        if (link === current?.link) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      }
    };
    const schedule = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(paint);
    };

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule, { passive: true });
    paint();
  }
</script>
