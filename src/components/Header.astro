---
import { navigation, siteConfig } from "../config/site";

const currentPath = Astro.url.pathname;
const currentState = (href: string) =>
  currentPath === href
    ? "page"
    : currentPath.startsWith(href)
      ? "location"
      : undefined;
---

<header class="site-header" data-pagefind-ignore>
  <div class="site-header__inner shell">
    <a class="wordmark" href="/" aria-label={`${siteConfig.name} 首頁`}>
      <span class="wordmark__badge">C/</span>
      <span class="wordmark__text">{siteConfig.name}</span>
    </a>
    <nav class="desktop-nav" aria-label="主要導覽">
      {
        navigation.map((item) => (
          <a href={item.href} aria-current={currentState(item.href)}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="site-header__actions">
      <button
        class="search-pill"
        type="button"
        data-search-open
        aria-haspopup="dialog"
        aria-label="開啟搜尋"
      >
        <svg
          class="icon-search"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="search-pill__label">搜尋</span>
        <kbd>⌘ K</kbd>
      </button>
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="切換深色或淺色模式"
        aria-pressed="false"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg
          class="theme-icon-sun"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg
          class="theme-icon-moon"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <details class="mobile-nav">
        <summary aria-label="切換選單">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </summary>
        <nav aria-label="行動版導覽">
          {
            navigation.map((item) => (
              <a href={item.href} aria-current={currentState(item.href)}>
                {item.label}
              </a>
            ))
          }
          <a href="/search/">搜尋文章</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<dialog class="cmdk" data-search-dialog aria-labelledby="cmdk-title">
  <form class="cmdk__panel" action="/search/" method="get">
    <div class="cmdk__head">
      <strong id="cmdk-title">搜尋 CarlStack</strong>
      <button type="button" data-search-close aria-label="關閉搜尋">關閉</button
      >
    </div>
    <label for="site-search">關鍵字</label>
    <div class="cmdk__input-wrap">
      <input
        class="cmdk__input"
        id="site-search"
        name="q"
        type="search"
        placeholder="搜尋文章、Agent 架構、專案..."
        autocomplete="off"
        autofocus
      />
    </div>
    <button class="button" type="submit">開啟全文搜尋</button>
    <p>按 Esc 關閉；完整結果會顯示文章摘要、標籤與日期。</p>
  </form>
</dialog>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  );
  const currentTheme = () =>
    root.dataset.theme ??
    (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
  const updateThemeState = () => {
    if (!toggle) return;
    const dark = currentTheme() === "dark";
    toggle.setAttribute("aria-pressed", String(dark));
    toggle.setAttribute(
      "aria-label",
      dark ? "切換為淺色模式" : "切換為深色模式",
    );
  };
  updateThemeState();
  toggle?.addEventListener("click", () => {
    const current = currentTheme();
    const next = current === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    localStorage.setItem("carlstack-theme", next);
    updateThemeState();
  });

  const dialog = document.querySelector<HTMLDialogElement>(
    "[data-search-dialog]",
  );
  const openSearch = () => {
    if (!dialog?.open) dialog?.showModal();
  };
  document
    .querySelector("[data-search-open]")
    ?.addEventListener("click", openSearch);
  document
    .querySelector("[data-search-close]")
    ?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      openSearch();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-sticky);
    border-block-end: var(--rule-hair) solid var(--color-rule);
    background: var(--color-paper);
    backdrop-filter: blur(12px);
    transition:
      background-color var(--dur-short) var(--ease-out),
      border-color var(--dur-short) var(--ease-out);
  }

  .site-header__inner {
    display: flex;
    justify-content: space-between;
    min-height: 4.25rem;
    align-items: center;
    gap: var(--space-md);
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.03em;
    font-size: 1.15rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark__badge {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .desktop-nav a {
    min-height: 2.25rem;
    display: inline-flex;
    align-items: center;
    padding-inline: var(--space-md);
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: all var(--dur-micro) var(--ease-out);
  }

  .desktop-nav a:hover {
    color: var(--color-ink);
    background: var(--color-paper-2);
  }

  .desktop-nav a[aria-current="page"],
  .desktop-nav a[aria-current="location"] {
    color: var(--color-ink);
    background: var(--color-paper-2);
    font-weight: 700;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .search-pill,
  .theme-toggle,
  .mobile-nav > summary,
  .cmdk__head button {
    min-height: 2.75rem;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-pill);
    background: var(--color-paper-2);
    color: var(--color-ink-2);
    transition: all var(--dur-micro) var(--ease-out);
  }

  .search-pill {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding-inline: var(--space-md);
    white-space: nowrap;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-muted);
  }

  .search-pill kbd {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    background: var(--color-card);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    border: var(--rule-hair) solid var(--color-rule);
    color: var(--color-muted);
  }

  .theme-toggle {
    width: 2.75rem;
    display: grid;
    place-items: center;
    padding: 0;
  }

  .theme-icon-sun {
    display: none;
  }
  .theme-icon-moon {
    display: block;
  }

  :root[data-theme="dark"] .theme-icon-sun {
    display: block;
  }
  :root[data-theme="dark"] .theme-icon-moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) .theme-icon-sun {
      display: block;
    }
    :root:not([data-theme]) .theme-icon-moon {
      display: none;
    }
  }

  .mobile-nav {
    display: none;
    position: relative;
    font-family: var(--font-display);
  }

  .mobile-nav > summary {
    display: grid;
    width: 2.75rem;
    place-items: center;
    padding: 0;
    list-style: none;
  }

  .mobile-nav > summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav nav {
    position: absolute;
    inset-block-start: calc(100% + var(--space-xs));
    inset-inline-end: 0;
    z-index: var(--z-dropdown);
    display: grid;
    gap: var(--space-xs);
    min-width: 13rem;
    padding: var(--space-sm);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-card);
    box-shadow: var(--shadow-lg);
  }

  .mobile-nav nav a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-md);
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .mobile-nav nav a:hover,
  .mobile-nav nav a[aria-current] {
    background: var(--color-paper-2);
    color: var(--color-accent);
  }

  .cmdk {
    position: fixed;
    inset: 0;
    width: min(38rem, calc(100% - 2rem));
    height: fit-content;
    max-height: min(80svh, 40rem);
    margin: auto;
    padding: 0;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-card);
    color: var(--color-ink-2);
    box-shadow: var(--shadow-lg);
  }

  .cmdk::backdrop {
    background: var(--color-overlay);
    backdrop-filter: blur(4px);
  }

  .cmdk__panel {
    display: grid;
    gap: var(--space-md);
    padding: var(--space-xl);
  }

  .cmdk__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    color: var(--color-ink);
    font-family: var(--font-display);
  }

  .cmdk__head button {
    padding-inline: var(--space-md);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .cmdk label {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
  }

  .cmdk__input-wrap {
    display: grid;
  }

  .cmdk__input {
    width: 100%;
  }

  .cmdk p {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  @media (hover: hover) and (pointer: fine) {
    .search-pill:hover,
    .theme-toggle:hover,
    .mobile-nav > summary:hover,
    .cmdk__head button:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
  }

  @media (max-width: 59.99rem) {
    .desktop-nav {
      display: none;
    }

    .mobile-nav {
      display: block;
    }
  }

  @media (max-width: 31rem) {
    .search-pill__label,
    .search-pill kbd {
      display: none;
    }

    .search-pill {
      width: 2.75rem;
      justify-content: center;
      padding: 0;
    }

    .site-header__inner,
    .site-header__actions {
      gap: var(--space-2xs);
    }
  }
</style>
