    <text class="refund-allocation-diagram__body" x="250" y="386"
      >100.00 − 3.33</text
    >
    <text class="refund-allocation-diagram__amount" x="520" y="386"
      >實付 96.67 元</text
    >
    <rect
      class="refund-allocation-diagram__surface"
      x="20"
      y="450"
      width="840"
      height="80"
      rx="12"></rect>
    <text class="refund-allocation-diagram__title" x="44" y="482"
      >先退 C → 申請退款 96.67 元</text
