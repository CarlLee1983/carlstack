    margin-block: var(--space-xl);
  }
  .multi-item-diagram svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-body);
  }
  .multi-item-diagram__panel {
    fill: var(--dg-surface-2);
    stroke: var(--dg-rule);
  }
  .multi-item-diagram__card {
    fill: var(--dg-surface);
    stroke: var(--dg-rule-strong);
  }
  .multi-item-diagram__heading {
    font-size: 19px;
    font-weight: 800;
    fill: var(--dg-ink);
  }
  .multi-item-diagram__lead {
    font-size: 14px;
    font-weight: 700;
    fill: var(--dg-ink);
  }
  .multi-item-diagram__label {
    font-size: 17px;
    font-weight: 700;
    fill: var(--dg-ink);
  }
  .multi-item-diagram__detail {
    font-size: 14px;
    fill: var(--dg-ink-2);
  }
  .multi-item-diagram__arrow {
    fill: none;
    stroke: var(--dg-rule-strong);
    stroke-width: 2;
    marker-end: url(#multi-item-arrow);
  }
  .multi-item-diagram marker path {
    fill: var(--dg-rule-strong);
  }
  .multi-item-diagram__reject {
    fill: #9a3412;
    color: #9a3412;
  }
  .multi-item-diagram__accept {
    fill: #166534;
    color: #166534;
  }
  :global(:root[data-theme="dark"]) .multi-item-diagram__reject {
    fill: #fdba74;
    color: #fdba74;
  }
  :global(:root[data-theme="dark"]) .multi-item-diagram__accept {
    fill: #86efac;
    color: #86efac;
  }
  .multi-item-diagram__mobile {
    display: none;
  }
  .multi-item-diagram__mobile-lead {
    color: var(--dg-ink-2);
  }
  .multi-item-diagram__mobile-card {
    margin-block: var(--space-md);
    padding: var(--space-md);
    border: 1px solid var(--dg-rule-strong);
    border-radius: 12px;
    background: var(--dg-surface);
  }
  .multi-item-diagram__mobile-card h3 {
    margin: 0 0 var(--space-xs);
    font-size: var(--text-base);
  }
  .multi-item-diagram__mobile-card p {
    margin: 0;
    color: var(--dg-ink-2);
  }
  .multi-item-diagram figcaption {
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--dg-ink-2);
  }
  @media (max-width: 48rem) {
    .multi-item-diagram__desktop {
      display: none !important;
    }
    .multi-item-diagram__mobile {
      display: block !important;
    }
  }
</style>
