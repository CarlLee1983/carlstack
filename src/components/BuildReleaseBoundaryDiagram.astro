  }
  .release-boundary__desktop {
    display: block;
    width: 100%;
    height: auto;
  }
  .release-boundary__desktop text {
    fill: var(--dg-ink-2);
    font-family: var(--font-body);
    font-size: 15px;
  }
  .release-boundary__desktop .release-boundary__title {
    fill: var(--dg-ink);
    font-size: 22px;
    font-weight: 700;
  }
  .release-boundary__desktop .release-boundary__label {
    fill: var(--dg-ink);
    font-size: 16px;
    font-weight: 700;
  }
  .release-boundary__desktop rect {
    fill: var(--dg-surface-2);
    stroke: var(--dg-rule);
  }
  .release-boundary__arrow {
    fill: none;
    stroke: var(--dg-rule-strong);
    stroke-width: 2;
    marker-end: url(#release-boundary-arrow);
  }
  #release-boundary-arrow path {
    fill: var(--dg-rule-strong);
  }
  .release-boundary__mobile {
    display: none;
  }
  .release-boundary__heading {
    font-weight: 700;
  }
  .release-boundary__mobile ol {
    padding-left: 1.5rem;
  }
  .release-boundary__mobile li {
    margin: 0.75rem 0;
    padding: 0.75rem;
    border: 1px solid var(--dg-rule);
    border-radius: 0.75rem;
    background: var(--dg-surface-2);
  }
  .release-boundary__mobile span {
    display: block;
    margin-top: 0.5rem;
  }
  .release-boundary figcaption {
    margin-top: 1rem;
    color: var(--dg-muted);
    font-size: 0.875rem;
  }
  @media (max-width: 48rem) {
    .release-boundary__desktop {
      display: none !important;
    }
    .release-boundary__mobile {
      display: block !important;
    }
  }
</style>
