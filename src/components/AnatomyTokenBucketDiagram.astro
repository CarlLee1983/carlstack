<style>
  .atb-diagram {
    margin: var(--space-8, 2rem) 0;
    width: 100%;
  }

  .atb-diagram__desktop {
    display: block;
    width: 100%;
    height: auto;
    background: var(--dg-surface-2);
    border: 1px solid var(--dg-rule);
    border-radius: 8px;
  }

  figcaption {
    margin-top: var(--space-3, 0.75rem);
    font-size: var(--text-sm, 0.875rem);
    line-height: 1.5;
    color: var(--dg-muted);
    text-align: center;
  }

  /* Anatomy Theme Mapping based on diagram-guide.md */
  .iso {
    --anatomy-paper: var(--dg-surface);
    --anatomy-face: var(--dg-surface);
    --anatomy-top: var(--dg-surface);
    --anatomy-lit-top: var(--dg-surface);
    --anatomy-card: var(--dg-surface);
    --anatomy-page: var(--dg-surface-2);

    --anatomy-strong: var(--dg-ink);
    --anatomy-lit: var(--dg-ink);
    --anatomy-dot: var(--dg-ink);

    --anatomy-text: var(--dg-ink-2);
    --anatomy-hi: var(--dg-ink-2);
    --anatomy-mid: var(--dg-muted);
    --anatomy-lo: var(--dg-rule-strong);
    --anatomy-faint: var(--dg-rule);

    --anatomy-shade-0: color-mix(
      in oklab,
      var(--dg-surface),
      var(--color-code, #38bdf8) 14%
    );
    --anatomy-shade-1: color-mix(
      in oklab,
      var(--dg-surface),
      var(--color-code, #38bdf8) 10%
    );
    --anatomy-shade-2: color-mix(
      in oklab,
      var(--dg-surface),
      var(--color-code, #38bdf8) 7%
    );
    --anatomy-shade-3: color-mix(
      in oklab,
      var(--dg-surface),
      var(--color-code, #38bdf8) 4%
    );
    --anatomy-lit-shade: color-mix(
      in oklab,
      var(--dg-surface),
      var(--color-code, #38bdf8) 14%
