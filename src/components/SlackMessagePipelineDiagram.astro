---
// Slack Message Pipeline Architecture Diagram
---

<figure class="slack-diagram" aria-labelledby="slack-caption">
  <svg
    class="slack-diagram__desktop"
    viewBox="0 0 960 460"
    role="img"
    aria-labelledby="slack-title slack-desc"
  >
    <title id="slack-title">Slack 訊息投遞相關元件（依原文年份）</title>
    <desc id="slack-desc">
      整理 Slack 工程部落格四篇原文的元件：2023 年的 Envoy、Gateway Server、
      Admin Server、Channel Server，2020 年的 Vitess，2017 年的 Flannel 與 Job
      Queue。
    </desc>

    <defs>
      <marker
        id="slack-arrow"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" class="slack-diagram__arrow-head"
        ></path>
      </marker>
    </defs>

    <!-- Column 1: Client & Edge -->
    <g class="slack-diagram__card" transform="translate(20, 35)">
      <rect width="215" height="380" rx="12"></rect>
      <text class="slack-diagram__badge" x="14" y="26">CONNECTION · 2023</text>
      <text class="slack-diagram__title" x="14" y="54">連線與閘道</text>

      <g transform="translate(14, 75)">
        <rect
          width="187"
          height="85"
          rx="6"
          class="slack-diagram__subcard slack-diagram__subcard--teal"></rect>
        <text
          class="slack-diagram__header slack-diagram__header--teal"
          x="10"
          y="20">Slack Client (App/Web)</text
        >
        <text class="slack-diagram__desc" x="10" y="40"
          >• 開機向 Webapp 取 token</text
        >
        <text class="slack-diagram__desc" x="10" y="58">• 連最近的邊緣區域</text
        >
        <text class="slack-diagram__desc" x="10" y="76">• WebSocket 長連線</text
        >
      </g>

      <g transform="translate(14, 175)">
        <rect
          width="187"
          height="95"
          rx="6"
          class="slack-diagram__subcard slack-diagram__subcard--blue"></rect>
        <text
          class="slack-diagram__header slack-diagram__header--blue"
          x="10"
          y="20">Envoy</text
        >
        <text class="slack-diagram__desc" x="10" y="40">• 負載平衡</text>
        <text class="slack-diagram__desc" x="10" y="58">• TLS 終結</text>
        <text class="slack-diagram__desc" x="10" y="76"
          >• 把 WebSocket 轉給 GS</text
        >
      </g>

      <g transform="translate(14, 285)">
        <rect
          width="187"
          height="75"
          rx="6"
          class="slack-diagram__subcard slack-diagram__subcard--gold"></rect>
        <text
          class="slack-diagram__header slack-diagram__header--gold"
          x="10"
          y="20">Gateway Server</text
        >
        <text class="slack-diagram__desc" x="10" y="40"
          >• 部署在多個地理區域</text
        >
        <text class="slack-diagram__desc" x="10" y="58"
          >• 存使用者資訊與訂閱</text
        >
      </g>
    </g>

    <!-- Column 2: Ingestion & Routing -->
    <g class="slack-diagram__card" transform="translate(255, 35)">
      <rect width="215" height="380" rx="12"></rect>
      <text class="slack-diagram__badge" x="14" y="26">ROUTING · 2023</text>
      <text class="slack-diagram__title" x="14" y="54">寫入與路由</text>

      <g transform="translate(14, 75)">
        <rect
          width="187"
          height="90"
          rx="6"
          class="slack-diagram__subcard slack-diagram__subcard--teal"></rect>
        <text
          class="slack-diagram__header slack-diagram__header--teal"
          x="10"
          y="20">Webapp 後端</text
        >
        <text class="slack-diagram__desc" x="10" y="40"
          >• 客戶端呼叫 API 送訊息</text
        >
        <text class="slack-diagram__desc" x="10" y="58">• 把訊息交給 AS</text>
        <text class="slack-diagram__desc" x="10" y="76"
          >• 提供 WebSocket 連線設定</text
        >
      </g>

      <g transform="translate(14, 180)">
        <rect
          width="187"
          height="90"
          rx="6"
          class="slack-diagram__subcard slack-diagram__subcard--gold"></rect>
        <text
          class="slack-diagram__header slack-diagram__header--gold"
          x="10"
          y="20">Admin Server</text
        >
        <text class="slack-diagram__desc" x="10" y="40">• 無狀態</text>
        <text class="slack-diagram__desc" x="10" y="58"
          >• 介接 Webapp 與 CS</text
        >
        <text class="slack-diagram__desc" x="10" y="76"
          >• 依頻道 ID 查雜湊環</text
        >
      </g>

      <g transform="translate(14, 285)">
        <rect
          width="187"
          height="75"
          rx="6"
          class="slack-diagram__subcard slack-diagram__subcard--blue"></rect>
        <text
          class="slack-diagram__header slack-diagram__header--blue"
          x="10"
          y="20">CHARMs + Consul</text
        >
        <text class="slack-diagram__desc" x="10" y="40"
          >• 管理 CS 一致性雜湊環</text
        >
        <text class="slack-diagram__desc" x="10" y="58"
          >• 雜湊設定登記在 Consul</text
        >
      </g>
    </g>

    <!-- Column 3: Realtime Fanout -->
    <g class="slack-diagram__card" transform="translate(490, 35)">
      <rect width="215" height="380" rx="12"></rect>
      <text class="slack-diagram__badge" x="14" y="26">FANOUT · 2023</text>
      <text class="slack-diagram__title" x="14" y="54">頻道扇出</text>

      <g transform="translate(14, 75)">
        <rect
          width="187"
          height="95"
          rx="6"
          class="slack-diagram__subcard slack-diagram__subcard--blue"></rect>
        <text
          class="slack-diagram__header slack-diagram__header--blue"
          x="10"
          y="20">Channel Server</text
        >
        <text class="slack-diagram__desc" x="10" y="40"
          >• 有狀態，存頻道歷史</text
        >
        <text class="slack-diagram__desc" x="10" y="58"
          >• 尖峰每台約 1,600 萬頻道</text
        >
        <text class="slack-diagram__desc" x="10" y="76">• 送給有訂閱的 GS</text>
      </g>

      <g transform="translate(14, 185)">
        <rect
          width="187"
          height="85"
          rx="6"
          class="slack-diagram__subcard slack-diagram__subcard--gold"></rect>
        <text
          class="slack-diagram__header slack-diagram__header--gold"
          x="10"
          y="20">Gateway Server</text
        >
        <text class="slack-diagram__desc" x="10" y="40"
          >• 收到 CS 送來的訊息</text
        >
        <text class="slack-diagram__desc" x="10" y="58">• 送給自己的客戶端</text
        >
        <text class="slack-diagram__desc" x="10" y="76"
          >• 只送給有訂閱的連線</text
        >
      </g>

      <g transform="translate(14, 285)">
        <rect
          width="187"
          height="75"
          rx="6"
          class="slack-diagram__subcard slack-diagram__subcard--teal"></rect>
        <text
          class="slack-diagram__header slack-diagram__header--teal"
          x="10"
          y="20">Presence Server</text
        >
        <text class="slack-diagram__desc" x="10" y="40">• 追蹤誰在線上</text>
        <text class="slack-diagram__desc" x="10" y="58">• 驅動在線指示</text>
      </g>
    </g>

    <!-- Column 4: Storage & Recovery -->
    <g class="slack-diagram__card" transform="translate(725, 35)">
      <rect width="215" height="380" rx="12"></rect>
      <text class="slack-diagram__badge" x="14" y="26">STORAGE · 2017–2020</text
      >
      <text class="slack-diagram__title" x="14" y="54">儲存與快取</text>

      <g transform="translate(14, 75)">
        <rect
          width="187"
          height="90"
          rx="6"
          class="slack-diagram__subcard slack-diagram__subcard--gold"></rect>
        <text
          class="slack-diagram__header slack-diagram__header--gold"
          x="10"
          y="20">MySQL + Vitess（2020）</text
        >
        <text class="slack-diagram__desc" x="10" y="40">• 2017 年開始遷移</text>
        <text class="slack-diagram__desc" x="10" y="58"
          >• 訊息改按頻道 ID 分片</text
        >
        <text class="slack-diagram__desc" x="10" y="76">• 承接 99% 查詢量</text>
      </g>

      <g transform="translate(14, 180)">
        <rect
          width="187"
          height="90"
          rx="6"
          class="slack-diagram__subcard slack-diagram__subcard--teal"></rect>
        <text
          class="slack-diagram__header slack-diagram__header--teal"
          x="10"
          y="20">Flannel（2017）</text
        >
        <text class="slack-diagram__desc" x="10" y="40">• 部署在邊緣 PoP</text>
        <text class="slack-diagram__desc" x="10" y="58"
          >• 快取使用者、頻道、bot</text
        >
        <text class="slack-diagram__desc" x="10" y="76">• 啟動資料延遲載入</text
        >
      </g>

      <g transform="translate(14, 285)">
        <rect
          width="187"
          height="75"
          rx="6"
          class="slack-diagram__subcard slack-diagram__subcard--blue"></rect>
        <text
          class="slack-diagram__header slack-diagram__header--blue"
          x="10"
          y="20">Job Queue（2017）</text
        >
        <text class="slack-diagram__desc" x="10" y="40"
          >• Kafka → JQRelay → Redis</text
        >
        <text class="slack-diagram__desc" x="10" y="58"
          >• 含訊息發送、推播通知</text
        >
      </g>
    </g>

    <!-- Connectors / Flow Lines -->
    <path
      d="M 235 155 L 255 155"
      class="slack-diagram__line"
      marker-end="url(#slack-arrow)"></path>
    <path
      d="M 470 155 L 490 155"
      class="slack-diagram__line"
      marker-end="url(#slack-arrow)"></path>
    <path
      d="M 705 155 L 725 155"
      class="slack-diagram__line"
      marker-end="url(#slack-arrow)"></path>
  </svg>

  <!-- Mobile View -->
  <svg
    class="slack-diagram__mobile"
    viewBox="0 0 320 620"
    role="img"
    aria-labelledby="slack-m-title"
  >
    <title id="slack-m-title">Slack 訊息投遞相關元件（手機檢視）</title>

    <g class="slack-diagram__card" transform="translate(10, 10)">
      <rect width="300" height="130" rx="8"></rect>
      <text class="slack-diagram__badge" x="12" y="22"
        >1. 連線與閘道（2023）</text
      >
      <text class="slack-diagram__desc" x="12" y="45"
        >• 客戶端連最近邊緣區域的 Envoy</text
      >
      <text class="slack-diagram__desc" x="12" y="65"
        >• Envoy 負載平衡、TLS 終結</text
      >
      <text class="slack-diagram__desc" x="12" y="85"
        >• Gateway Server 部署在多個區域</text
      >
      <text class="slack-diagram__desc" x="12" y="105"
        >• GS 存使用者資訊與頻道訂閱</text
      >
    </g>

    <g class="slack-diagram__card" transform="translate(10, 155)">
      <rect width="300" height="135" rx="8"></rect>
      <text class="slack-diagram__badge" x="12" y="22"
        >2. 寫入與路由（2023）</text
      >
      <text class="slack-diagram__desc" x="12" y="45"
        >• 客戶端呼叫 Webapp API 送訊息</text
      >
      <text class="slack-diagram__desc" x="12" y="65"
        >• Webapp 把訊息交給 Admin Server</text
      >
      <text class="slack-diagram__desc" x="12" y="85"
        >• AS 依頻道 ID 查雜湊環找 CS</text
      >
      <text class="slack-diagram__desc" x="12" y="105"
        >• CHARMs 管理雜湊環，設定在 Consul</text
      >
    </g>

    <g class="slack-diagram__card" transform="translate(10, 305)">
      <rect width="300" height="140" rx="8"></rect>
      <text class="slack-diagram__badge" x="12" y="22">3. 頻道扇出（2023）</text
      >
      <text class="slack-diagram__desc" x="12" y="45"
        >• Channel Server 存頻道歷史</text
      >
      <text class="slack-diagram__desc" x="12" y="65"
        >• CS 送給每台有訂閱的 GS</text
      >
      <text class="slack-diagram__desc" x="12" y="85"
        >• GS 送給自己身上的客戶端</text
      >
      <text class="slack-diagram__desc" x="12" y="105"
        >• Presence Server 追蹤誰在線上</text
      >
    </g>

    <g class="slack-diagram__card" transform="translate(10, 460)">
      <rect width="300" height="145" rx="8"></rect>
      <text class="slack-diagram__badge" x="12" y="22"
        >4. 儲存與快取（2017–2020）</text
      >
      <text class="slack-diagram__desc" x="12" y="45"
        >• 2020：Vitess，訊息按頻道 ID 分片</text
      >
      <text class="slack-diagram__desc" x="12" y="65"
        >• 2020：Vitess 承接 99% 查詢量</text
      >
      <text class="slack-diagram__desc" x="12" y="85"
        >• 2017：Flannel 部署在邊緣 PoP</text
      >
      <text class="slack-diagram__desc" x="12" y="105"
        >• 2017：Job Queue 處理推播等工作</text
      >
    </g>
  </svg>

  <figcaption id="slack-caption" class="slack-diagram__caption">
    圖 1：依 Slack 工程部落格四篇原文（2017 年兩篇，2020、2023
    年各一篇）整理的元件； 不同年份的元件不代表同一時期的架構
  </figcaption>
</figure>

<style>
  .slack-diagram {
    margin: 2rem 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .slack-diagram svg {
    width: 100%;
    height: auto;
    max-width: 960px;
    font-family:
      -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue",
      Arial, sans-serif;
  }

  .slack-diagram__desktop {
    display: block;
  }

  .slack-diagram__mobile {
    display: none;
  }

  .slack-diagram__caption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--dg-muted);
    text-align: center;
  }

  /* SVG Theme Variables */
  .slack-diagram__card rect {
    fill: var(--dg-surface-2);
    stroke: var(--dg-rule);
    stroke-width: 1.5;
  }

  .slack-diagram__badge {
    font-size: 10px;
    font-weight: 700;
    fill: var(--dg-muted);
    letter-spacing: 0.05em;
  }

  .slack-diagram__title {
    font-size: 15px;
    font-weight: 700;
    fill: var(--dg-ink);
  }

  .slack-diagram__subcard {
    stroke-width: 1;
  }

  .slack-diagram__subcard--teal {
    fill: rgba(13, 148, 136, 0.08);
    stroke: rgba(13, 148, 136, 0.3);
  }

  :global(:root[data-theme="dark"]) .slack-diagram__subcard--teal {
    fill: rgba(20, 184, 166, 0.12);
    stroke: rgba(20, 184, 166, 0.35);
  }

  .slack-diagram__subcard--blue {
    fill: rgba(37, 99, 235, 0.08);
    stroke: rgba(37, 99, 235, 0.3);
  }

  :global(:root[data-theme="dark"]) .slack-diagram__subcard--blue {
    fill: rgba(59, 130, 246, 0.12);
    stroke: rgba(59, 130, 246, 0.35);
  }

  .slack-diagram__subcard--gold {
    fill: rgba(217, 119, 6, 0.08);
    stroke: rgba(217, 119, 6, 0.3);
  }

  :global(:root[data-theme="dark"]) .slack-diagram__subcard--gold {
    fill: rgba(245, 158, 11, 0.12);
    stroke: rgba(245, 158, 11, 0.35);
  }

  .slack-diagram__header {
    font-size: 12px;
    font-weight: 700;
  }

  .slack-diagram__header--teal {
    fill: #0f766e;
  }
  :global(:root[data-theme="dark"]) .slack-diagram__header--teal {
    fill: #2dd4bf;
  }

  .slack-diagram__header--blue {
    fill: #1d4ed8;
  }
  :global(:root[data-theme="dark"]) .slack-diagram__header--blue {
    fill: #60a5fa;
  }

  .slack-diagram__header--gold {
    fill: #b45309;
  }
  :global(:root[data-theme="dark"]) .slack-diagram__header--gold {
    fill: #fbbf24;
  }

  .slack-diagram__desc {
    font-size: 11px;
    fill: var(--dg-ink-2);
  }

  .slack-diagram__line {
    stroke: var(--dg-rule-strong);
    stroke-width: 2;
    fill: none;
  }

  .slack-diagram__arrow-head {
    fill: var(--dg-rule-strong);
  }

  @media (max-width: 640px) {
    .slack-diagram__desktop {
      display: none;
    }
    .slack-diagram__mobile {
      display: block;
      max-width: 320px;
    }
  }
</style>
