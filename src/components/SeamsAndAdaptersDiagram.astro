      font-weight: 700;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      background: rgba(2, 132, 199, 0.1);
      color: #0284c7;
    }

    .seams-diagram__mpill--prod {
      background: rgba(100, 116, 139, 0.1);
