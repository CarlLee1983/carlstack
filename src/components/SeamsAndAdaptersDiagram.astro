  }

  figcaption {
    margin-top: 1rem;
    font-size: var(--text-sm);
    color: var(--dg-muted);
    text-align: center;
    line-height: 1.6;
  }

  /* 窄螢幕樣式 */
  @media (max-width: 48rem) {
    .seams-diagram__desktop {
