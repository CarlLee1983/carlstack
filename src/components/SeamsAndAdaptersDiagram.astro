    fill: var(--dg-surface);
    stroke: var(--dg-rule);
    stroke-width: 1;
  }

  .seams-diagram__badge {
    font-size: 14px;
    font-weight: 700;
    fill: var(--dg-ink);
    font-family: var(--font-body);
  }

  .seams-diagram__sub {
    font-size: 12.5px;
    fill: var(--dg-muted);
    font-family: var(--font-body);
  }

  .seams-diagram__card {
    fill: var(--dg-surface-2);
    stroke: var(--dg-rule);
    stroke-width: 1;
  }

  .seams-diagram__card--seam {
    fill: var(--dg-surface);
    stroke: #0284c7;
    stroke-width: 1.5;
  }

  :global(:root[data-theme="dark"]) .seams-diagram__card--seam {
    stroke: #38bdf8;
  }

  .seams-diagram__card--fake {
    fill: var(--dg-surface);
    stroke: #10b981;
    stroke-width: 1.5;
  }

  :global(:root[data-theme="dark"]) .seams-diagram__card--fake {
    stroke: #34d399;
  }

  .seams-diagram__inner {
    fill: var(--dg-surface-2);
    stroke: var(--dg-rule);
    stroke-width: 1;
  }

  .seams-diagram__card-title {
    font-size: 13.5px;
    font-weight: 700;
    fill: var(--dg-ink);
    font-family: var(--font-body);
  }

  .seams-diagram__card-title--accent {
    fill: #0284c7;
  }

  :global(:root[data-theme="dark"]) .seams-diagram__card-title--accent {
    fill: #38bdf8;
  }

  .seams-diagram__card-title--success {
    fill: #059669;
  }

  :global(:root[data-theme="dark"]) .seams-diagram__card-title--success {
    fill: #34d399;
  }

  .seams-diagram__card-desc {
    font-size: 12px;
    fill: var(--dg-ink-2);
    font-family: var(--font-body);
  }

  .seams-diagram__card-muted {
    font-size: 11.5px;
    fill: var(--dg-muted);
    font-family: var(--font-body);
  }

  .seams-diagram__card-highlight {
    font-size: 12px;
    fill: #059669;
    font-weight: 600;
    font-family: var(--font-body);
  }

  :global(:root[data-theme="dark"]) .seams-diagram__card-highlight {
    fill: #34d399;
  }

  .seams-diagram__tag {
    font-size: 11px;
    fill: #0284c7;
    font-family: var(--font-mono);
  }

  :global(:root[data-theme="dark"]) .seams-diagram__tag {
    fill: #38bdf8;
  }

  .seams-diagram__code {
    font-size: 12px;
    font-family: var(--font-mono);
    fill: var(--dg-ink);
  }

  .seams-diagram__arrow {
    stroke: var(--dg-rule-strong);
    stroke-width: 2;
    fill: none;
  }

  #seams-arrow path {
