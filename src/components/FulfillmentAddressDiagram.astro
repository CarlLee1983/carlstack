    stroke: var(--dg-rule-strong);
  }
  .fulfillment-address-diagram__heading {
    font-size: 19px;
    font-weight: 800;
    fill: var(--dg-ink);
  }
  .fulfillment-address-diagram__lead {
    font-size: 14px;
    font-weight: 700;
    fill: var(--dg-ink);
  }
  .fulfillment-address-diagram__label {
    font-size: 18px;
    font-weight: 800;
    fill: var(--dg-ink);
  }
  .fulfillment-address-diagram__detail,
  .fulfillment-address-diagram__note {
    font-size: 14px;
    fill: var(--dg-ink-2);
  }
  .fulfillment-address-diagram__mobile {
    display: none;
    color: var(--dg-ink-2);
    overflow-wrap: anywhere;
  }
  .fulfillment-address-diagram__mobile-card {
    margin-block: var(--space-md);
