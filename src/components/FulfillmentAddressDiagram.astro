  }
  .fulfillment-address-diagram__mobile-card h3 {
    margin: 0 0 var(--space-xs);
    font-size: var(--text-base);
    color: var(--dg-ink);
  }
  .fulfillment-address-diagram__mobile-card p {
    margin: 0;
  }
  .fulfillment-address-diagram figcaption {
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--dg-ink-2);
  }
  @media (max-width: 48rem) {
    .fulfillment-address-diagram__desktop {
      display: none !important;
    }
    .fulfillment-address-diagram__mobile {
      display: block !important;
    }
  }
