    stroke: #238636;
  }

  .redp-diag__box--amber {
    fill: var(--dg-surface-2, #292316);
    stroke: #d29922;
  }

  .redp-diag__box--red {
    fill: var(--dg-surface-2, #2d1d24);
    stroke: #da3633;
  }

  .redp-diag__box--async {
