    margin: var(--space-xl) 0;
    font-family: var(--font-body);
  }
  .vp-origin-diagram__desktop {
    display: block;
    width: 100%;
    height: auto;
  }
  .vp-origin-diagram__mobile {
    display: none;
  }
  .vp-origin-diagram__card {
    fill: var(--dg-surface);
    stroke: var(--dg-rule);
    stroke-width: 1.5;
  }
  .vp-origin-diagram__step {
    fill: var(--dg-surface-2);
    stroke: var(--dg-rule-strong);
  }
  .vp-origin-diagram__title {
    fill: var(--dg-ink);
    font-size: 18px;
    font-weight: 800;
  }
  .vp-origin-diagram__detail {
    fill: var(--dg-ink-2);
    font-size: 13.5px;
  }
  .vp-origin-diagram__label {
    fill: var(--dg-ink);
    font-size: 14px;
    font-weight: 700;
  }
  .vp-origin-diagram__number {
    fill: var(--dg-muted);
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
  }
  .vp-origin-diagram__metric {
    fill: #0f766e;
    font-family: var(--font-mono);
    font-size: 24px;
    font-weight: 700;
  }
  .vp-origin-diagram__arrow {
    fill: none;
    stroke: var(--dg-rule-strong);
    stroke-width: 2;
  }
  .vp-origin-diagram__arrow-head {
    fill: var(--dg-rule-strong);
  }
  .vp-origin-diagram__intro,
  .vp-origin-diagram__note {
    color: var(--dg-ink-2);
    font-size: var(--text-sm);
    line-height: 1.65;
  }
  .vp-origin-diagram__list {
    display: grid;
    gap: var(--space-md);
    margin: var(--space-md) 0;
    padding: 0;
    list-style: none;
  }
  .vp-origin-diagram__mobile-card {
    padding: var(--space-md);
    background: var(--dg-surface);
    border: 1px solid var(--dg-rule);
    border-radius: 14px;
  }
  .vp-origin-diagram__mobile-card h3 {
    margin: 0 0 var(--space-sm);
