    font-size: var(--text-base);
    line-height: 1.5;
  }
  .vp-origin-diagram__mobile-card p {
    margin: var(--space-xs) 0 0;
    color: var(--dg-ink-2);
    font-size: var(--text-sm);
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  .vp-origin-diagram__mobile-card strong,
  .vp-origin-diagram__mobile-card .vp-origin-diagram__handoff {
    color: #0f766e;
    font-weight: 700;
  }
  .vp-origin-diagram figcaption {
    margin-top: var(--space-md);
    color: var(--dg-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }
  :global(:root[data-theme="dark"]) .vp-origin-diagram__metric {
    fill: #5eead4;
  }
  :global(:root[data-theme="dark"]) .vp-origin-diagram__mobile-card strong,
  :global(:root[data-theme="dark"])
    .vp-origin-diagram__mobile-card
    .vp-origin-diagram__handoff {
