    fill: #94a3b8;
  }

  .meta-diagram__title {
    font-size: 15px;
    font-weight: 700;
    fill: #0f172a;
  }

  :global(:root[data-theme="dark"]) .meta-diagram__title {
    fill: #f8fafc;
  }

  .meta-diagram__subcard {
    stroke-width: 1;
  }

  .meta-diagram__subcard--teal {
