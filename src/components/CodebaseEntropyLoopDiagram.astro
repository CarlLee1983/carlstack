---
// src/components/CodebaseEntropyLoopDiagram.astro
---

<div class="entropy-loop-diagram-wrapper my-8">
  <div class="desktop-diagram hidden md:block">
    <svg
      viewBox="0 0 880 440"
      class="w-full h-auto"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <pattern
          id="entropy-grid-pattern"
          width="20"
          height="20"
          patternUnits="userSpaceOnUse"
        >
          <circle
            cx="2"
            cy="2"
            r="1"
            fill="var(--dg-border, #334155)"
            opacity="0.4"></circle>
        </pattern>
        <linearGradient
          id="entropy-left-grad"
          x1="0%"
          y1="0%"
          x2="100%"
          y2="100%"
        >
          <stop offset="0%" stop-color="#ef4444" stop-opacity="0.12"></stop>
          <stop offset="100%" stop-color="#f97316" stop-opacity="0.04"></stop>
        </linearGradient>
        <linearGradient
          id="entropy-right-grad"
          x1="0%"
          y1="0%"
          x2="100%"
          y2="100%"
        >
          <stop
            offset="0%"
            stop-color="var(--dg-accent, #38bdf8)"
            stop-opacity="0.18"></stop>
          <stop offset="100%" stop-color="#8b5cf6" stop-opacity="0.08"></stop>
        </linearGradient>
        <marker
          id="arrow-entropy-del"
          viewBox="0 0 10 10"
          refX="6"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 8 5 L 0 9 z" fill="#f43f5e"></path>
        </marker>
        <marker
          id="arrow-entropy-deep"
          viewBox="0 0 10 10"
          refX="6"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 8 5 L 0 9 z" fill="#38bdf8"></path>
        </marker>
      </defs>

      <!-- Background Card -->
      <rect width="880" height="440" rx="12" fill="var(--dg-bg-card, #0f172a)"
      ></rect>
      <rect width="880" height="440" rx="12" fill="url(#entropy-grid-pattern)"
      ></rect>

      <!-- Left: The Entropy Trap (Shallow Modules & Big Ball of Mud) -->
      <g transform="translate(30, 24)">
        <rect
          width="380"
          height="392"
          rx="10"
          fill="url(#entropy-left-grad)"
          stroke="#ef4444"
          stroke-width="1.2"
          stroke-dasharray="4 4"></rect>

        <rect
          x="20"
          y="20"
          width="160"
          height="26"
          rx="6"
          fill="#ef4444"
          opacity="0.2"></rect>
        <text x="30" y="38" fill="#f87171" font-size="12" font-weight="bold"
          >AI 時代的大泥球陷阱</text
        >
        <text x="20" y="70" fill="var(--dg-text-muted, #94a3b8)" font-size="12"
          >Vibe Coding 加速累積的淺層傳遞代碼</text
        >

        <!-- Shallow Pass-through Cluster -->
        <g transform="translate(20, 95)">
          <rect
            width="340"
            height="70"
            rx="8"
            fill="var(--dg-bg-muted, #1e293b)"
            stroke="#f87171"
            stroke-width="1"></rect>
          <text x="16" y="24" fill="#fca5a5" font-size="12" font-weight="bold"
            >淺層模組 (Shallow Pass-through)</text
          >
          <text
            x="16"
            y="44"
            fill="var(--dg-text-muted, #94a3b8)"
            font-size="11.5">只轉發參數的冗餘 Wrapper / Service</text
          >
          <text x="16" y="60" fill="#f87171" font-size="11"
            >表面積龐大，無封裝價值（Interface ≈ Body）</text
          >
        </g>

        <path
          d="M 190 165 L 190 185"
          stroke="#ef4444"
          stroke-width="1.5"
          stroke-dasharray="2 2"
          marker-end="url(#arrow-entropy-del)"></path>

        <g transform="translate(20, 190)">
          <rect
            width="340"
            height="65"
            rx="8"
            fill="var(--dg-bg-muted, #1e293b)"
            stroke="#ef4444"
            stroke-width="1"></rect>
          <text x="16" y="24" fill="#fca5a5" font-size="12" font-weight="bold"
            >刪除測試失敗 (Deletion Test Fails)</text
          >
          <text
            x="16"
            y="46"
            fill="var(--dg-text-muted, #94a3b8)"
            font-size="11.5">「刪除此模組，複雜度直接消失，呼叫端無痛」</text
          >
        </g>

        <path
          d="M 190 255 L 190 275"
          stroke="#ef4444"
          stroke-width="1.5"
          stroke-dasharray="2 2"
          marker-end="url(#arrow-entropy-del)"></path>

        <g transform="translate(20, 280)">
          <rect
            width="340"
            height="85"
            rx="8"
            fill="#450a0a"
            stroke="#ef4444"
            stroke-width="1.2"></rect>
          <text x="16" y="24" fill="#f87171" font-size="12.5" font-weight="bold"
            >熵增終局：認知超載</text
          >
          <text x="16" y="48" fill="#fecaca" font-size="11.5"
            >✕ 程式碼行數暴增 10 倍，實質功能零提升</text
          >
          <text x="16" y="68" fill="#fecaca" font-size="11.5"
            >✕ 下一個 Agent 迷失在空洞包裝中無從下手</text
          >
        </g>
      </g>

      <!-- Right: Architecture Entropy Reduction Loop -->
      <g transform="translate(470, 24)">
        <rect
          width="380"
          height="392"
          rx="10"
          fill="url(#entropy-right-grad)"
          stroke="var(--dg-accent, #38bdf8)"
          stroke-width="1.5"></rect>

        <rect
          x="20"
          y="20"
          width="180"
          height="26"
          rx="6"
          fill="var(--dg-accent, #38bdf8)"
          opacity="0.2"></rect>
        <text
          x="30"
          y="38"
          fill="var(--dg-accent, #38bdf8)"
          font-size="12"
          font-weight="bold">架構除熵迴圈 (Entropy Loop)</text
        >
        <text x="20" y="70" fill="var(--dg-text-muted, #94a3b8)" font-size="12"
          >架構師作為邊界審查者與模組加深引導</text
        >

        <!-- Step 1: Automated Deletion Test -->
        <g transform="translate(20, 95)">
          <rect
            width="340"
            height="65"
            rx="8"
            fill="var(--dg-bg-muted, #1e293b)"
            stroke="var(--dg-accent, #38bdf8)"
            stroke-width="1"></rect>
          <text x="16" y="24" fill="#7dd3fc" font-size="12" font-weight="bold"
            >1. 刪除測試審查 (The Deletion Test)</text
          >
          <text
            x="16"
            y="46"
            fill="var(--dg-text-muted, #94a3b8)"
            font-size="11.5">主動辨識零槓桿模組，無情拔除或合併</text
          >
        </g>

        <path
          d="M 190 160 L 190 180"
          stroke="var(--dg-accent, #38bdf8)"
          stroke-width="1.8"
          marker-end="url(#arrow-entropy-deep)"></path>

        <!-- Step 2: Deepening Workflow -->
        <g transform="translate(20, 185)">
          <rect
            width="340"
            height="85"
            rx="8"
            fill="var(--dg-bg-muted, #1e293b)"
            stroke="#8b5cf6"
            stroke-width="1"></rect>
          <text x="16" y="24" fill="#c4b5fd" font-size="12" font-weight="bold"
            >2. 模組加深工作流 (Deepening Loop)</text
          >
          <text
            x="16"
            y="46"
            fill="var(--dg-text-base, #e2e8f0)"
            font-size="11.5">• 簡化外層參數，隱藏內部私有狀態</text
          >
          <text
            x="16"
            y="66"
            fill="var(--dg-text-base, #e2e8f0)"
            font-size="11.5">• 單一深模組向 N 個呼叫端提供極高槓桿</text
          >
        </g>

        <path
          d="M 190 270 L 190 290"
          stroke="var(--dg-accent, #38bdf8)"
          stroke-width="1.8"
          marker-end="url(#arrow-entropy-deep)"></path>

        <!-- Step 3: Evergreen Codebase Core -->
        <g transform="translate(20, 295)">
          <rect
            width="340"
            height="70"
            rx="8"
            fill="#0f172a"
            stroke="#10b981"
            stroke-width="1.4"></rect>
          <text x="16" y="24" fill="#6ee7b7" font-size="12" font-weight="bold"
            >3. 恆常精準的代碼基底 (Evergreen Core)</text
          >
          <text x="16" y="46" fill="#ecfdf5" font-size="11.5"
            >✓ 小表面積、高內聚、隨時歡迎下一個 Agent</text
          >
        </g>
      </g>
    </svg>
  </div>

  <!-- Mobile View -->
  <div class="mobile-diagram block md:hidden space-y-4">
    <div class="p-4 rounded-lg border border-red-500/30 bg-red-950/20">
      <div
        class="inline-block px-2 py-0.5 mb-2 text-xs font-bold text-red-400 bg-red-500/10 rounded"
      >
        大泥球陷阱
      </div>
      <p class="text-xs text-slate-400 mb-3">AI 產出大量空洞包裝與轉發層</p>
      <div class="space-y-1.5 text-xs text-slate-300">
        <div class="p-2 rounded bg-slate-900 border border-red-500/40">
          <strong class="text-red-300">淺層模組：</strong>包裝多但沒有實質邏輯
        </div>
        <div class="p-2 rounded bg-red-900/40 text-red-200">
          ✕ 刪除測試不過，專案因無效抽象而窒息
        </div>
      </div>
    </div>

    <div class="p-4 rounded-lg border border-sky-500/30 bg-sky-950/20">
      <div
        class="inline-block px-2 py-0.5 mb-2 text-xs font-bold text-sky-400 bg-sky-500/10 rounded"
      >
        架構除熵迴圈
      </div>
      <p class="text-xs text-slate-400 mb-3">定期修剪與加深模組</p>
      <div class="space-y-1.5 text-xs text-slate-300">
        <div class="p-2 rounded bg-slate-900 border border-sky-500/40">
          <strong class="text-sky-300">刪除測試：</strong>砍掉無意義 Wrapper
        </div>
        <div class="p-2 rounded bg-slate-900 border border-purple-500/40">
          <strong class="text-purple-300">模組加深：</strong
          >收斂介面，隱藏複雜度
        </div>
        <div class="p-2 rounded bg-emerald-900/40 text-emerald-200">
          ✓ 高槓桿、小表面積，對抗代碼庫熵增
        </div>
      </div>
    </div>
  </div>
</div>
