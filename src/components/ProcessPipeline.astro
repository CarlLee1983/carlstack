---
interface Step {
  num: string;
  title: string;
  tag?: string;
  desc: string;
  gate?: string;
  details?: string[];
}

interface Props {
  title?: string;
  caption?: string;
  steps: Step[];
}

const { title, caption, steps } = Astro.props;
---

<div class="process-pipeline">
  {
    (title || caption) && (
      <div class="process-pipeline__header">
        {title && <h3 class="process-pipeline__title">{title}</h3>}
        {caption && <p class="process-pipeline__caption">{caption}</p>}
      </div>
    )
  }

  <ol class="process-pipeline__list">
    {
      steps.map((step, index) => (
        <li class="process-pipeline__item">
          <div class="process-pipeline__card">
            <div class="process-pipeline__top">
              <span class="process-pipeline__badge">{step.num}</span>
              {step.tag && (
                <span class="process-pipeline__tag">{step.tag}</span>
              )}
            </div>

            <h4 class="process-pipeline__step-title">{step.title}</h4>
            <p class="process-pipeline__step-desc">{step.desc}</p>

            {step.details && step.details.length > 0 && (
              <ul class="process-pipeline__details">
                {step.details.map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
            )}

            {step.gate && (
              <div class="process-pipeline__gate">
                <span class="process-pipeline__gate-label">Gate</span>
                <span class="process-pipeline__gate-text">{step.gate}</span>
              </div>
            )}
          </div>

          {index < steps.length - 1 && (
            <div class="process-pipeline__connector" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </div>
          )}
        </li>
      ))
    }
  </ol>
</div>

<style>
  .process-pipeline {
    margin-block: var(--space-xl);
    padding: var(--space-lg);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-paper-2);
  }

  .process-pipeline__header {
    margin-block-end: var(--space-lg);
    padding-block-end: var(--space-sm);
    border-block-end: var(--rule-hair) solid var(--color-rule);
  }

  .process-pipeline__title {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--color-ink);
  }

  .process-pipeline__caption {
    margin: var(--space-3xs) 0 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .process-pipeline__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13.5rem, 1fr));
    gap: var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .process-pipeline__item {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .process-pipeline__card {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-md);
    background: var(--color-paper);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-md);
    box-shadow: 0 1px 2px oklch(0% 0 0 / 0.04);
    transition:
      transform var(--dur-short) var(--ease-out),
      border-color var(--dur-short) var(--ease-out);
  }

  .process-pipeline__card:hover {
    border-color: var(--color-rule-2);
    transform: translateY(-2px);
  }

  .process-pipeline__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    margin-block-end: var(--space-sm);
  }

  .process-pipeline__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: 1;
    padding: var(--space-3xs) var(--space-xs);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border-radius: var(--radius-sm);
  }

  .process-pipeline__tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    background: var(--color-paper-2);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    border: var(--rule-hair) solid var(--color-rule);
    max-width: 9rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .process-pipeline__step-title {
    margin: 0 0 var(--space-2xs);
    font-size: var(--text-base);
    color: var(--color-ink);
    font-weight: 600;
  }

  .process-pipeline__step-desc {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    line-height: 1.55;
    flex-grow: 1;
  }

  .process-pipeline__details {
    margin: var(--space-sm) 0 0;
    padding-inline-start: var(--space-md);
    font-size: var(--text-xs);
    color: var(--color-muted);
    line-height: 1.5;
  }

  .process-pipeline__details li + li {
    margin-block-start: var(--space-3xs);
  }

  .process-pipeline__gate {
    margin-block-start: var(--space-sm);
    padding: var(--space-2xs) var(--space-xs);
    background: var(--color-paper-2);
    border-left: 2px solid var(--color-accent);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .process-pipeline__gate-label {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.65rem;
  }

  .process-pipeline__gate-text {
    color: var(--color-ink-2);
    line-height: 1.4;
  }

  .process-pipeline__connector {
    display: none;
  }

  @media (max-width: 48rem) {
    .process-pipeline {
      padding: var(--space-md);
    }

    .process-pipeline__list {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .process-pipeline__connector {
      display: flex;
      justify-content: center;
      padding-block: var(--space-2xs);
      color: var(--color-muted);
      transform: rotate(90deg);
    }
  }
</style>
