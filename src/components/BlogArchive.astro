---
import type { CollectionEntry } from "astro:content";
import ArticleCard from "./ArticleCard.astro";
import EmptyState from "./EmptyState.astro";
import Pagination from "./Pagination.astro";
import type { PaginationState } from "../utils/pagination";

interface Props {
  pagination: PaginationState<CollectionEntry<"blog">>;
  totalPosts: number;
}

const { pagination, totalPosts } = Astro.props;
---

<div class="page shell blog-page">
  <header class="page-header blog-header">
    <div class="eyebrow">
      <span class="eyebrow-dot" aria-hidden="true"></span>
      <span>Writing archive · {totalPosts}</span>
    </div>
    <div class="blog-header__copy">
      <h1>文章索引</h1>
      <p>記錄系統設計、AI Agent 工作流，以及實際專案裡值得保留的技術取捨。</p>
    </div>
    <a class="text-link" href="/tags/">
      <span>依主題瀏覽</span>
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </header>
  <!-- 無 JavaScript 也能用的 GET 搜尋入口；header 的 ⌘K 對話框需要 JS -->
  <div class="blog-toolbar">
    <p class="muted">
      共 {totalPosts} 篇 · 第 {pagination.current} / {pagination.total} 頁 · 最近更新優先
    </p>
    <form class="archive-search" action="/search/" method="get" role="search">
      <label class="visually-hidden" for="archive-query">搜尋文章</label>
      <svg
        class="archive-search__icon"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        id="archive-query"
        name="q"
        type="search"
        placeholder="在文章中搜尋"
        required
      />
      <button type="submit">搜尋</button>
    </form>
  </div>
  {
    pagination.items.length > 0 ? (
      <div class="blog-list">
        {pagination.items.map((post) => (
          <ArticleCard post={post} variant="row" />
        ))}
      </div>
    ) : (
      <EmptyState
        title="還沒有正式文章"
        description="新增 Markdown 或 MDX 檔並將 draft 設為 false 後，文章會自動出現在這裡、RSS、Sitemap 與搜尋索引。"
        href="/rss.xml"
        action="訂閱 RSS"
      />
    )
  }
  <Pagination pagination={pagination} />
</div>

<style>
  .blog-page {
    display: grid;
    gap: var(--space-xl);
  }

  .blog-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    max-width: none;
    align-items: end;
    gap: var(--space-lg);
    margin-block-end: 0;
    padding-block-end: var(--space-xl);
    border-block-end: var(--rule-hair) solid var(--color-rule);
  }

  .blog-header .eyebrow {
    grid-column: 1 / -1;
    margin: 0;
  }

  .blog-header__copy {
    display: grid;
    min-width: 0;
    gap: var(--space-xs);
  }

  .blog-header__copy h1 {
    font-size: clamp(2rem, 4.5vw, var(--text-3xl));
    font-weight: 700;
  }

  .blog-header__copy p {
    max-width: 48rem;
    color: var(--color-muted);
    font-size: var(--text-md);
  }

  .blog-list {
    display: grid;
    gap: 0;
  }

  /* 頁次資訊與搜尋同一列：左邊說明現在在哪，右邊是精簡的搜尋膠囊 */
  .blog-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md) var(--space-xl);
  }

  .blog-toolbar p {
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .archive-search {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    width: min(100%, 24rem);
    min-height: 2.75rem;
    padding: 0.25rem 0.25rem 0.25rem var(--space-md);
    border: var(--rule-hair) solid var(--color-rule-2);
    border-radius: var(--radius-pill);
    background: var(--color-card);
    transition:
      border-color var(--dur-micro) var(--ease-out),
      box-shadow var(--dur-micro) var(--ease-out);
  }

  .archive-search:focus-within {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-soft);
  }

  .archive-search__icon {
    flex-shrink: 0;
    color: var(--color-muted);
  }

  .archive-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-sm);
  }

  .archive-search button {
    flex-shrink: 0;
    min-height: 2.25rem;
    padding-inline: var(--space-md);
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-paper-2);
    color: var(--color-ink-2);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
    transition:
      background-color var(--dur-micro) var(--ease-out),
      color var(--dur-micro) var(--ease-out);
  }

  .archive-search button:hover,
  .archive-search button:focus-visible {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .blog-list > :last-child {
    border-block-end: var(--rule-hair) solid var(--color-rule);
  }

  @media (max-width: 40rem) {
    .blog-header {
      grid-template-columns: 1fr;
    }

    .blog-header .text-link {
      justify-self: start;
    }

    .blog-header__copy p {
      font-size: var(--text-base);
    }
  }
</style>
