---
import type { CollectionEntry } from "astro:content";
import ArticleCard from "./ArticleCard.astro";
import EmptyState from "./EmptyState.astro";
import Pagination from "./Pagination.astro";
import type { PaginationState } from "../utils/pagination";

interface Props {
  pagination: PaginationState<CollectionEntry<"blog">>;
  totalPosts: number;
}

const { pagination, totalPosts } = Astro.props;
---

<div class="page shell blog-page">
  <header class="page-header blog-header">
    <div class="hero-eyebrow">
      <span class="eyebrow-dot"></span>
      <span>Writing archive / {String(totalPosts).padStart(2, "0")}</span>
    </div>
    <div class="blog-header__copy">
      <h1>文章索引</h1>
      <p>記錄系統設計、AI Agent 工作流，以及實際專案裡值得保留的技術取捨。</p>
    </div>
    <a class="text-link" href="/tags/">
      <span>依主題瀏覽</span>
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </header>
  {
    pagination.items.length > 0 ? (
      <div class="blog-list">
        {pagination.items.map((post) => (
          <ArticleCard post={post} variant="row" />
        ))}
      </div>
    ) : (
      <EmptyState
        title="還沒有正式文章"
        description="新增 Markdown 或 MDX 檔並將 draft 設為 false 後，文章會自動出現在這裡、RSS、Sitemap 與搜尋索引。"
        href="/rss.xml"
        action="訂閱 RSS"
      />
    )
  }
  <Pagination pagination={pagination} />
</div>

<style>
  .blog-page {
    display: grid;
    gap: var(--space-2xl);
  }

  .blog-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    max-width: none;
    align-items: end;
    gap: var(--space-lg);
    margin-block-end: 0;
    padding-block-end: var(--space-xl);
    border-block-end: var(--rule-hair) solid var(--color-rule);
  }

  .blog-header .hero-eyebrow {
    grid-column: 1 / -1;
  }

  .blog-header__copy {
    display: grid;
    min-width: 0;
    gap: var(--space-xs);
  }

  .blog-header__copy h1 {
    font-size: clamp(2rem, 4.5vw, var(--text-3xl));
    font-weight: 700;
  }

  .blog-header__copy p {
    max-width: 48rem;
    color: var(--color-muted);
    font-size: var(--text-md);
  }

  .blog-list {
    display: grid;
    gap: 0;
  }

  .blog-list > :last-child {
    border-block-end: var(--rule-hair) solid var(--color-rule);
  }

  @media (max-width: 40rem) {
    .blog-header {
      grid-template-columns: 1fr;
    }

    .blog-header .text-link {
      justify-self: start;
    }
  }
</style>
