    background: #0b1120;
    border-color: #1e293b;
  }

  .http-evo-diagram__desktop {
    display: block;
    width: 100%;
    height: auto;
  }

  .http-evo-diagram__mobile {
    display: none;
  }

  /* SVG Styles */
  .http-evo-diagram__card rect {
    fill: var(--dg-surface);
    stroke: var(--dg-rule-strong);
    stroke-width: 1.5;
  }

