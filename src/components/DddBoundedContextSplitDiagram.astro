---
// src/components/DddBoundedContextSplitDiagram.astro
---

<figure class="ddd-bc-diagram" aria-labelledby="ddd-bc-diagram-caption">
  <!-- 桌面版 SVG (寬度 960，高度 600，大字級、高對比、Anti-Quadrant 橫幅+縱列結構) -->
  <svg
    class="ddd-bc-diagram__desktop"
    viewBox="0 0 960 600"
    role="img"
    aria-labelledby="ddd-bc-diagram-title ddd-bc-diagram-desc"
  >
    <title id="ddd-bc-diagram-title">
      限界上下文（Bounded Context）切割訊號與模型解構全景
    </title>
    <desc id="ddd-bc-diagram-desc">
      頂部為解構導覽與四大切割訊號維度。中間並列展現三大獨立限界上下文（帳號認證、帳務計費、倉儲履約），各自維護純淨的實體模型。底部為解耦關鍵技術：以無外鍵的強型別
      AccountId 取代物理外鍵硬關聯。
    </desc>

    <!-- 頂部：戰略維度導覽欄 (寬 900, 高 54, 字體 15px/13px) -->
    <g transform="translate(30, 20)">
      <rect width="900" height="54" rx="10" class="ddd-bc-diagram__banner-bg"
      ></rect>

      <circle cx="28" cy="27" r="7" fill="#3b82f6"></circle>
      <text x="46" y="33" class="ddd-bc-diagram__banner-title"
        >邊界切割 4 大訊號：</text
      >

      <text x="195" y="33" class="ddd-bc-diagram__banner-dim"
        >① 語義衝突 (Collision)</text
      >
      <text x="360" y="33" class="ddd-bc-diagram__banner-divider">|</text>
      <text x="375" y="33" class="ddd-bc-diagram__banner-dim"
        >② 變更步調 (Cadence)</text
      >
      <text x="525" y="33" class="ddd-bc-diagram__banner-divider">|</text>
      <text x="540" y="33" class="ddd-bc-diagram__banner-dim"
        >③ 團隊依賴 (Conway)</text
      >
      <text x="690" y="33" class="ddd-bc-diagram__banner-divider">|</text>
      <text x="705" y="33" class="ddd-bc-diagram__banner-dim"
        >④ 交易不變量 (Invariant)</text
      >
    </g>

    <!-- 主體三列：三大獨立上下文 (寬 286px, 高 350px) -->

    <!-- 1. 帳號與認證上下文 (Identity & Access) - 湛藍主題 -->
    <g
      transform="translate(30, 94)"
      class="ddd-bc-diagram__col ddd-bc-diagram__col--identity"
    >
      <rect
        width="286"
        height="350"
        rx="12"
        class="ddd-bc-diagram__main-card ddd-bc-diagram__main-card--identity"
      ></rect>
      <rect
        width="286"
        height="6"
        rx="3"
        class="ddd-bc-diagram__col-strip ddd-bc-diagram__col-strip--identity"
      ></rect>

      <!-- 卡片 Header -->
      <g transform="translate(18, 28)">
        <rect
          width="76"
          height="24"
          rx="5"
          class="ddd-bc-diagram__badge ddd-bc-diagram__badge--identity"></rect>
        <text
          x="38"
          y="16"
          text-anchor="middle"
          class="ddd-bc-diagram__badge-text ddd-bc-diagram__badge-text--identity"
          >認證子域</text
        >
        <text x="86" y="18" class="ddd-bc-diagram__col-title">Identity BC</text>
        <text x="0" y="42" class="ddd-bc-diagram__col-subtitle"
          >核心實體：Account</text
        >
      </g>

      <!-- 實體關注屬性清單 -->
      <g transform="translate(18, 92)">
        <rect width="250" height="164" rx="8" class="ddd-bc-diagram__prop-box"
        ></rect>
        <text x="12" y="24" class="ddd-bc-diagram__prop-header"
          >【邊界內純淨模型】</text
        >
        <text x="12" y="50" class="ddd-bc-diagram__prop-item"
          >• id: AccountId (UUID)</text
        >
        <text x="12" y="74" class="ddd-bc-diagram__prop-item"
          >• email: EmailAddress (VO)</text
        >
        <text x="12" y="98" class="ddd-bc-diagram__prop-item"
          >• passwordHash: string</text
        >
        <text x="12" y="122" class="ddd-bc-diagram__prop-item"
          >• mfaSecret / status: Enum</text
        >
        <text x="12" y="146" class="ddd-bc-diagram__prop-item"
          >• roles: Set&lt;Role&gt;</text
        >
      </g>

      <!-- 邊界特徵說明 -->
      <g transform="translate(18, 274)">
        <text x="0" y="16" class="ddd-bc-diagram__tag-label">語義核心：</text>
        <text x="75" y="16" class="ddd-bc-diagram__tag-val"
          >身分驗證與授權防護</text
        >
        <text x="0" y="40" class="ddd-bc-diagram__tag-label">變更特徵：</text>
        <text x="75" y="40" class="ddd-bc-diagram__tag-val"
          >低頻變更、高安全性要求</text
        >
        <text x="0" y="64" class="ddd-bc-diagram__tag-label">排除噪音：</text>
        <text x="75" y="64" class="ddd-bc-diagram__tag-val"
          >絕無發票統編、收件地址</text
        >
      </g>
    </g>

    <!-- 2. 帳務與計費上下文 (Billing & Invoicing) - 翠綠主題 -->
    <g
      transform="translate(337, 94)"
      class="ddd-bc-diagram__col ddd-bc-diagram__col--billing"
    >
      <rect
        width="286"
        height="350"
        rx="12"
        class="ddd-bc-diagram__main-card ddd-bc-diagram__main-card--billing"
      ></rect>
      <rect
        width="286"
        height="6"
        rx="3"
        class="ddd-bc-diagram__col-strip ddd-bc-diagram__col-strip--billing"
      ></rect>

      <!-- 卡片 Header -->
      <g transform="translate(18, 28)">
        <rect
          width="76"
          height="24"
          rx="5"
          class="ddd-bc-diagram__badge ddd-bc-diagram__badge--billing"></rect>
        <text
          x="38"
          y="16"
          text-anchor="middle"
          class="ddd-bc-diagram__badge-text ddd-bc-diagram__badge-text--billing"
          >支付財務</text
        >
        <text x="86" y="18" class="ddd-bc-diagram__col-title">Billing BC</text>
        <text x="0" y="42" class="ddd-bc-diagram__col-subtitle"
          >核心實體：Customer</text
        >
      </g>

      <!-- 實體關注屬性清單 -->
      <g transform="translate(18, 92)">
        <rect width="250" height="164" rx="8" class="ddd-bc-diagram__prop-box"
        ></rect>
        <text x="12" y="24" class="ddd-bc-diagram__prop-header"
          >【邊界內純淨模型】</text
        >
        <text x="12" y="50" class="ddd-bc-diagram__prop-item"
          >• id: CustomerId (UUID)</text
        >
        <text x="12" y="74" class="ddd-bc-diagram__prop-item"
          >• accountId: AccountId (參照)</text
        >
        <text x="12" y="98" class="ddd-bc-diagram__prop-item"
          >• taxId: TaxIdentifier (統編)</text
        >
        <text x="12" y="122" class="ddd-bc-diagram__prop-item"
          >• paymentMethods: Card[]</text
        >
        <text x="12" y="146" class="ddd-bc-diagram__prop-item"
          >• invoiceAddress: Address</text
        >
      </g>

      <!-- 邊界特徵說明 -->
      <g transform="translate(18, 274)">
        <text x="0" y="16" class="ddd-bc-diagram__tag-label">語義核心：</text>
        <text x="75" y="16" class="ddd-bc-diagram__tag-val"
          >付款憑證、發票與帳目</text
        >
        <text x="0" y="40" class="ddd-bc-diagram__tag-label">變更特徵：</text>
        <text x="75" y="40" class="ddd-bc-diagram__tag-val"
          >稅務法規驅動、強審計追蹤</text
        >
        <text x="0" y="64" class="ddd-bc-diagram__tag-label">排除噪音：</text>
        <text x="75" y="64" class="ddd-bc-diagram__tag-val"
          >絕無密碼雜湊、宅配備註</text
        >
      </g>
    </g>

    <!-- 3. 物流與履約上下文 (Fulfillment & Logistics) - 暖琥珀主題 -->
    <g
      transform="translate(644, 94)"
      class="ddd-bc-diagram__col ddd-bc-diagram__col--fulfillment"
    >
      <rect
        width="286"
        height="350"
        rx="12"
        class="ddd-bc-diagram__main-card ddd-bc-diagram__main-card--fulfillment"
      ></rect>
      <rect
        width="286"
        height="6"
        rx="3"
        class="ddd-bc-diagram__col-strip ddd-bc-diagram__col-strip--fulfillment"
      ></rect>

      <!-- 卡片 Header -->
      <g transform="translate(18, 28)">
        <rect
          width="76"
          height="24"
          rx="5"
          class="ddd-bc-diagram__badge ddd-bc-diagram__badge--fulfillment"
        ></rect>
        <text
          x="38"
          y="16"
          text-anchor="middle"
          class="ddd-bc-diagram__badge-text ddd-bc-diagram__badge-text--fulfillment"
          >倉儲配送</text
        >
        <text x="86" y="18" class="ddd-bc-diagram__col-title"
          >Fulfillment BC</text
        >
        <text x="0" y="42" class="ddd-bc-diagram__col-subtitle"
          >核心實體：Recipient</text
        >
      </g>

      <!-- 實體關注屬性清單 -->
      <g transform="translate(18, 92)">
        <rect width="250" height="164" rx="8" class="ddd-bc-diagram__prop-box"
        ></rect>
        <text x="12" y="24" class="ddd-bc-diagram__prop-header"
          >【邊界內純淨模型】</text
        >
        <text x="12" y="50" class="ddd-bc-diagram__prop-item"
          >• id: RecipientId (UUID)</text
        >
        <text x="12" y="74" class="ddd-bc-diagram__prop-item"
          >• accountId: AccountId (參照)</text
        >
        <text x="12" y="98" class="ddd-bc-diagram__prop-item"
          >• contactPhone: PhoneNumber</text
        >
        <text x="12" y="122" class="ddd-bc-diagram__prop-item"
          >• deliveryAddress: Address</text
        >
        <text x="12" y="146" class="ddd-bc-diagram__prop-item"
          >• deliveryNotes / gateCode</text
        >
      </g>

      <!-- 邊界特徵說明 -->
      <g transform="translate(18, 274)">
        <text x="0" y="16" class="ddd-bc-diagram__tag-label">語義核心：</text>
        <text x="75" y="16" class="ddd-bc-diagram__tag-val"
          >實體交付、司機與包裹動線</text
        >
        <text x="0" y="40" class="ddd-bc-diagram__tag-label">變更特徵：</text>
        <text x="75" y="40" class="ddd-bc-diagram__tag-val"
          >配送渠道多樣、變動極高頻</text
        >
        <text x="0" y="64" class="ddd-bc-diagram__tag-label">排除噪音：</text>
        <text x="75" y="64" class="ddd-bc-diagram__tag-val"
          >絕無支付金鑰、登入 Token</text
        >
      </g>
    </g>

    <!-- 底部：跨上下文解耦機制通欄 (寬 900, 高 116) -->
    <g transform="translate(30, 462)">
      <rect width="900" height="116" rx="10" class="ddd-bc-diagram__footer-card"
      ></rect>
      <rect width="6" height="116" rx="3" class="ddd-bc-diagram__footer-strip"
      ></rect>

      <g transform="translate(24, 22)">
        <!-- 警示/原則 Header -->
        <circle cx="8" cy="8" r="8" fill="#10b981"></circle>
        <text x="24" y="13" class="ddd-bc-diagram__footer-title"
          >【實踐架構準則】消除跨庫外鍵約束，以「純 ID 參照（Identity
          Reference）」維持完全解耦</text
        >

        <!-- 說明文字 -->
        <text x="0" y="42" class="ddd-bc-diagram__footer-desc">
          • <tspan class="ddd-bc-diagram__highlight-bad"
            >嚴禁跨上下文物理 Foreign Key (FK) 關聯：</tspan
          > 阻止資料庫層面產生跨模組幽靈鎖定、級聯更新與無休止的跨表 JOIN 泥潭。
        </text>
        <text x="0" y="68" class="ddd-bc-diagram__footer-desc">
          • <tspan class="ddd-bc-diagram__highlight-good"
            >採用強型別 ID 值物件（AccountId / CustomerId）：</tspan
          > 各上下文透過非同步領域事件（Domain Events）或公開 API 溝通，保證各模組具備獨立演進與部署自由度。
        </text>
      </g>
    </g>
  </svg>

  <!-- 行動版 SVG (縱向單列流式堆疊，寬度 360，高度 1020) -->
  <svg
    class="ddd-bc-diagram__mobile"
    viewBox="0 0 360 1020"
    role="img"
    aria-hidden="true"
  >
    <!-- 頂部：邊界 4 大訊號 -->
    <g transform="translate(16, 16)">
      <rect width="328" height="88" rx="8" class="ddd-bc-diagram__banner-bg"
      ></rect>
      <circle cx="20" cy="24" r="6" fill="#3b82f6"></circle>
      <text x="34" y="28" class="ddd-bc-diagram__m-title"
        >限界上下文 4 大切割訊號</text
      >
      <text x="20" y="52" class="ddd-bc-diagram__m-desc"
        >① 語義衝突 (Collision) ② 變更步調 (Cadence)</text
      >
      <text x="20" y="74" class="ddd-bc-diagram__m-desc"
        >③ 團隊依賴 (Conway) ④ 交易不變量 (Invariant)</text
      >
    </g>

    <!-- 卡片 1：Identity BC -->
    <g transform="translate(16, 116)" class="ddd-bc-diagram__col--identity">
      <rect
        width="328"
        height="236"
        rx="10"
        class="ddd-bc-diagram__main-card ddd-bc-diagram__main-card--identity"
      ></rect>
      <rect
