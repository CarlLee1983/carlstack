      ></rect>
      <rect
        width="328"
        height="5"
        rx="2"
        class="ddd-bc-diagram__col-strip ddd-bc-diagram__col-strip--billing"
      ></rect>
      <text x="16" y="32" class="ddd-bc-diagram__m-card-title"
        >2. 帳務與計費 (Billing BC)</text
      >
      <text x="16" y="54" class="ddd-bc-diagram__m-card-sub"
        >核心實體：Customer</text
      >
      <rect
        x="16"
        y="66"
        width="296"
        height="96"
        rx="6"
        class="ddd-bc-diagram__prop-box"></rect>
      <text x="26" y="88" class="ddd-bc-diagram__m-prop"
        >• id: CustomerId (UUID)</text
      >
      <text x="26" y="110" class="ddd-bc-diagram__m-prop"
        >• accountId: AccountId (純 ID 參照)</text
      >
      <text x="26" y="132" class="ddd-bc-diagram__m-prop"
