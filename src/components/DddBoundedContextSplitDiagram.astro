        >邊界防守：不關心登入密碼、不關心送貨司機</text
      >
    </g>

    <!-- 卡片 3：Fulfillment BC -->
    <g transform="translate(16, 612)" class="ddd-bc-diagram__col--fulfillment">
      <rect
        width="328"
        height="236"
        rx="10"
        class="ddd-bc-diagram__main-card ddd-bc-diagram__main-card--fulfillment"
      ></rect>
      <rect
        width="328"
