<script>
  import { initialStep, play } from "../utils/lab/index.ts";
  import type { OriginCostState } from "../utils/lab/index.ts";
  import {
    along,
    segmentPath,
    staggered,
    type Vec,
  } from "../utils/lab-geometry.ts";
  import {
    mountLabFigure,
    placeBead,
    setFlag,
    setLevel,
  } from "../utils/lab-player.ts";

  // 由 build script 依等角投影算好的常數：世界座標每單位在 viewBox 中的位移、錨點與脈衝路線。
  const GEO: {
    VX: Vec;
    VY: Vec;
    VZ: Vec;
    METER_C: Vec;
    METER_R: number;
    HANDLES: Record<"bypass" | "backfill", Vec>;
    HANDLE_L: number;
    NEEDLE_SWEEP: [number, number];
    GLASS_H: Record<"load" | "shield" | "tower", number>;
    LOAD_MAX: number;
    METER_MAX_GBPS: number;
    ROUTES: {
      tower: Vec[][];
      merge: Vec[];
      supply: Vec[];
      feed: Vec[][];
      backfill: Vec[];
    };
  } = {
    VX: [1.539, 0.481],
    VY: [-0.962, 0.769],
    VZ: [0, -1.571],
    METER_C: [209.4, 109.4],
    METER_R: 3.5,
    HANDLES: { bypass: [237.5, 132.4], backfill: [341.3, 117.8] },
    HANDLE_L: 8,
    NEEDLE_SWEEP: [-2.356194490192345, 4.71238898038469],
    GLASS_H: { load: 22, shield: 16, tower: 16 },
    LOAD_MAX: 2,
    METER_MAX_GBPS: 7,
    ROUTES: {
      tower: [
        [
          [195, 102.4],
          [201.1, 104.3],
          [179, 122],
          [274.4, 151.8],
          [296.5, 134.1],
          [358.1, 153.3],
          [324.4, 180.3],
          [324.4, 152],
        ],
        [
          [195, 102.4],
          [201.1, 104.3],
          [179, 122],
          [274.4, 151.8],
          [296.5, 134.1],
          [425.8, 174.5],
          [392.1, 201.4],
          [392.1, 173.1],
        ],
        [
          [195, 102.4],
          [201.1, 104.3],
          [179, 122],
          [274.4, 151.8],
          [296.5, 134.1],
          [493.5, 195.7],
          [459.8, 222.6],
          [459.8, 194.3],
        ],
      ],
      supply: [
        [195, 102.4],
        [201.1, 104.3],
        [179, 122],
        [274.4, 151.8],
        [296.5, 134.1],
        [493.5, 195.7],
      ],
      merge: [
        [195, 102.4],
        [238.1, 115.8],
      ],
      feed: [
        [
          [281.1, 129.3],
          [358.1, 153.3],
          [324.4, 180.3],
          [324.4, 152],
        ],
        [
          [281.1, 129.3],
          [425.8, 174.5],
          [392.1, 201.4],
          [392.1, 173.1],
        ],
        [
          [281.1, 129.3],
          [493.5, 195.7],
          [459.8, 222.6],
          [459.8, 194.3],
        ],
      ],
      backfill: [
        [215.2, 86.2],
        [439.8, 156.4],
      ],
    },
  };

  const MECHANISM = "origin-cost";
  const TOWER_IDS = [0, 1, 2] as const;
  const KEYS = [
    "level0",
    "level1",
    "level2",
    "shield",
    "load",
    "meter",
    "bypass",
    "backfill",
    "tower0",
    "tower1",
    "tower2",
    "merge",
    "supply",
    "feed",
    "backfillFlow",
  ] as const;
  type CostMotion = Record<(typeof KEYS)[number], number>;
  const OPEN = 0;
  const CLOSED = Math.PI / 2;

  /** 由一步的 state 算出各連續量的目標值；脈衝目標固定為 1，出發點由 render 決定。 */
  function targetsOf(state: OriginCostState): CostMotion {
    const level = (i: number) => state.edges[i]?.level ?? 0;
    return {
      level0: level(0),
      level1: level(1),
      level2: level(2),
      shield: state.shield.enabled ? state.shield.level : 0,
      load: Math.min(state.originLoad, GEO.LOAD_MAX) / GEO.LOAD_MAX,
      meter: Math.min(1, state.originGbps / GEO.METER_MAX_GBPS),
      bypass: state.shield.enabled ? CLOSED : OPEN,
      backfill: state.deferred === "running" ? OPEN : CLOSED,
      tower0: 1,
      tower1: 1,
      tower2: 1,
      merge: 1,
      supply: 1,
      feed: 1,
      backfillFlow: 1,
    };
  }

  function query(root: HTMLElement) {
    const svg = root.querySelector<SVGSVGElement>("svg");
    if (!svg) throw new Error("水塔圖缺少 SVG");
    const one = <T extends Element>(selector: string) => {
      const found = svg.querySelector<T>(selector);
      if (!found) throw new Error(`水塔圖缺少零件：${selector}`);
      return found;
    };
    const lamp = (name: string) => one<SVGGElement>(`[data-lamp="${name}"]`);
    const liquid = (name: string) =>
      one<SVGGElement>(`[data-glass="${name}"] .voc-liquid`);
    const beads = (name: string) =>
      Array.from(
        one<SVGGElement>(
          `.voc-beads[data-route="${name}"]`,
        ).querySelectorAll<SVGCircleElement>("circle"),
      );
    const handle = (name: string) =>
      svg.querySelectorAll<SVGPathElement>(`[data-handle="${name}"]`);
    return {
      lamps: {
        miss: TOWER_IDS.map((i) => lamp(`miss-${i}`)),
        shield: lamp("shield"),
        collapse: lamp("collapse"),
        shed: lamp("shed"),
        overload: lamp("overload"),
      },
      liquids: {
        towers: TOWER_IDS.map((i) => liquid(`tower-${i}`)),
        shield: liquid("shield"),
        load: liquid("load"),
      },
      loadGlass: one<SVGGElement>('[data-glass="load"]'),
      needle: one<SVGPathElement>(".voc-needle"),
      handles: { bypass: handle("bypass"), backfill: handle("backfill") },
      beads: {
        towers: TOWER_IDS.map((i) => beads(`tower-${i}`)),
        feed: TOWER_IDS.map((i) => beads(`feed-${i}`)),
        merge: beads("merge"),
        supply: beads("supply"),
        backfill: beads("backfill"),
      },
    };
  }

  function mount(root: HTMLElement) {
    const parts = query(root);
    // 這一步有哪些水塔在向上游抓（shield 啟用時改由蓄水池送出）。
    let feeding: boolean[] = [false, false, false];

    function draw(at: CostMotion) {
      const levels = [at.level0, at.level1, at.level2];
      parts.liquids.towers.forEach((liquid, i) =>
        setLevel(liquid, levels[i] ?? 0, GEO.VZ, GEO.GLASS_H.tower),
      );
      setLevel(parts.liquids.shield, at.shield, GEO.VZ, GEO.GLASS_H.shield);
      setLevel(parts.liquids.load, at.load, GEO.VZ, GEO.GLASS_H.load);

      const theta = GEO.NEEDLE_SWEEP[0] + GEO.NEEDLE_SWEEP[1] * at.meter;
      const dial = (r: number) =>
        along(
          GEO.METER_C,
          GEO.VX,
          GEO.VY,
          Math.sin(theta) * r,
          -Math.cos(theta) * r,
        );
      parts.needle.setAttribute(
        "d",
        segmentPath(dial(-1.4), dial(GEO.METER_R)),
      );

      for (const name of ["bypass", "backfill"] as const) {
        const angle = name === "bypass" ? at.bypass : at.backfill;
        const centre = GEO.HANDLES[name];
        const tip = along(
          centre,
          GEO.VX,
          GEO.VY,
          Math.cos(angle) * GEO.HANDLE_L,
          Math.sin(angle) * GEO.HANDLE_L,
        );
        parts.handles[name].forEach((path) =>
          path.setAttribute("d", segmentPath(centre, tip)),
        );
      }

      const towerFlow = [at.tower0, at.tower1, at.tower2];
      const string = (
        beads: SVGCircleElement[],
        points: readonly Vec[],
        t: number,
      ) =>
        beads.forEach((bead, index) =>
          placeBead(bead, points, staggered(t, index)),
        );
      parts.beads.towers.forEach((beads, i) =>
        string(beads, GEO.ROUTES.tower[i] ?? [], towerFlow[i] ?? 1),
      );
      string(parts.beads.merge, GEO.ROUTES.merge, at.merge);
      string(parts.beads.supply, GEO.ROUTES.supply, at.supply);
      parts.beads.feed.forEach((beads, i) =>
        string(beads, GEO.ROUTES.feed[i] ?? [], feeding[i] ? at.feed : 1),
      );
      string(parts.beads.backfill, GEO.ROUTES.backfill, at.backfillFlow);
    }

    function renderFlags(state: OriginCostState) {
      state.edges.forEach((edge, i) => {
        const lamp = parts.lamps.miss[i];
        if (lamp) lamp.dataset.state = edge.missing ? "on" : "off";
      });
      parts.lamps.shield.dataset.state = state.shield.enabled ? "green" : "off";
      parts.lamps.collapse.dataset.state = state.collapse ? "green" : "off";
      parts.lamps.shed.dataset.state =
        state.deferred === "running" ? "on" : "off";
      parts.lamps.overload.dataset.state = state.originLoad > 1 ? "red" : "off";
      setFlag(parts.loadGlass, "data-over", state.originLoad > 1);
    }

    mountLabFigure(
      root,
      {
        initial: () => initialStep(MECHANISM),
        play: (id) => play(MECHANISM, id),
      },
      {
        targets: (step) => targetsOf(step.state),
        draw: (current) => draw(current as CostMotion),
        render(step, _targets, ctx) {
          const { state } = step;
          const missing = state.edges.map((edge) => edge.missing);
          // originFetches 是同時打到 origin 的回源數：大於 1 時每座缺貨的塔各拉一串珠子；
          // 等於 1 時只有一串合併的回源（有 Shield 時進蓄水池，再由池子送往缺貨的塔）。
          feeding = [false, false, false];
          if (state.originFetches > 1) {
            missing.forEach((isMissing, i) => {
              if (isMissing) ctx.jump({ [`tower${i}`]: 0 });
            });
          } else if (state.shield.enabled) {
            feeding = missing;
            ctx.jump({ merge: 0, feed: 0 });
          } else {
            ctx.jump({ supply: 0 });
          }
          if (state.deferred === "running") ctx.jump({ backfillFlow: 0 });
          renderFlags(state);
        },
      },
    );
  }

  document
    .querySelectorAll<HTMLElement>('[data-lab-figure="origin-cost"]')
    .forEach(mount);
</script>

