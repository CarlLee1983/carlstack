---
// Password Hashing Security & Defense-in-Depth Pipeline Diagram
---

<figure class="pwdhash-diagram" aria-labelledby="pwdhash-caption">
  <!-- Desktop Layout -->
  <svg
    class="pwdhash-diagram__desktop"
    viewBox="0 0 960 450"
    role="img"
    aria-labelledby="pwdhash-title pwdhash-desc"
  >
    <title id="pwdhash-title">現代密碼安全儲存與縱深防禦管線</title>
    <desc id="pwdhash-desc">
      展示從客戶端傳入密碼開始，經過前置限流與長度驗證、KMS Pepper
      加密保護、Argon2id
      記憶體硬性雜湊計算，到最後雜湊值儲存於資料庫的完整縱深防禦架構。
    </desc>

    <defs>
      <marker
        id="pwdhash-arrow"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" class="pwdhash-diagram__arrow-head"
        ></path>
      </marker>
      <marker
        id="pwdhash-arrow-accent"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto"
      >
        <path
          d="M 0 0 L 10 5 L 0 10 z"
          class="pwdhash-diagram__arrow-head pwdhash-diagram__arrow-head--accent"
        ></path>
      </marker>
    </defs>

    <!-- Stage 1: Entrance Protection (Rate Limiting & Pre-validation) -->
    <g class="pwdhash-diagram__card" transform="translate(30, 40)">
      <rect width="200" height="360" rx="12"></rect>
      <text class="pwdhash-diagram__badge" x="16" y="28">STAGE 1: ENTRANCE</text
      >
      <text class="pwdhash-diagram__title" x="16" y="56"
        >前置流量與長度防禦</text
      >

      <g transform="translate(14, 76)">
        <rect
          width="172"
          height="74"
          rx="6"
          class="pwdhash-diagram__subcard pwdhash-diagram__subcard--orange"
        ></rect>
        <text
          class="pwdhash-diagram__header pwdhash-diagram__header--orange"
          x="10"
          y="22">限流（Rate Limiter）</text
        >
        <text class="pwdhash-diagram__subdesc" x="10" y="42"
          >• IP / 帳號維度限制</text
        >
        <text class="pwdhash-diagram__subdesc" x="10" y="60"
          >• Redis Token Bucket</text
        >
      </g>

      <g transform="translate(14, 164)">
        <rect
          width="172"
          height="74"
          rx="6"
          class="pwdhash-diagram__subcard pwdhash-diagram__subcard--orange"
        ></rect>
        <text
          class="pwdhash-diagram__header pwdhash-diagram__header--orange"
          x="10"
          y="22">密碼長度校驗</text
        >
        <text class="pwdhash-diagram__subdesc" x="10" y="42"
          >• 限制最大 128 位元組</text
        >
        <text class="pwdhash-diagram__subdesc" x="10" y="60"
          >• 防止運算耗盡阻斷</text
        >
      </g>

      <g transform="translate(14, 252)">
        <rect width="172" height="74" rx="6" class="pwdhash-diagram__subcard"
        ></rect>
        <text class="pwdhash-diagram__header" x="10" y="22">阻斷攻擊成效</text>
        <text class="pwdhash-diagram__subdesc" x="10" y="42"
          >• 攔截惡意撞庫請求</text
        >
        <text class="pwdhash-diagram__subdesc" x="10" y="60"
          >• 保護後端計算資源</text
        >
      </g>
    </g>

    <!-- Arrow 1 to 2 -->
    <path
      class="pwdhash-diagram__arrow"
      d="M 230 220 H 265"
      marker-end="url(#pwdhash-arrow)"></path>

    <!-- Stage 2: Secret Layer (Pepper & KMS / HSM) -->
    <g class="pwdhash-diagram__card" transform="translate(270, 40)">
      <rect width="200" height="360" rx="12"></rect>
      <text
        class="pwdhash-diagram__badge pwdhash-diagram__badge--accent"
        x="16"
        y="28">STAGE 2: PEPPER</text
      >
      <text
        class="pwdhash-diagram__title pwdhash-diagram__title--accent"
        x="16"
        y="56">金鑰防護（Pepper）</text
      >

      <g transform="translate(14, 76)">
        <rect
          width="172"
          height="74"
          rx="6"
          class="pwdhash-diagram__subcard pwdhash-diagram__subcard--accent"
        ></rect>
        <text
          class="pwdhash-diagram__header pwdhash-diagram__header--accent"
          x="10"
          y="22">KMS / HSM 託管</text
        >
        <text class="pwdhash-diagram__subdesc" x="10" y="42"
          >• 金鑰隔離於 DB 之外</text
        >
        <text class="pwdhash-diagram__subdesc" x="10" y="60"
          >• 支援雲端 HSM 輪換</text
        >
      </g>

      <g transform="translate(14, 164)">
        <rect
          width="172"
          height="74"
          rx="6"
          class="pwdhash-diagram__subcard pwdhash-diagram__subcard--accent"
        ></rect>
        <text
          class="pwdhash-diagram__header pwdhash-diagram__header--accent"
          x="10"
          y="22">HMAC 前後運算</text
        >
        <text class="pwdhash-diagram__subdesc" x="10" y="42"
          >• HMAC-SHA256 綁定</text
        >
        <text class="pwdhash-diagram__subdesc" x="10" y="60"
          >• 引入全域高熵金鑰</text
        >
      </g>

      <g transform="translate(14, 252)">
        <rect width="172" height="74" rx="6" class="pwdhash-diagram__subcard"
        ></rect>
        <text class="pwdhash-diagram__header" x="10" y="22">縱深防禦效益</text>
        <text class="pwdhash-diagram__subdesc" x="10" y="42"
          >• 即使資料庫整庫外洩</text
        >
        <text class="pwdhash-diagram__subdesc" x="10" y="60"
          >• 無 Pepper 亦無法破解</text
        >
      </g>
    </g>

    <!-- Arrow 2 to 3 -->
    <path
      class="pwdhash-diagram__arrow"
      d="M 470 220 H 505"
      marker-end="url(#pwdhash-arrow)"></path>

    <!-- Stage 3: Hashing Computation (Argon2id Worker Pool) -->
    <g class="pwdhash-diagram__card" transform="translate(510, 40)">
      <rect width="200" height="360" rx="12"></rect>
      <text
        class="pwdhash-diagram__badge pwdhash-diagram__badge--green"
        x="16"
        y="28">STAGE 3: WORKER</text
      >
      <text
        class="pwdhash-diagram__title pwdhash-diagram__title--green"
        x="16"
        y="56">慢速雜湊執行緒池</text
      >

      <g transform="translate(14, 76)">
        <rect
          width="172"
          height="74"
          rx="6"
          class="pwdhash-diagram__subcard pwdhash-diagram__subcard--green"
        ></rect>
        <text
          class="pwdhash-diagram__header pwdhash-diagram__header--green"
          x="10"
          y="22">Worker Pool 隔離</text
        >
        <text class="pwdhash-diagram__subdesc" x="10" y="42"
          >• 脫離主伺服器事件圈</text
        >
        <text class="pwdhash-diagram__subdesc" x="10" y="60"
          >• 防止 Event Loop 飢餓</text
        >
      </g>

      <g transform="translate(14, 164)">
        <rect
          width="172"
          height="74"
          rx="6"
          class="pwdhash-diagram__subcard pwdhash-diagram__subcard--green"
        ></rect>
        <text
          class="pwdhash-diagram__header pwdhash-diagram__header--green"
          x="10"
          y="22">Argon2id 計算</text
        >
        <text class="pwdhash-diagram__subdesc" x="10" y="42"
          >• 64 MB 記憶體硬性</text
        >
        <text class="pwdhash-diagram__subdesc" x="10" y="60"
          >• 隨機 Salt 防彩虹表</text
        >
      </g>

      <g transform="translate(14, 252)">
        <rect width="172" height="74" rx="6" class="pwdhash-diagram__subcard"
        ></rect>
        <text class="pwdhash-diagram__header" x="10" y="22">防禦特性</text>
        <text class="pwdhash-diagram__subdesc" x="10" y="42"
          >• 抑制 GPU / ASIC 平行化</text
        >
        <text class="pwdhash-diagram__subdesc" x="10" y="60"
          >• 抗時序側信道攻擊</text
        >
      </g>
    </g>

    <!-- Arrow 3 to 4 -->
    <path
      class="pwdhash-diagram__arrow"
      d="M 710 220 H 745"
      marker-end="url(#pwdhash-arrow)"></path>

    <!-- Stage 4: Storage & Migration (Database & Rehash) -->
    <g class="pwdhash-diagram__card" transform="translate(750, 40)">
      <rect width="180" height="360" rx="12"></rect>
      <text class="pwdhash-diagram__badge" x="14" y="28">STAGE 4: STORAGE</text>
      <text class="pwdhash-diagram__title" x="14" y="56">安全儲存與遷移</text>

      <g transform="translate(12, 76)">
        <rect width="156" height="74" rx="6" class="pwdhash-diagram__subcard"
        ></rect>
        <text class="pwdhash-diagram__header" x="10" y="22">雜湊字串持久化</text
        >
        <text class="pwdhash-diagram__subdesc" x="10" y="42"
          >• $argon2id$v=19$...</text
        >
        <text class="pwdhash-diagram__subdesc" x="10" y="60"
          >• 自帶演算法參數與鹽</text
        >
      </g>

      <g transform="translate(12, 164)">
        <rect
          width="156"
          height="74"
          rx="6"
          class="pwdhash-diagram__subcard pwdhash-diagram__subcard--blue"
        ></rect>
        <text
          class="pwdhash-diagram__header pwdhash-diagram__header--blue"
          x="10"
          y="22">無痛平滑遷移</text
        >
        <text class="pwdhash-diagram__subdesc" x="10" y="42"
          >• needsRehash 檢查</text
        >
        <text class="pwdhash-diagram__subdesc" x="10" y="60"
          >• 登入時無感升級參數</text
        >
      </g>

      <g transform="translate(12, 252)">
        <rect width="156" height="74" rx="6" class="pwdhash-diagram__subcard"
        ></rect>
        <text class="pwdhash-diagram__header" x="10" y="22">歷史演算法相容</text
        >
        <text class="pwdhash-diagram__subdesc" x="10" y="42"
          >• Bcrypt / SHA 舊密碼</text
        >
        <text class="pwdhash-diagram__subdesc" x="10" y="60"
          >• 漸進式替換為 Argon2id</text
        >
      </g>
    </g>
  </svg>

  <!-- Mobile Layout (Vertical Card Stack for <= 320px screen readability) -->
  <div class="pwdhash-diagram__mobile">
    <div class="pwdhash-mobile-card">
      <span class="pwdhash-mobile-badge">01. 入口保護</span>
      <h4>前置限流與長度驗證</h4>
      <p>
        透過 Redis Token Bucket
        在入口層限制嘗試次數，並在應用層強制校驗密碼長度上限（如 128
        位元組），直接抵擋惡意爆發並消除計算資源枯竭風險。
      </p>
    </div>

    <div class="pwdhash-mobile-arrow">↓ 傳入金鑰防護層</div>

    <div class="pwdhash-mobile-card pwdhash-mobile-card--accent">
      <span class="pwdhash-mobile-badge pwdhash-mobile-badge--accent"
        >02. 縱深防禦</span
      >
      <h4>Pepper 與 KMS / HSM 金鑰託管</h4>
      <p>
        將獨立高熵金鑰（Pepper）託管於 AWS KMS 或 Vault，透過 HMAC
        與密碼結合。即使資料庫遭到 SQL 注入整庫外洩，攻擊者在無 Pepper
        下完全無法啟動離線暴力破解。
      </p>
    </div>

    <div class="pwdhash-mobile-arrow">↓ 執行緒池計算</div>

    <div class="pwdhash-mobile-card pwdhash-mobile-card--green">
      <span class="pwdhash-mobile-badge pwdhash-mobile-badge--green"
        >03. 慢速雜湊</span
      >
      <h4>Worker Pool 隔離與 Argon2id 計算</h4>
      <p>
        將高耗能雜湊計算移至獨立背景執行緒池（Worker
        Thread），避免阻塞主伺服器事件循環；配置 64 MB 記憶體硬性，瓦解 GPU
        與專用 ASIC 的平行運算優勢。
      </p>
    </div>

    <div class="pwdhash-mobile-arrow">↓ 寫入儲存與升級</div>

    <div class="pwdhash-mobile-card">
      <span class="pwdhash-mobile-badge">04. 安全儲存</span>
      <h4>標準格式持久化與無痛平滑遷移</h4>
      <p>
        將內嵌演算法識別碼、鹽與參數的標準雜湊字串寫入資料庫；配合 needsRehash
        檢查，在使用者每次成功登入時無感升級舊演算法與安全工作因子。
      </p>
    </div>
  </div>

  <figcaption id="pwdhash-caption">
    圖 1：現代密碼儲存的四層縱深防禦體系：前置限流與長度防禦、KMS Pepper
    隔離、Worker 執行緒池慢速雜湊，以及資料庫持久化與平滑遷移。
  </figcaption>
</figure>

<style>
  .pwdhash-diagram {
    margin: 2.5rem 0;
    width: 100%;
  }

  .pwdhash-diagram__desktop {
    display: block;
    width: 100%;
    height: auto;
  }

  .pwdhash-diagram__mobile {
    display: none;
  }

  figcaption {
    margin-top: 1rem;
    font-size: var(--text-sm);
    color: var(--dg-muted);
    text-align: center;
    line-height: 1.5;
  }

  /* SVG Base Styles */
  .pwdhash-diagram__card > rect {
    fill: var(--dg-surface);
    stroke: var(--dg-rule);
    stroke-width: 1.5;
  }

  .pwdhash-diagram__badge {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    fill: var(--dg-muted);
    font-family: var(--font-mono);
  }

  .pwdhash-diagram__badge--accent {
    fill: #b45309;
  }
  :global(:root[data-theme="dark"]) .pwdhash-diagram__badge--accent {
    fill: #f59e0b;
  }

  .pwdhash-diagram__badge--green {
    fill: #15803d;
  }
  :global(:root[data-theme="dark"]) .pwdhash-diagram__badge--green {
    fill: #4ade80;
  }

  .pwdhash-diagram__title {
    font-size: 15px;
    font-weight: 700;
    fill: var(--dg-ink);
    font-family: var(--font-display);
  }

  .pwdhash-diagram__title--accent {
    fill: #b45309;
  }
  :global(:root[data-theme="dark"]) .pwdhash-diagram__title--accent {
    fill: #f59e0b;
  }

  .pwdhash-diagram__title--green {
    fill: #15803d;
  }
  :global(:root[data-theme="dark"]) .pwdhash-diagram__title--green {
    fill: #4ade80;
  }

  .pwdhash-diagram__subcard {
    fill: var(--dg-surface-2);
    stroke: var(--dg-rule);
    stroke-width: 1;
  }

  .pwdhash-diagram__subcard--orange {
    fill: rgba(234, 88, 12, 0.05);
    stroke: rgba(234, 88, 12, 0.25);
  }
  :global(:root[data-theme="dark"]) .pwdhash-diagram__subcard--orange {
    fill: rgba(251, 146, 60, 0.1);
    stroke: rgba(251, 146, 60, 0.3);
  }

  .pwdhash-diagram__subcard--accent {
    fill: rgba(180, 83, 9, 0.05);
    stroke: rgba(180, 83, 9, 0.25);
  }
  :global(:root[data-theme="dark"]) .pwdhash-diagram__subcard--accent {
    fill: rgba(245, 158, 11, 0.1);
    stroke: rgba(245, 158, 11, 0.3);
  }

  .pwdhash-diagram__subcard--green {
    fill: rgba(21, 128, 61, 0.05);
    stroke: rgba(21, 128, 61, 0.25);
  }
  :global(:root[data-theme="dark"]) .pwdhash-diagram__subcard--green {
    fill: rgba(74, 222, 128, 0.1);
    stroke: rgba(74, 222, 128, 0.3);
  }

  .pwdhash-diagram__subcard--blue {
    fill: rgba(2, 132, 199, 0.05);
    stroke: rgba(2, 132, 199, 0.25);
  }
  :global(:root[data-theme="dark"]) .pwdhash-diagram__subcard--blue {
    fill: rgba(56, 189, 248, 0.1);
    stroke: rgba(56, 189, 248, 0.3);
  }

  .pwdhash-diagram__header {
    font-size: 12px;
    font-weight: 700;
    fill: var(--dg-ink);
    font-family: var(--font-body);
  }

  .pwdhash-diagram__header--orange {
    fill: #c2410c;
  }
  :global(:root[data-theme="dark"]) .pwdhash-diagram__header--orange {
    fill: #fb923c;
  }

  .pwdhash-diagram__header--accent {
    fill: #b45309;
  }
  :global(:root[data-theme="dark"]) .pwdhash-diagram__header--accent {
    fill: #f59e0b;
  }

  .pwdhash-diagram__header--green {
    fill: #15803d;
  }
  :global(:root[data-theme="dark"]) .pwdhash-diagram__header--green {
    fill: #4ade80;
  }

  .pwdhash-diagram__header--blue {
    fill: #0284c7;
  }
  :global(:root[data-theme="dark"]) .pwdhash-diagram__header--blue {
    fill: #38bdf8;
  }

  .pwdhash-diagram__subdesc {
    font-size: 11px;
    fill: var(--dg-ink-2);
    font-family: var(--font-body);
  }

  .pwdhash-diagram__arrow {
    stroke: var(--dg-rule-strong);
    stroke-width: 2;
    fill: none;
  }

  .pwdhash-diagram__arrow-head {
    fill: var(--dg-rule-strong);
  }

  .pwdhash-diagram__arrow-head--accent {
    fill: #b45309;
  }
  :global(:root[data-theme="dark"]) .pwdhash-diagram__arrow-head--accent {
    fill: #f59e0b;
  }

  /* Mobile Styles */
  @media (max-width: 48rem) {
    .pwdhash-diagram__desktop {
      display: none;
    }

    .pwdhash-diagram__mobile {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      max-width: 320px;
      margin: 0 auto;
    }

    .pwdhash-mobile-card {
      background: var(--dg-surface);
      border: 1px solid var(--dg-rule);
      border-radius: var(--radius-sm);
      padding: 0.875rem;
      box-shadow: var(--shadow-sm);
    }

    .pwdhash-mobile-card--accent {
      border-left: 4px solid #b45309;
      background: rgba(180, 83, 9, 0.04);
    }
    :global(:root[data-theme="dark"]) .pwdhash-mobile-card--accent {
      border-color: #f59e0b;
      background: rgba(245, 158, 11, 0.08);
    }

    .pwdhash-mobile-card--green {
      border-left: 4px solid #15803d;
      background: rgba(21, 128, 61, 0.04);
    }
    :global(:root[data-theme="dark"]) .pwdhash-mobile-card--green {
      border-color: #4ade80;
      background: rgba(74, 222, 128, 0.08);
    }

    .pwdhash-mobile-badge {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--dg-muted);
      display: block;
      margin-bottom: 0.25rem;
      font-family: var(--font-mono);
    }

    .pwdhash-mobile-badge--accent {
      color: #b45309;
    }
    :global(:root[data-theme="dark"]) .pwdhash-mobile-badge--accent {
      color: #f59e0b;
    }

    .pwdhash-mobile-badge--green {
      color: #15803d;
    }
    :global(:root[data-theme="dark"]) .pwdhash-mobile-badge--green {
      color: #4ade80;
    }

    .pwdhash-mobile-card h4 {
      margin: 0 0 0.25rem 0;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--dg-ink);
    }

    .pwdhash-mobile-card p {
      margin: 0;
      font-size: 0.8125rem;
      color: var(--dg-ink-2);
      line-height: 1.45;
    }

    .pwdhash-mobile-arrow {
      text-align: center;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--dg-muted);
      padding: 0.125rem 0;
    }
  }
</style>
