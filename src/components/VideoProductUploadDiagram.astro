    font-size: var(--text-sm);
    line-height: 1.7;
  }
  .vpu-diagram figcaption {
    margin-top: var(--space-md);
    color: var(--dg-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
  }
  :global(:root[data-theme="dark"]) .vpu-diagram__commit {
    fill: #17342f;
    stroke: #5eead4;
  }
  :global(:root[data-theme="dark"]) .vpu-diagram__arrow--accent {
    stroke: #5eead4;
  }
  :global(:root[data-theme="dark"])
    .vpu-diagram__steps
    .vpu-diagram__step--commit {
