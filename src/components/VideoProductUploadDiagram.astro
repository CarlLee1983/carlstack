    height: auto;
  }
  .vpu-diagram__mobile {
    display: none;
  }
  .vpu-diagram__card {
    fill: var(--dg-surface);
    stroke: var(--dg-rule);
    stroke-width: 1.5;
  }
  .vpu-diagram__commit {
    fill: #edf8f5;
    stroke: #0f766e;
    stroke-width: 1.5;
  }
  .vpu-diagram__title {
    fill: var(--dg-ink);
    font-size: 18px;
    font-weight: 800;
  }
  .vpu-diagram__lead {
    fill: var(--dg-ink);
    font-size: 14px;
    font-weight: 700;
  }
  .vpu-diagram__label {
    fill: var(--dg-ink);
    font-size: 14px;
    font-weight: 700;
  }
  .vpu-diagram__detail {
    fill: var(--dg-ink-2);
    font-size: 13px;
  }
  .vpu-diagram__lifeline {
    fill: none;
    stroke: var(--dg-rule);
    stroke-width: 1.5;
    stroke-dasharray: 4 6;
  }
  .vpu-diagram__arrow {
    fill: none;
    stroke: var(--dg-rule-strong);
    stroke-width: 2;
    marker-end: url(#vpu-arrow);
  }
  .vpu-diagram__arrowhead {
    fill: var(--dg-rule-strong);
  }
  .vpu-diagram__arrow--accent {
    stroke: #0f766e;
    stroke-width: 3;
  }
  .vpu-diagram__arrow--return {
    stroke-dasharray: 6 5;
  }
  .vpu-diagram__mobile-lead {
    margin: 0 0 var(--space-md);
    color: var(--dg-ink);
    font-weight: 800;
  }
  .vpu-diagram__steps {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: vpu-step;
  }
  .vpu-diagram__steps li {
    counter-increment: vpu-step;
    padding: var(--space-md);
    border: 1px solid var(--dg-rule);
