---
// src/components/DddEventStormingDiagram.astro
---

<figure
  class="ddd-storming-diagram"
  aria-labelledby="ddd-storming-diagram-caption"
>
  <!-- 桌面版 SVG (寬度 960，高度 600，大字級、高對比、清爽透氣、Anti-Quadrant) -->
  <svg
    class="ddd-storming-diagram__desktop"
    viewBox="0 0 960 600"
    role="img"
    aria-labelledby="ddd-storming-diagram-title ddd-storming-diagram-desc"
  >
    <title id="ddd-storming-diagram-title">
      Big Picture EventStorming 全景事件風暴與上下文邊界識別全景
    </title>
    <desc id="ddd-storming-diagram-desc">
      頂部展示事件風暴色彩語言與時間軸流動方向。主體四欄展示全景風暴推進三階段與上下文邊界切分：混沌發散領域事件、結構化時間軸與觸發源、衝突熱點收斂、邊界接縫自然浮現。底部展示系統分析師控場原則與常見反模式警示。
    </desc>

    <!-- 頂部：便籤語義導覽列 (高 52px) -->
    <g transform="translate(30, 20)">
      <rect
        width="900"
        height="52"
        rx="10"
        class="ddd-storming-diagram__banner-bg"></rect>
      <text x="24" y="32" class="ddd-storming-diagram__banner-title"
        >事件風暴色彩語言：</text
      >

      <!-- 橘色：Domain Event -->
      <rect x="180" y="16" width="22" height="20" rx="3" fill="#f97316"></rect>
      <text x="208" y="31" class="ddd-storming-diagram__legend-text"
        >領域事件（過去式）</text
      >

      <!-- 藍色：Command -->
      <rect x="365" y="16" width="22" height="20" rx="3" fill="#3b82f6"></rect>
      <text x="393" y="31" class="ddd-storming-diagram__legend-text"
        >操作指令（動詞）</text
      >

      <!-- 紫色：Policy -->
      <rect x="535" y="16" width="22" height="20" rx="3" fill="#a855f7"></rect>
      <text x="563" y="31" class="ddd-storming-diagram__legend-text"
        >業務策略（Whenever）</text
      >

      <!-- 紅色：Hotspot -->
      <rect x="735" y="16" width="22" height="20" rx="3" fill="#ef4444"></rect>
      <text x="763" y="31" class="ddd-storming-diagram__legend-text"
        >衝突熱點（爭議點）</text
      >
    </g>

    <!-- 主體四欄：工作坊推進四步 (每欄寬 213px，間距 16px，高 355px) -->

    <!-- 1. 第一步：混沌發散 (Chaotic Exploration) -->
    <g transform="translate(30, 92)" class="ddd-storming-diagram__col">
      <rect
        width="213"
        height="355"
        rx="10"
        class="ddd-storming-diagram__main-card"></rect>
      <rect
        width="213"
        height="6"
        rx="3"
        class="ddd-storming-diagram__col-strip ddd-storming-diagram__col-strip--orange"
      ></rect>

      <!-- Header -->
      <g transform="translate(16, 24)">
        <text
          class="ddd-storming-diagram__phase-tag ddd-storming-diagram__phase-tag--orange"
          >STEP 1 · 混沌發散</text
        >
        <text y="25" class="ddd-storming-diagram__col-title">全景領域事件</text>
        <text y="46" class="ddd-storming-diagram__col-subtitle"
          >業務事實 · 徹底打破沉默</text
        >
      </g>

      <line
        x1="16"
        y1="84"
        x2="197"
        y2="84"
        class="ddd-storming-diagram__divider"></line>

      <!-- Meta 區塊 -->
      <g transform="translate(16, 98)">
        <rect
          width="181"
          height="68"
          rx="6"
          class="ddd-storming-diagram__meta-box"></rect>
        <text x="12" y="22" class="ddd-storming-diagram__meta-label"
          >核心便籤類型</text
        >
        <text
          x="12"
          y="42"
          class="ddd-storming-diagram__meta-val ddd-storming-diagram__meta-val--orange"
          >橘色便籤（Domain Event）</text
        >
        <text x="12" y="58" class="ddd-storming-diagram__meta-sub"
          >必須使用業務過去式動態</text
        >
      </g>

      <!-- 戰略要點 -->
      <g transform="translate(16, 180)">
        <text class="ddd-storming-diagram__section-label">工作坊推進要點</text>
        <text y="20" class="ddd-storming-diagram__bullet"
          >• 邀請所有跨職能關係人到場</text
        >
        <text y="40" class="ddd-storming-diagram__bullet"
          >• 嚴禁技術人員討論資料表與 API</text
        >
        <text y="60" class="ddd-storming-diagram__bullet"
          >• 貼滿「OrderPlaced、Paid」</text
        >
        <text y="80" class="ddd-storming-diagram__bullet"
          >• 允許重複與亂序，重在廣度</text
        >
      </g>

      <!-- 處置底標 -->
      <g transform="translate(16, 290)">
        <rect
          width="181"
          height="48"
          rx="6"
          class="ddd-storming-diagram__action-box"></rect>
        <text x="12" y="20" class="ddd-storming-diagram__action-title"
          >分析師職責</text
        >
        <text x="12" y="38" class="ddd-storming-diagram__action-desc"
          >激發表達 · 杜絕批判審查</text
        >
      </g>
    </g>

    <!-- 2. 第二步：時間軸與觸發源 (Timeline & Triggers) -->
    <g transform="translate(259, 92)" class="ddd-storming-diagram__col">
      <rect
        width="213"
        height="355"
        rx="10"
        class="ddd-storming-diagram__main-card"></rect>
      <rect
        width="213"
        height="6"
        rx="3"
        class="ddd-storming-diagram__col-strip ddd-storming-diagram__col-strip--blue"
      ></rect>

      <!-- Header -->
      <g transform="translate(16, 24)">
        <text
          class="ddd-storming-diagram__phase-tag ddd-storming-diagram__phase-tag--blue"
          >STEP 2 · 時序結構</text
        >
        <text y="25" class="ddd-storming-diagram__col-title"
          >時間軸與觸發源</text
        >
        <text y="46" class="ddd-storming-diagram__col-subtitle"
          >左到右時序 · 溯源因果鏈</text
        >
      </g>

      <line
        x1="16"
        y1="84"
        x2="197"
        y2="84"
        class="ddd-storming-diagram__divider"></line>

      <!-- Meta 區塊 -->
      <g transform="translate(16, 98)">
        <rect
          width="181"
          height="68"
          rx="6"
          class="ddd-storming-diagram__meta-box"></rect>
        <text x="12" y="22" class="ddd-storming-diagram__meta-label"
          >核心便籤類型</text
        >
        <text
          x="12"
          y="42"
          class="ddd-storming-diagram__meta-val ddd-storming-diagram__meta-val--blue"
          >藍色 Command + 紫色 Policy</text
        >
        <text x="12" y="58" class="ddd-storming-diagram__meta-sub"
          >人/系統觸發與業務策略規則</text
        >
      </g>

      <!-- 戰略要點 -->
      <g transform="translate(16, 180)">
        <text class="ddd-storming-diagram__section-label">工作坊推進要點</text>
        <text y="20" class="ddd-storming-diagram__bullet"
          >• 事件依業務時間自左向右排列</text
        >
        <text y="40" class="ddd-storming-diagram__bullet"
          >• 追問：「是什麼引發了此事件？」</text
        >
        <text y="60" class="ddd-storming-diagram__bullet"
          >• 識別「每當 X 發生時，執行 Y」</text
        >
        <text y="80" class="ddd-storming-diagram__bullet"
          >• 補齊讀取模型與決策上下文</text
        >
      </g>

      <!-- 處置底標 -->
      <g transform="translate(16, 290)">
        <rect
          width="181"
          height="48"
          rx="6"
          class="ddd-storming-diagram__action-box"></rect>
        <text x="12" y="20" class="ddd-storming-diagram__action-title"
          >分析師職責</text
        >
        <text x="12" y="38" class="ddd-storming-diagram__action-desc"
          >理清因果 · 梳理業務時序</text
        >
      </g>
    </g>

    <!-- 3. 第三步：熱點衝突收斂 (Hotspots & Friction) -->
    <g transform="translate(488, 92)" class="ddd-storming-diagram__col">
      <rect
        width="213"
        height="355"
        rx="10"
        class="ddd-storming-diagram__main-card"></rect>
      <rect
        width="213"
        height="6"
        rx="3"
        class="ddd-storming-diagram__col-strip ddd-storming-diagram__col-strip--red"
      ></rect>

      <!-- Header -->
      <g transform="translate(16, 24)">
        <text
          class="ddd-storming-diagram__phase-tag ddd-storming-diagram__phase-tag--red"
          >STEP 3 · 爭議捕捉</text
        >
        <text y="25" class="ddd-storming-diagram__col-title">捕捉衝突熱點</text>
        <text y="46" class="ddd-storming-diagram__col-subtitle"
          >紅色便籤 · 暴露真實分歧</text
        >
      </g>

      <line
        x1="16"
        y1="84"
        x2="197"
        y2="84"
        class="ddd-storming-diagram__divider"></line>

      <!-- Meta 區塊 -->
      <g transform="translate(16, 98)">
        <rect
          width="181"
          height="68"
          rx="6"
          class="ddd-storming-diagram__meta-box ddd-storming-diagram__meta-box--red"
        ></rect>
        <text x="12" y="22" class="ddd-storming-diagram__meta-label"
          >核心便籤類型</text
        >
        <text
          x="12"
          y="42"
          class="ddd-storming-diagram__meta-val ddd-storming-diagram__meta-val--red"
          >紅色便籤（Hotspot / Issue）</text
        >
        <text x="12" y="58" class="ddd-storming-diagram__meta-sub"
          >語義矛盾、責任真空與法規風險</text
        >
      </g>

      <!-- 戰略要點 -->
      <g transform="translate(16, 180)">
        <text class="ddd-storming-diagram__section-label">工作坊推進要點</text>
        <text y="20" class="ddd-storming-diagram__bullet"
          >• 只要有爭執，立刻貼上紅便籤</text
        >
        <text y="40" class="ddd-storming-diagram__bullet"
          >• 拒絕在白板前現場無休止爭吵</text
        >
        <text y="60" class="ddd-storming-diagram__bullet"
          >• 標記「誰負責退款審核賠償？」</text
        >
        <text y="80" class="ddd-storming-diagram__bullet"
          >• 衝突點往往預示核心語義邊界</text
        >
      </g>

      <!-- 處置底標 -->
      <g transform="translate(16, 290)">
        <rect
          width="181"
          height="48"
          rx="6"
          class="ddd-storming-diagram__action-box"></rect>
        <text x="12" y="20" class="ddd-storming-diagram__action-title"
          >分析師職責</text
        >
        <text x="12" y="38" class="ddd-storming-diagram__action-desc"
          >凍結爭吵 · 記錄分歧熱點</text
        >
      </g>
    </g>

    <!-- 4. 第四步：邊界自然浮現 (Bounded Contexts) -->
    <g transform="translate(717, 92)" class="ddd-storming-diagram__col">
      <rect
        width="213"
        height="355"
        rx="10"
        class="ddd-storming-diagram__main-card ddd-storming-diagram__main-card--gold"
      ></rect>
      <rect
        width="213"
        height="6"
        rx="3"
        class="ddd-storming-diagram__col-strip ddd-storming-diagram__col-strip--gold"
      ></rect>

      <!-- Header -->
      <g transform="translate(16, 24)">
        <text
          class="ddd-storming-diagram__phase-tag ddd-storming-diagram__phase-tag--gold"
          >STEP 4 · 架構收斂</text
        >
        <text
          y="25"
          class="ddd-storming-diagram__col-title ddd-storming-diagram__col-title--gold"
          >識別上下文邊界</text
        >
        <text y="46" class="ddd-storming-diagram__col-subtitle"
          >語義圈地 · 確立系統邊界</text
        >
      </g>

      <line
        x1="16"
        y1="84"
        x2="197"
        y2="84"
        class="ddd-storming-diagram__divider"></line>

      <!-- Meta 區塊 -->
      <g transform="translate(16, 98)">
        <rect
          width="181"
          height="68"
          rx="6"
          class="ddd-storming-diagram__meta-box ddd-storming-diagram__meta-box--gold"
        ></rect>
        <text x="12" y="22" class="ddd-storming-diagram__meta-label"
          >架構交付物</text
        >
        <text
          x="12"
          y="42"
          class="ddd-storming-diagram__meta-val ddd-storming-diagram__meta-val--gold"
          >候選限界上下文清單</text
        >
        <text x="12" y="58" class="ddd-storming-diagram__meta-sub"
          >時間停頓、權責移轉處劃下接縫</text
        >
      </g>

      <!-- 戰略要點 -->
      <g transform="translate(16, 180)">
        <text class="ddd-storming-diagram__section-label">工作坊推進要點</text>
        <text y="20" class="ddd-storming-diagram__bullet"
          >• 尋找時序停頓（異步處理點）</text
        >
        <text y="40" class="ddd-storming-diagram__bullet"
          >• 捕捉角色與權責轉移樞紐</text
        >
        <text y="60" class="ddd-storming-diagram__bullet"
          >• 識別名詞含義的根本性轉變</text
        >
        <text y="80" class="ddd-storming-diagram__bullet"
          >• 用膠帶圈出 Bounded Context</text
        >
      </g>

      <!-- 處置底標 -->
      <g transform="translate(16, 290)">
        <rect
          width="181"
          height="48"
          rx="6"
          class="ddd-storming-diagram__action-box ddd-storming-diagram__action-box--gold"
        ></rect>
        <text
          x="12"
          y="20"
          class="ddd-storming-diagram__action-title ddd-storming-diagram__action-title--gold"
          >分析師職責</text
        >
        <text x="12" y="38" class="ddd-storming-diagram__action-desc"
          >確立邊界 · 輸出戰略架構</text
        >
      </g>
    </g>

    <!-- 底部：控場防線與反模式警示 (高 105px) -->
    <g transform="translate(30, 465)">
      <rect
        width="900"
        height="105"
        rx="10"
        class="ddd-storming-diagram__warning-bg"></rect>
      <rect
        width="900"
        height="5"
        rx="2"
        class="ddd-storming-diagram__warning-strip"></rect>

      <circle cx="36" cy="35" r="14" fill="#f59e0b" opacity="0.15"></circle>
      <text
        x="36"
        y="41"
        text-anchor="middle"
        font-size="16"
        font-weight="900"
        fill="#d97706">!</text
      >
      <text x="62" y="40" class="ddd-storming-diagram__warning-title"
        >系統分析師主導 EventStorming 的兩大防禦原則</text
      >

      <g transform="translate(62, 54)">
        <text class="ddd-storming-diagram__warning-bullet" x="0" y="16">
          <tspan font-weight="700">禁絕 CRUD 思維污染：</tspan> 嚴禁出現「CreateOrder、UpdateUser」等資料庫動作便籤；必須使用真實業務語義（如
          OrderPlaced、AccountLocked）。
        </text>
        <text class="ddd-storming-diagram__warning-bullet" x="0" y="36">
          <tspan font-weight="700">現場爭執即時凍結：</tspan> 當兩個部門對名詞定義爭辯超過
          2 分鐘，強制貼上紅便籤並立刻推進，將爭議轉為探索限界上下文的絕佳切縫。
        </text>
      </g>
    </g>
  </svg>

  <!-- 行動版 SVG (寬度 360，高度 1040，縱向堆疊卡片) -->
  <svg
    class="ddd-storming-diagram__mobile"
    viewBox="0 0 360 1040"
    role="img"
    aria-labelledby="ddd-storming-diagram-mobile-title ddd-storming-diagram-mobile-desc"
  >
    <title id="ddd-storming-diagram-mobile-title">
      Big Picture EventStorming 全景事件風暴工作流（行動版）
    </title>
    <desc id="ddd-storming-diagram-mobile-desc">
      全景事件風暴四步驟縱向卡片版：混沌發散領域事件、結構化時間軸、衝突熱點收斂、自然浮現上下文邊界。
    </desc>

    <!-- 頂部標題 (高 66px) -->
    <g transform="translate(16, 16)">
      <rect
        width="328"
        height="66"
        rx="8"
        class="ddd-storming-diagram__banner-bg"></rect>
      <text x="16" y="28" class="ddd-storming-diagram__mobile-title"
        >EventStorming 全景事件風暴</text
      >
      <text x="16" y="48" class="ddd-storming-diagram__mobile-subtitle"
        >從業務事實探索到限界上下文自然切分</text
      >
    </g>

    <!-- 1. 混沌發散 (高 205px) -->
    <g transform="translate(16, 96)">
      <rect
        width="328"
        height="205"
        rx="8"
        class="ddd-storming-diagram__main-card"></rect>
      <rect
        width="328"
        height="5"
        rx="2"
        class="ddd-storming-diagram__col-strip ddd-storming-diagram__col-strip--orange"
      ></rect>
      <text
        x="16"
        y="28"
        class="ddd-storming-diagram__phase-tag ddd-storming-diagram__phase-tag--orange"
        >STEP 1 · 混沌發散（打破沉默）</text
      >
      <text x="16" y="52" class="ddd-storming-diagram__col-title"
        >全景領域事件（Domain Events）</text
      >
      <text x="16" y="74" class="ddd-storming-diagram__mobile-domain"
        >便籤：橘色便籤 · 業務過去式</text
      >
      <text x="16" y="102" class="ddd-storming-diagram__mobile-text"
        >• 特徵：全員無邊界張貼業務事實，允許重複亂序</text
      >
      <text x="16" y="124" class="ddd-storming-diagram__mobile-text"
        >• 姿態：嚴禁工程師過早討論資料庫表結構與 API</text
      >
      <text x="16" y="146" class="ddd-storming-diagram__mobile-text"
        >• 典型：OrderPlaced, PaymentReceived, ParcelDispatched</text
      >
      <rect
        x="16"
        y="162"
        width="296"
        height="26"
        rx="4"
        class="ddd-storming-diagram__action-box"></rect>
      <text x="24" y="179" class="ddd-storming-diagram__mobile-action"
        >分析師姿態：鼓勵廣泛發散，不做價值評判</text
      >
    </g>

    <!-- 2. 時間軸與觸發源 (高 205px) -->
    <g transform="translate(16, 315)">
      <rect
        width="328"
        height="205"
        rx="8"
        class="ddd-storming-diagram__main-card"></rect>
      <rect
        width="328"
        height="5"
        rx="2"
        class="ddd-storming-diagram__col-strip ddd-storming-diagram__col-strip--blue"
      ></rect>
      <text
        x="16"
        y="28"
        class="ddd-storming-diagram__phase-tag ddd-storming-diagram__phase-tag--blue"
        >STEP 2 · 時序結構（因果鏈）</text
      >
      <text x="16" y="52" class="ddd-storming-diagram__col-title"
        >時間軸與觸發源（Timeline & Triggers）</text
      >
      <text x="16" y="74" class="ddd-storming-diagram__mobile-domain"
        >便籤：藍色 Command + 紫色 Policy</text
      >
      <text x="16" y="102" class="ddd-storming-diagram__mobile-text"
        >• 特徵：自左向右排列時序，追溯每項事件之觸發因</text
      >
      <text x="16" y="124" class="ddd-storming-diagram__mobile-text"
        >• 姿態：梳理「每當 A 發生時，執行策略 B」</text
      >
      <text x="16" y="146" class="ddd-storming-diagram__mobile-text"
        >• 典型：用戶點擊提交、定時任務觸發、自動風控驗證</text
      >
      <rect
        x="16"
        y="162"
        width="296"
        height="26"
        rx="4"
        class="ddd-storming-diagram__action-box"></rect>
      <text x="24" y="179" class="ddd-storming-diagram__mobile-action"
        >分析師姿態：溯源業務因果鏈，理清決策上下文</text
      >
    </g>

    <!-- 3. 捕捉衝突熱點 (高 205px) -->
    <g transform="translate(16, 534)">
      <rect
        width="328"
        height="205"
        rx="8"
        class="ddd-storming-diagram__main-card"></rect>
      <rect
        width="328"
