    border-radius: 16px;
  }

  :global(.dark) .twitter-pipe-diagram {
    background: #0b1120;
    border-color: #1e293b;
  }

  .twitter-pipe-diagram__desktop {
    display: block;
    width: 100%;
    height: auto;
  }

  .twitter-pipe-diagram__mobile {
    display: none;
  }

  /* SVG Styles */
  .twitter-pipe-diagram__card rect {
    fill: var(--color-bg-surface, #ffffff);
    stroke: var(--color-border, #cbd5e1);
    stroke-width: 1.5;
  }

  :global(.dark) .twitter-pipe-diagram__card rect {
    fill: #1e293b;
    stroke: #334155;
