    fill: #6d28d9;
  }

  :global(:root[data-theme="dark"]) .discord-diag__title--accent {
    fill: #ddd6fe;
  }

  .discord-diag__title--emerald {
    fill: #047857;
  }

  :global(:root[data-theme="dark"]) .discord-diag__title--emerald {
    fill: #a7f3d0;
  }

  .discord-diag__desc {
    font-size: 12px;
    fill: #475569;
  }

  :global(:root[data-theme="dark"]) .discord-diag__desc {
    fill: #9ca3af;
  }

  .discord-diag__subhead {
    font-size: 12px;
    font-weight: 700;
    fill: #1e293b;
  }

  :global(:root[data-theme="dark"]) .discord-diag__subhead {
    fill: #e5e7eb;
  }

  .discord-diag__subhead--focus {
    fill: #6d28d9;
  }

  :global(:root[data-theme="dark"]) .discord-diag__subhead--focus {
