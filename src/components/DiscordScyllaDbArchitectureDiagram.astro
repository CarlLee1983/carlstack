      border-color: #1f2937;
    }

    .discord-mobile-card--rust {
      background: #f5f3ff;
      border-color: #8b5cf6;
      border-left: 4px solid #7c3aed;
    }

    :global(:root[data-theme="dark"]) .discord-mobile-card--rust {
      background: #1e1b4b;
      border-color: #a78bfa;
    }

    .discord-mobile-card--scylla {
      border-left: 4px solid #10b981;
    }

    .discord-mobile-badge {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--dg-muted);
      display: block;
      margin-bottom: 0.25rem;
    }

    .discord-mobile-badge--accent {
      color: #7c3aed;
    }

    :global(:root[data-theme="dark"]) .discord-mobile-badge--accent {
      color: #c4b5fd;
    }

    .discord-mobile-badge--emerald {
      color: #059669;
    }

    :global(:root[data-theme="dark"]) .discord-mobile-badge--emerald {
      color: #34d399;
    }

    .discord-mobile-card h4 {
      margin: 0 0 0.25rem 0;
      font-size: 1rem;
      font-weight: 700;
      color: var(--dg-ink);
    }

    :global(:root[data-theme="dark"]) .discord-mobile-card h4 {
      color: #f9fafb;
    }

    .discord-mobile-card p {
      margin: 0;
      font-size: 0.8125rem;
      color: var(--dg-ink-2);
