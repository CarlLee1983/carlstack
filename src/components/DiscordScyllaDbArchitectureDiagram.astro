  }

  :global(:root[data-theme="dark"]) .discord-diag__arrow--emerald {
    stroke: #34d399;
  }

  .discord-diag__arrow-head--accent {
    fill: #8b5cf6;
  }

  :global(:root[data-theme="dark"]) .discord-diag__arrow-head--accent {
    fill: #a78bfa;
  }

  .discord-diag__arrow-head--emerald {
    fill: #10b981;
  }

  :global(:root[data-theme="dark"]) .discord-diag__arrow-head--emerald {
    fill: #34d399;
  }

  .discord-diag__wire-label {
    font-size: 11px;
