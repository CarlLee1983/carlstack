  }

  :global(:root[data-theme="dark"]) .discord-diag__wire-label--emerald {
    fill: #34d399;
  }

  figcaption {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--dg-muted);
    text-align: center;
  }

  /* Responsive for mobile */
  @media (max-width: 768px) {
    .discord-diag__desktop {
      display: none;
    }

    .discord-diag__mobile {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .discord-mobile-card {
      padding: 1rem;
      background: var(--dg-surface);
      border: 1px solid var(--dg-rule);
      border-radius: 10px;
    }

