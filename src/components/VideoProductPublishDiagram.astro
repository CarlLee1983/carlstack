    fill: var(--dg-ink);
    font-size: 18px;
    font-weight: 800;
  }
  .vpp-diagram__label {
    fill: var(--dg-ink);
    font-size: 14px;
    font-weight: 700;
  }
  .vpp-diagram__detail {
    fill: var(--dg-ink-2);
    font-size: 13px;
  }
  .vpp-diagram__path {
    fill: var(--dg-ink-2);
