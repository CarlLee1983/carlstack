    fill: none;
    stroke: var(--dg-rule-strong);
    stroke-width: 2;
    marker-end: url(#vpp-arrow);
  }
  .vpp-diagram__arrow--stale {
    stroke-dasharray: 6 5;
  }
  .vpp-diagram__arrowhead {
    fill: var(--dg-rule-strong);
  }
  .vpp-diagram__divider {
    stroke: var(--dg-rule-strong);
    stroke-width: 1;
  }
  .vpp-diagram__mobile-card {
    margin-bottom: var(--space-sm);
    padding: var(--space-md);
    border: 1px solid var(--dg-rule);
    border-radius: 12px;
    background: var(--dg-surface);
