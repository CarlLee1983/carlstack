---
// Component 1: Typeahead Top-K Trie Tree Internal Diagram (Redesigned for crystal-clear readability)
---

<figure class="trie-diagram" aria-labelledby="trie-caption">
  <svg
    class="trie-diagram__desktop"
    viewBox="0 0 960 620"
    role="img"
    aria-labelledby="trie-title trie-desc"
  >
    <title id="trie-title">
      搜尋自動補全核心：Top-K 字典樹（Trie）空間換時間預存架構
    </title>
    <desc id="trie-desc">
      展示 Top-K 字典樹結構：從 Root 根節點經由前綴字元 's' 與 'y' 尋址到 'sy'
      前綴節點。每個節點內部直接預存 Top 5 熱門搜尋詞與權重，杜絕子樹遍歷，達成
      O(p) 常數時間極速查詢。
    </desc>

    <defs>
      <marker
        id="trie-arrow-main"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="8"
        markerHeight="8"
        orient="auto"
      >
        <path d="M 0 1 L 9 5 L 0 9 z" class="trie-diagram__arrow-head"></path>
      </marker>
    </defs>

    <!-- Header Section -->
    <g transform="translate(48, 36)">
      <rect class="trie-diagram__badge-bg" width="180" height="28" rx="6"
      ></rect>
      <text class="trie-diagram__badge-text" x="90" y="18" text-anchor="middle">
        ALGORITHM KERNEL
      </text>
      <text class="trie-diagram__main-title" x="200" y="22">
        Top-K 字典樹（Trie）前綴預存與常數時間查詢
      </text>
      <text class="trie-diagram__main-sub" x="0" y="52">
        傳統 Trie 需遍歷所有子樹節點排序（耗時隨詞庫爆增）；Top-K Trie
        在每個前綴節點直接維護預計算的熱門列表。
      </text>
    </g>

    <!-- LEVEL 0: Root Node -->
    <g class="trie-diagram__row" transform="translate(48, 112)">
      <rect class="trie-diagram__row-bg" width="864" height="100" rx="10"
      ></rect>

      <!-- Left: Node Circle & Label -->
      <g transform="translate(24, 20)">
        <circle
          class="trie-diagram__circle trie-diagram__circle--root"
          cx="30"
          cy="30"
          r="30"></circle>
        <text class="trie-diagram__circle-text" x="30" y="36">Root</text>
        <text class="trie-diagram__node-name" x="78" y="26"
          >全域根節點（Root Node）</text
        >
        <text class="trie-diagram__node-desc" x="78" y="48"
          >空前綴 · 匯總全站最熱門 TOP 5 關鍵字</text
        >
      </g>

      <!-- Right: Precomputed Top-K Card -->
      <g transform="translate(420, 16)">
        <rect class="trie-diagram__list-card" width="420" height="68" rx="8"
        ></rect>
        <text class="trie-diagram__list-header" x="16" y="24"
          >全站熱門搜尋 Top 3 預存：</text
        >
        <g transform="translate(16, 34)">
          <rect
            class="trie-diagram__pill-kw"
            x="0"
            y="4"
            width="120"
            height="24"
            rx="4"></rect>
          <text
            class="trie-diagram__pill-kw-text"
            x="60"
            y="20"
            text-anchor="middle">youtube (98M)</text
          >

          <rect
            class="trie-diagram__pill-kw"
            x="128"
            y="4"
            width="116"
            height="24"
            rx="4"></rect>
          <text
            class="trie-diagram__pill-kw-text"
            x="186"
            y="20"
            text-anchor="middle">google (85M)</text
          >

          <rect
            class="trie-diagram__pill-kw"
            x="252"
            y="4"
            width="124"
            height="24"
            rx="4"></rect>
          <text
            class="trie-diagram__pill-kw-text"
            x="314"
            y="20"
            text-anchor="middle">amazon (72M)</text
          >
        </g>
      </g>
    </g>

    <!-- Connector 1 -->
    <g transform="translate(78, 212)">
      <path
        d="M 0 0 L 0 38"
        class="trie-diagram__branch-line"
        marker-end="url(#trie-arrow-main)"></path>
      <rect
        class="trie-diagram__edge-badge"
        x="16"
        y="8"
        width="96"
        height="24"
        rx="4"></rect>
      <text class="trie-diagram__edge-text" x="64" y="24" text-anchor="middle"
        >輸入字元 's'</text
      >
    </g>

    <!-- LEVEL 1: Node 's' -->
    <g class="trie-diagram__row" transform="translate(48, 252)">
      <rect class="trie-diagram__row-bg" width="864" height="110" rx="10"
      ></rect>

      <!-- Left: Node Circle & Label -->
      <g transform="translate(24, 25)">
        <circle
          class="trie-diagram__circle trie-diagram__circle--branch"
          cx="30"
          cy="30"
          r="30"></circle>
        <text
          class="trie-diagram__circle-text trie-diagram__circle-text--cyan"
          x="30"
          y="37">'s'</text
        >
        <text class="trie-diagram__node-name" x="78" y="26"
          >前綴「s」節點（Prefix: "s"）</text
        >
        <text class="trie-diagram__node-desc" x="78" y="48"
          >使用者鍵入第 1 碼命中，直接讀取預存結果</text
        >
      </g>

      <!-- Right: Precomputed Top-K Card -->
      <g transform="translate(420, 16)">
        <rect class="trie-diagram__list-card" width="420" height="78" rx="8"
        ></rect>
        <text class="trie-diagram__list-header" x="16" y="24"
          >以 's' 開頭 Top-K 預存清單：</text
        >
        <g transform="translate(16, 36)">
          <rect
            class="trie-diagram__pill-kw"
            x="0"
            y="4"
            width="124"
            height="28"
            rx="4"></rect>
          <text
            class="trie-diagram__pill-kw-text"
            x="62"
            y="22"
            text-anchor="middle">1. spotify (9.8M)</text
          >

          <rect
            class="trie-diagram__pill-kw"
            x="132"
            y="4"
            width="136"
            height="28"
            rx="4"></rect>
          <text
            class="trie-diagram__pill-kw-text"
            x="200"
            y="22"
            text-anchor="middle">2. speed test (6.2M)</text
          >

          <rect
            class="trie-diagram__pill-kw"
            x="276"
            y="4"
            width="116"
            height="28"
            rx="4"></rect>
          <text
            class="trie-diagram__pill-kw-text"
            x="334"
            y="22"
            text-anchor="middle">3. steam (5.4M)</text
          >
        </g>
      </g>
    </g>

    <!-- Connector 2 -->
    <g transform="translate(78, 362)">
      <path
        d="M 0 0 L 0 38"
        class="trie-diagram__branch-line"
        marker-end="url(#trie-arrow-main)"></path>
      <rect
        class="trie-diagram__edge-badge"
        x="16"
        y="8"
        width="96"
        height="24"
        rx="4"></rect>
      <text class="trie-diagram__edge-text" x="64" y="24" text-anchor="middle"
        >輸入字元 'y'</text
      >
    </g>

    <!-- LEVEL 2: Target Node 'sy' -->
    <g
      class="trie-diagram__row trie-diagram__row--target"
      transform="translate(48, 402)"
    >
      <rect
        class="trie-diagram__row-bg trie-diagram__row-bg--target"
        width="864"
        height="180"
        rx="10"></rect>

      <!-- Left: Node Circle & Target Info -->
      <g transform="translate(24, 25)">
        <circle
          class="trie-diagram__circle trie-diagram__circle--target"
          cx="32"
          cy="32"
          r="32"></circle>
        <text
          class="trie-diagram__circle-text trie-diagram__circle-text--target"
          x="32"
          y="40">'sy'</text
        >
        <text
          class="trie-diagram__node-name trie-diagram__node-name--target"
          x="84"
          y="26">目標節點「sy」（Prefix: "sy"）</text
        >
        <text class="trie-diagram__node-desc" x="84" y="50"
          >查詢複雜度：O(p) = O(2) ➔ 僅 2 次指針尋址！</text
        >
        <rect
          class="trie-diagram__badge-win"
          x="84"
          y="66"
          width="280"
          height="26"
          rx="4"></rect>
        <text class="trie-diagram__badge-win-text" x="94" y="83">
          ⚡ 空間換時間：無須遍歷子樹數萬個詞彙
        </text>
        <text class="trie-diagram__node-hint" x="84" y="118">
          單機定址延遲 &lt; 0.5ms · 零排序運算開銷
        </text>
      </g>

      <!-- Right: Detailed Top-K Result Panel -->
      <g transform="translate(420, 16)">
        <rect
          class="trie-diagram__list-card trie-diagram__list-card--target"
          width="420"
          height="148"
          rx="8"></rect>
        <text
          class="trie-diagram__list-header trie-diagram__list-header--target"
          x="18"
          y="26"
        >
          即時返回 Top-K 推薦候選（常數時間）：
        </text>

        <!-- Item 1 -->
        <g transform="translate(18, 38)">
          <rect class="trie-diagram__result-bar" width="384" height="24" rx="4"
          ></rect>
          <text class="trie-diagram__result-rank" x="10" y="16">1.</text>
          <text class="trie-diagram__result-kw" x="28" y="16"
            >system design</text
          >
          <text
            class="trie-diagram__result-score"
            x="374"
            y="16"
            text-anchor="end">8,920,000 熱度</text
          >
        </g>

        <!-- Item 2 -->
        <g transform="translate(18, 65)">
          <rect class="trie-diagram__result-bar" width="384" height="24" rx="4"
          ></rect>
          <text class="trie-diagram__result-rank" x="10" y="16">2.</text>
          <text class="trie-diagram__result-kw" x="28" y="16">synonym</text>
          <text
            class="trie-diagram__result-score"
            x="374"
            y="16"
            text-anchor="end">4,150,000 熱度</text
          >
        </g>

        <!-- Item 3 -->
        <g transform="translate(18, 92)">
          <rect class="trie-diagram__result-bar" width="384" height="24" rx="4"
          ></rect>
          <text class="trie-diagram__result-rank" x="10" y="16">3.</text>
          <text class="trie-diagram__result-kw" x="28" y="16"
            >symptom checker</text
          >
          <text
            class="trie-diagram__result-score"
            x="374"
            y="16"
            text-anchor="end">2,780,000 熱度</text
          >
        </g>

        <!-- Item 4 -->
        <g transform="translate(18, 119)">
          <rect class="trie-diagram__result-bar" width="384" height="24" rx="4"
          ></rect>
          <text class="trie-diagram__result-rank" x="10" y="16">4.</text>
          <text class="trie-diagram__result-kw" x="28" y="16">syntax error</text
          >
          <text
            class="trie-diagram__result-score"
            x="374"
            y="16"
            text-anchor="end">1,940,000 熱度</text
          >
        </g>
      </g>
    </g>
  </svg>

  <!-- Mobile View -->
  <div class="trie-diagram__mobile">
    <div class="trie-mobile-card trie-mobile-card--root">
      <span class="trie-mobile-badge trie-mobile-badge--root"
        >LEVEL 0 · ROOT</span
      >
      <h4>全域根節點（Root Node）</h4>
      <p><strong>前綴</strong>：空字串 <code>""</code>。</p>
      <p>
        <strong>作用</strong
        >：使用者游標點進搜尋框尚未鍵入任何字母時，即刻展示全站 Top 3
        熱搜（youtube、google、amazon）。
      </p>
      <div class="trie-mobile-arrow">↓ 使用者鍵入字元 's'</div>
    </div>

    <div class="trie-mobile-card trie-mobile-card--branch">
      <span class="trie-mobile-badge trie-mobile-badge--branch"
        >LEVEL 1 · PREFIX 's'</span
      >
      <h4>前綴「s」節點</h4>
      <p><strong>指針尋址</strong>：<code>O(1)</code> 直達 's' 節點。</p>
      <p>
        <strong>預存結果</strong>：spotify (9.8M)、speed test (6.2M)、steam
        (5.4M)。
      </p>
      <p>
        <strong>效能效益</strong>：完全不必遍歷 's'
        底下數百萬個字彙，直接回傳預存清單。
      </p>
      <div class="trie-mobile-arrow">↓ 使用者鍵入字元 'y'</div>
    </div>

    <div class="trie-mobile-card trie-mobile-card--target">
      <span class="trie-mobile-badge trie-mobile-badge--target"
        >TARGET · PREFIX 'sy'</span
      >
      <h4>目標前綴「sy」節點</h4>
      <p>
        <strong>查詢時間</strong>：<code>O(p) = O(2)</code
        >。兩次指標跳轉完成檢索，延遲小於 0.5ms。
      </p>
      <p><strong>返回 Top-K 推薦</strong>：</p>
      <ul class="trie-mobile-list">
        <li><strong>1. system design</strong> (8,920,000 熱度)</li>
        <li><strong>2. synonym</strong> (4,150,000 熱度)</li>
        <li><strong>3. symptom checker</strong> (2,780,000 熱度)</li>
        <li><strong>4. syntax error</strong> (1,940,000 熱度)</li>
      </ul>
      <p class="trie-mobile-note">
        💡 <strong>空間換時間代價</strong>：1000 萬詞庫僅約 3.12 GB
        記憶體，以極低成本換取百萬 QPS 吞吐。
      </p>
    </div>
  </div>

  <figcaption id="trie-caption" class="trie-diagram__caption">
    圖 1：Top-K 字典樹（Trie）前綴預存架構：常數時間 O(p) 檢索與熱門詞動態排序
  </figcaption>
</figure>

<style>
  .trie-diagram {
    margin: 2.5rem 0;
    width: 100%;
  }

  .trie-diagram__caption {
    margin-top: 0.875rem;
    font-size: 0.875rem;
    color: var(--dg-muted);
    text-align: center;
    line-height: 1.4;
  }

  /* Desktop SVG Layout */
  .trie-diagram__desktop {
    display: block;
    width: 100%;
    height: auto;
    background: var(--dg-surface);
    border: 1px solid var(--dg-rule-strong);
    border-radius: 0.875rem;
    padding: 0.5rem;
  }

  .trie-diagram__badge-bg {
    fill: rgba(14, 165, 233, 0.12);
    stroke: #0ea5e9;
    stroke-width: 1px;
  }
  :global(:root[data-theme="dark"]) .trie-diagram__badge-bg {
    fill: rgba(56, 189, 248, 0.18);
    stroke: #38bdf8;
  }

  .trie-diagram__badge-text {
    font-size: 11px;
    font-family: var(--font-mono);
    font-weight: 700;
    fill: #0284c7;
    letter-spacing: 0.05em;
  }
  :global(:root[data-theme="dark"]) .trie-diagram__badge-text {
    fill: #38bdf8;
  }

  .trie-diagram__main-title {
    font-size: 17px;
    font-family: var(--font-body);
    font-weight: 800;
    fill: var(--dg-ink);
  }

  .trie-diagram__main-sub {
    font-size: 13px;
    font-family: var(--font-body);
    fill: var(--dg-ink-2);
  }

  /* Row Cards */
  .trie-diagram__row-bg {
    fill: var(--dg-surface-2);
    stroke: var(--dg-rule);
    stroke-width: 1.2px;
  }
  .trie-diagram__row-bg--target {
    fill: var(--dg-surface-2);
    stroke: #0ea5e9;
    stroke-width: 1.8px;
  }
  :global(:root[data-theme="dark"]) .trie-diagram__row-bg--target {
    stroke: #38bdf8;
  }

  /* Node Circles */
  .trie-diagram__circle {
    fill: var(--dg-surface);
    stroke: var(--dg-rule-strong);
    stroke-width: 2px;
  }
  .trie-diagram__circle--root {
    fill: rgba(100, 116, 139, 0.1);
  }
  .trie-diagram__circle--branch {
    fill: rgba(2, 132, 199, 0.1);
    stroke: #0284c7;
  }
  :global(:root[data-theme="dark"]) .trie-diagram__circle--branch {
    stroke: #38bdf8;
  }
  .trie-diagram__circle--target {
    fill: rgba(14, 165, 233, 0.15);
    stroke: #0ea5e9;
    stroke-width: 2.5px;
  }
  :global(:root[data-theme="dark"]) .trie-diagram__circle--target {
    fill: rgba(56, 189, 248, 0.22);
    stroke: #38bdf8;
  }

  .trie-diagram__circle-text {
    font-size: 15px;
    font-family: var(--font-mono);
    font-weight: 800;
    fill: var(--dg-ink);
    text-anchor: middle;
  }
  .trie-diagram__circle-text--cyan {
    fill: #0284c7;
  }
  :global(:root[data-theme="dark"]) .trie-diagram__circle-text--cyan {
    fill: #38bdf8;
  }
  .trie-diagram__circle-text--target {
    fill: #0284c7;
    font-size: 16px;
  }
  :global(:root[data-theme="dark"]) .trie-diagram__circle-text--target {
    fill: #38bdf8;
  }

  /* Node Labels */
  .trie-diagram__node-name {
    font-size: 16px;
    font-family: var(--font-body);
    font-weight: 800;
    fill: var(--dg-ink);
  }
  .trie-diagram__node-name--target {
    color: #0284c7;
  }
  .trie-diagram__node-desc {
    font-size: 13px;
    font-family: var(--font-body);
    fill: var(--dg-muted);
  }
  .trie-diagram__node-hint {
    font-size: 12.5px;
    font-family: var(--font-mono);
    font-weight: 600;
    fill: var(--dg-ink-2);
  }

  /* List Cards on Right */
  .trie-diagram__list-card {
    fill: var(--dg-surface);
    stroke: var(--dg-rule);
    stroke-width: 1px;
  }
  .trie-diagram__list-card--target {
    fill: var(--dg-surface);
    stroke: var(--dg-rule-strong);
    stroke-width: 1.2px;
  }

  .trie-diagram__list-header {
    font-size: 13px;
    font-family: var(--font-body);
    font-weight: 700;
    fill: var(--dg-ink-2);
  }
  .trie-diagram__list-header--target {
    font-size: 13.5px;
    font-weight: 800;
    fill: #0284c7;
  }
  :global(:root[data-theme="dark"]) .trie-diagram__list-header--target {
    fill: #38bdf8;
  }

  /* Keyword Pills & Bars */
  .trie-diagram__pill-kw {
    fill: rgba(100, 116, 139, 0.1);
    stroke: var(--dg-rule);
    stroke-width: 1px;
  }
  .trie-diagram__pill-kw-text {
    font-size: 11.5px;
    font-family: var(--font-mono);
    font-weight: 600;
    fill: var(--dg-ink-2);
  }

  .trie-diagram__result-bar {
    fill: var(--dg-surface-2);
    stroke: var(--dg-rule);
    stroke-width: 1px;
  }
  .trie-diagram__result-rank {
    font-size: 12px;
    font-family: var(--font-mono);
    font-weight: 700;
    fill: var(--dg-muted);
  }
  .trie-diagram__result-kw {
    font-size: 13px;
    font-family: var(--font-mono);
    font-weight: 700;
    fill: var(--dg-ink);
  }
  .trie-diagram__result-score {
    font-size: 11.5px;
    font-family: var(--font-mono);
    font-weight: 600;
    fill: #059669;
  }
  :global(:root[data-theme="dark"]) .trie-diagram__result-score {
    fill: #34d399;
  }

  /* Badge Win */
  .trie-diagram__badge-win {
    fill: rgba(5, 150, 105, 0.12);
    stroke: #059669;
    stroke-width: 1px;
  }
  :global(:root[data-theme="dark"]) .trie-diagram__badge-win {
    fill: rgba(52, 211, 153, 0.18);
    stroke: #34d399;
  }
  .trie-diagram__badge-win-text {
    font-size: 12px;
    font-family: var(--font-body);
    font-weight: 700;
    fill: #059669;
  }
  :global(:root[data-theme="dark"]) .trie-diagram__badge-win-text {
    fill: #34d399;
  }

  /* Branch Lines & Connectors */
  .trie-diagram__branch-line {
    stroke: #0284c7;
    stroke-width: 2.5px;
    stroke-dasharray: 4 4;
    fill: none;
  }
  :global(:root[data-theme="dark"]) .trie-diagram__branch-line {
    stroke: #38bdf8;
  }

  .trie-diagram__arrow-head {
    fill: #0284c7;
  }
  :global(:root[data-theme="dark"]) .trie-diagram__arrow-head {
    fill: #38bdf8;
  }

  .trie-diagram__edge-badge {
    fill: rgba(2, 132, 199, 0.1);
    stroke: #0284c7;
    stroke-width: 1px;
  }
  :global(:root[data-theme="dark"]) .trie-diagram__edge-badge {
    fill: rgba(56, 189, 248, 0.18);
    stroke: #38bdf8;
  }

  .trie-diagram__edge-text {
    font-size: 12px;
    font-family: var(--font-mono);
    font-weight: 700;
    fill: #0284c7;
  }
  :global(:root[data-theme="dark"]) .trie-diagram__edge-text {
    fill: #38bdf8;
  }

  /* Mobile Layout */
  @media (max-width: 48rem) {
    .trie-diagram__desktop {
      display: none !important;
    }

    .trie-diagram__mobile {
