---
import { Image } from "astro:assets";
import { render, type CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  headingLevel?: "h2" | "h3";
}

const { project, headingLevel: Heading = "h2" } = Astro.props;
const { Content } = await render(project);
const detailId = `project-${project.id.replace(/[^a-zA-Z0-9_-]/g, "-")}`;
const titleId = `${detailId}-title`;
const descriptionId = `${detailId}-description`;
---

<div class="project-card-shell" data-project-card>
  <article class="project-card-item">
    <div class="project-card-item__artwork">
      {
        project.data.cover ? (
          <Image
            class="project-card-item__cover"
            src={project.data.cover}
            alt={project.data.coverAlt ?? ""}
            widths={[320, 640, 960]}
            sizes="(min-width: 1080px) 24vw, (min-width: 720px) 33vw, calc(100vw - 3rem)"
            loading="lazy"
          />
        ) : (
          <span class="project-card-item__fallback" aria-hidden="true">
            {project.data.name.slice(0, 2)}
          </span>
        )
      }
    </div>

    <div class="project-card-item__meta" aria-hidden="true">
      <span>{project.data.status}</span>
      {
        project.data.startedAt && (
          <time datetime={project.data.startedAt.toISOString()}>
            {project.data.startedAt.getFullYear()}
          </time>
        )
      }
    </div>

    <div class="project-card-item__content">
      <Heading class="project-card-item__title">{project.data.name}</Heading>
      <span class="project-card-item__hint">點擊查看完整資料</span>
      <div class="project-card-item__reveal">
        <p>{project.data.description}</p>
        <ul aria-label={`${project.data.name} 標籤`}>
          {project.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>
    </div>

    <button
      class="project-card-item__open"
      type="button"
      data-project-open
      aria-haspopup="dialog"
      aria-controls={detailId}
      aria-label={`查看 ${project.data.name} 詳細資料`}></button>
  </article>

  <dialog
    class="project-dialog"
    id={detailId}
    data-project-dialog
    aria-labelledby={titleId}
    aria-describedby={descriptionId}
  >
    <article class="project-dialog__panel">
      <div class="project-dialog__visual">
        {
          project.data.cover && (
            <Image
              src={project.data.cover}
              alt={project.data.coverAlt ?? ""}
              widths={[480, 720]}
              sizes="(min-width: 48rem) 19rem, 100vw"
              loading="lazy"
            />
          )
        }
      </div>

      <div class="project-dialog__content">
        <header class="project-dialog__header">
          <div>
            <div class="project-dialog__meta">
              <span>{project.data.status}</span>
              {
                project.data.startedAt && (
                  <time datetime={project.data.startedAt.toISOString()}>
                    始於 {project.data.startedAt.getFullYear()}
                  </time>
                )
              }
            </div>
            <h2 id={titleId}>{project.data.name}</h2>
          </div>
          <form method="dialog">
            <button type="submit" aria-label={`關閉 ${project.data.name} 詳情`}>
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M6 6l12 12M18 6 6 18"></path>
              </svg>
            </button>
          </form>
        </header>

        <p class="project-dialog__lede" id={descriptionId}>
          {project.data.description}
        </p>

        <div class="project-dialog__body prose">
          <Content />
        </div>

        <ul
          class="project-dialog__tags"
          aria-label={`${project.data.name} 標籤`}
        >
          {project.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>

        <footer class="project-dialog__links">
          <a href={project.data.repositoryUrl} rel="external">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
              ></path>
            </svg>
            <span>GitHub repository</span>
          </a>
          {
            project.data.homepageUrl && (
              <a href={project.data.homepageUrl} rel="external">
                專案首頁
              </a>
            )
          }
        </footer>
      </div>
    </article>
  </dialog>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-project-card]")
    .forEach((root) => {
      const openButton = root.querySelector<HTMLButtonElement>(
        "[data-project-open]",
      );
      const dialog = root.querySelector<HTMLDialogElement>(
        "[data-project-dialog]",
      );

      openButton?.addEventListener("click", (event) => {
        event.stopPropagation();
        dialog?.showModal();
      });
      document.addEventListener("click", (event) => {
        if (!dialog?.open || !(event instanceof MouseEvent)) return;
        const bounds = dialog.getBoundingClientRect();
        const outside =
          event.clientX < bounds.left ||
          event.clientX > bounds.right ||
          event.clientY < bounds.top ||
          event.clientY > bounds.bottom;
        if (outside) dialog.close();
      });
      dialog?.addEventListener("close", () => openButton?.focus());
    });
</script>

<style>
  .project-card-shell {
    display: grid;
    min-width: 0;
  }

  .project-card-item {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    min-width: 0;
    padding: 0.58rem;
    border: 1px solid
      color-mix(in srgb, var(--color-rule-2) 72%, var(--color-accent));
    border-radius: calc(var(--radius-lg) + 0.15rem);
    background: linear-gradient(
      145deg,
      var(--color-paper-3),
      var(--color-card) 48%,
      var(--color-paper-2)
    );
    box-shadow:
      0 1px 0 color-mix(in srgb, var(--color-card) 76%, transparent),
      0 0.3rem 0 color-mix(in srgb, var(--color-ink) 16%, var(--color-paper-3)),
      0 1.15rem 2.4rem color-mix(in srgb, var(--color-ink) 14%, transparent);
    transform-origin: 50% 85%;
    transition:
      transform var(--dur-short) var(--ease-out),
      box-shadow var(--dur-short) var(--ease-out),
      border-color var(--dur-short) var(--ease-out);
  }

  .project-card-item::before,
  .project-card-item::after {
    position: absolute;
    pointer-events: none;
    content: "";
  }

  .project-card-item::before {
    z-index: 3;
    inset: 0.28rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 42%, transparent);
    border-radius: calc(var(--radius-lg) - 0.05rem);
    box-shadow: inset 0 0 0 1px
      color-mix(in srgb, var(--color-card) 66%, transparent);
  }

  .project-card-item::after {
    z-index: 3;
    inset: 0.58rem;
    overflow: hidden;
    border-radius: calc(var(--radius-lg) - 0.36rem);
    background: linear-gradient(
      112deg,
      transparent 20%,
      color-mix(in srgb, var(--color-accent-ink) 32%, transparent) 45%,
      transparent 68%
    );
    transform: translateX(-135%);
    transition: transform 760ms var(--ease-out);
  }

  .project-card-item__artwork {
    position: absolute;
    inset: 0.58rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-rule-2) 70%, transparent);
    border-radius: calc(var(--radius-lg) - 0.36rem);
    background: var(--color-paper-2);
  }

  .project-card-item__artwork::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 42%,
      color-mix(in srgb, var(--color-code) 38%, transparent) 66%,
      color-mix(in srgb, var(--color-code) 94%, transparent) 100%
    );
    pointer-events: none;
    content: "";
  }

  .project-card-item__cover {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }

  .project-card-item__fallback {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
  }

  .project-card-item__meta {
    position: absolute;
    z-index: 4;
    inset-block-start: 1.12rem;
    inset-inline: 1.12rem;
    display: flex;
    justify-content: space-between;
    gap: var(--space-xs);
    color: var(--color-code-ink);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-shadow: 0 1px 0 var(--color-code);
  }

  .project-card-item__meta span,
  .project-card-item__meta time {
    padding: 0.18rem 0.46rem;
    border: 1px solid color-mix(in srgb, var(--color-code-ink) 28%, transparent);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-code) 62%, transparent);
    backdrop-filter: blur(6px);
  }

  .project-card-item__content {
    position: absolute;
    z-index: 4;
    inset-inline: 1.15rem;
    inset-block-end: 1.12rem;
    color: var(--color-code-ink);
    text-shadow: 0 1px 0 var(--color-code);
  }

  .project-card-item__title {
    color: inherit;
    font-size: clamp(1.15rem, 2.2vw, var(--text-xl));
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .project-card-item__hint {
    display: block;
    margin-top: 0.35rem;
    color: color-mix(in srgb, var(--color-code-ink) 74%, transparent);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .project-card-item__reveal {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateY(0.6rem);
    transition:
      max-height var(--dur-long) var(--ease-out),
      opacity var(--dur-short) var(--ease-out),
      transform var(--dur-short) var(--ease-out);
  }

  .project-card-item__reveal p {
    display: -webkit-box;
    margin: var(--space-sm) 0 0;
    overflow: hidden;
    color: color-mix(in srgb, var(--color-code-ink) 88%, transparent);
    font-size: var(--text-xs);
    line-height: 1.5;
    text-wrap: pretty;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .project-card-item__reveal ul,
  .project-dialog__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: var(--space-sm) 0 0;
    padding: 0;
    list-style: none;
  }

  .project-card-item__reveal li {
    padding: 0.12rem 0.42rem;
    border: 1px solid color-mix(in srgb, var(--color-code-ink) 24%, transparent);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-code) 52%, transparent);
    font-size: 0.62rem;
    line-height: 1.5;
  }

  .project-card-item__open {
    position: absolute;
    z-index: 5;
    inset: 0;
    width: 100%;
    border: 0;
    border-radius: inherit;
    background: transparent;
  }

  .project-card-item__open:focus-visible {
    border-radius: calc(var(--radius-lg) + 0.15rem);
    outline-offset: -0.28rem;
  }

  .project-dialog {
    position: fixed;
    inset: 0;
    width: min(56rem, calc(100% - 2rem));
    max-width: none;
    height: fit-content;
    max-height: min(88svh, 48rem);
    margin: auto;
    padding: 0;
    overflow: auto;
    border: 1px solid
      color-mix(in srgb, var(--color-rule-2) 75%, var(--color-accent));
    border-radius: var(--radius-lg);
    background: var(--color-card);
    color: var(--color-ink-2);
    box-shadow: var(--shadow-lg);
  }

  .project-dialog[open] {
    animation: project-dialog-enter var(--dur-long) both var(--ease-out);
  }

  .project-dialog::backdrop {
    background: var(--color-overlay);
    backdrop-filter: blur(6px);
  }

  .project-dialog__panel {
    display: grid;
    min-width: 0;
  }

  .project-dialog__visual {
    min-height: 13rem;
    overflow: hidden;
    background: var(--color-paper-2);
  }

  .project-dialog__visual img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 20rem;
    object-fit: cover;
  }

  .project-dialog__content {
    display: grid;
    align-content: start;
    gap: var(--space-md);
    min-width: 0;
    padding: var(--space-xl);
  }

  .project-dialog__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .project-dialog__header h2 {
    margin-top: var(--space-xs);
    color: var(--color-ink);
    font-size: var(--text-2xl);
    line-height: 1.12;
    letter-spacing: -0.04em;
  }

  .project-dialog__header form {
    flex: 0 0 auto;
  }

  .project-dialog__header button {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    place-items: center;
    border: var(--rule-hair) solid var(--color-rule-2);
    border-radius: 50%;
    background: var(--color-paper-2);
    color: var(--color-ink-2);
    transition:
      transform var(--dur-micro) var(--ease-out),
      border-color var(--dur-micro) var(--ease-out),
      color var(--dur-micro) var(--ease-out);
  }

  .project-dialog__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    color: var(--color-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .project-dialog__lede {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-md);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .project-dialog__body {
    padding-block: var(--space-md);
    border-block: var(--rule-hair) solid var(--color-rule);
  }

  .project-dialog__tags {
    margin-top: 0;
  }

  .project-dialog__tags li {
    padding: 0.24rem 0.62rem;
    border-radius: var(--radius-pill);
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .project-dialog__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .project-dialog__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.85rem;
    border: var(--rule-hair) solid var(--color-rule-2);
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: 700;
    transition:
      transform var(--dur-micro) var(--ease-out),
      border-color var(--dur-micro) var(--ease-out),
      color var(--dur-micro) var(--ease-out);
  }

  .project-dialog__links svg {
    width: 1.1rem;
    height: 1.1rem;
    flex: 0 0 auto;
  }

  .project-card-item:focus-within {
    border-color: color-mix(
      in srgb,
      var(--color-accent) 72%,
      var(--color-rule)
    );
    box-shadow:
      0 1px 0 color-mix(in srgb, var(--color-card) 76%, transparent),
      0 0.42rem 0 color-mix(in srgb, var(--color-ink) 18%, var(--color-paper-3)),
      0 1.7rem 3rem color-mix(in srgb, var(--color-ink) 20%, transparent);
    transform: translateY(-0.5rem) rotate(0.35deg);
  }

  .project-card-item:focus-within::after {
    transform: translateX(135%);
  }

  .project-card-item:focus-within .project-card-item__cover {
    transform: scale(1.045);
  }

  .project-card-item:focus-within .project-card-item__reveal {
    max-height: 9rem;
    opacity: 1;
    transform: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-card-item:hover {
      border-color: color-mix(
        in srgb,
        var(--color-accent) 72%,
        var(--color-rule)
      );
      box-shadow:
        0 1px 0 color-mix(in srgb, var(--color-card) 76%, transparent),
        0 0.42rem 0
          color-mix(in srgb, var(--color-ink) 18%, var(--color-paper-3)),
        0 1.7rem 3rem color-mix(in srgb, var(--color-ink) 20%, transparent);
      transform: translateY(-0.5rem) rotate(0.35deg);
    }

    .project-card-item:hover::after {
      transform: translateX(135%);
    }

    .project-card-item:hover .project-card-item__cover {
      transform: scale(1.045);
    }

    .project-card-item:hover .project-card-item__reveal {
      max-height: 9rem;
      opacity: 1;
      transform: none;
    }

    .project-dialog__header button:hover,
    .project-dialog__links a:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
      transform: translateY(-1px);
    }
  }

  @media (min-width: 48rem) {
    .project-dialog__panel {
      grid-template-columns: minmax(16rem, 19rem) minmax(0, 1fr);
    }

    .project-dialog__visual {
      min-height: 100%;
    }

    .project-dialog__visual img {
      max-height: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card-item,
    .project-card-item::after,
    .project-card-item__cover,
    .project-card-item__reveal,
    .project-dialog,
    .project-dialog__header button,
    .project-dialog__links a {
      animation: none;
      transition: none;
    }

    .project-card-item:hover,
    .project-card-item:focus-within,
    .project-card-item:hover::after,
    .project-card-item:focus-within::after,
    .project-card-item:hover .project-card-item__cover,
    .project-card-item:focus-within .project-card-item__cover {
      transform: none;
    }
  }

  @keyframes project-dialog-enter {
    from {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.985);
    }
  }
</style>
