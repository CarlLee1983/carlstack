---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  headingLevel?: "h2" | "h3";
}

const { project, headingLevel: Heading = "h2" } = Astro.props;
---

<article class="project-card-item">
  {
    project.data.cover && (
      <Image
        class="project-card-item__cover"
        src={project.data.cover}
        alt=""
        widths={[400, 800]}
        sizes="(min-width: 720px) 33vw, calc(100vw - 3rem)"
        loading="lazy"
      />
    )
  }
  <div class="project-card-item__body">
    <div class="project-card-item__meta">
      <span class="status-badge">{project.data.status}</span>
      {
        project.data.startedAt && (
          <time datetime={project.data.startedAt.toISOString()}>
            {project.data.startedAt.getFullYear()}
          </time>
        )
      }
    </div>
    <Heading class="project-card-item__title">{project.data.name}</Heading>
    <p class="project-card-item__desc">{project.data.description}</p>

    <ul class="tag-list" aria-label={`${project.data.name} 標籤`}>
      {
        project.data.tags.map((tag) => (
          <li>
            <span class="tag">{tag}</span>
          </li>
        ))
      }
    </ul>

    <div class="project-card-item__links">
      <a class="project-link" href={project.data.repositoryUrl} rel="external">
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
          ></path>
        </svg>
        <span>GitHub</span>
      </a>
      {
        project.data.homepageUrl && (
          <a
            class="project-link"
            href={project.data.homepageUrl}
            rel="external"
          >
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
            <span>專案首頁</span>
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .project-card-item {
    display: grid;
    gap: var(--space-md);
    padding: var(--space-xl);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-card);
    box-shadow: var(--shadow-sm);
    transition: all var(--dur-short) var(--ease-out);
  }

  .project-card-item:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-accent);
  }

  .project-card-item__cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    object-fit: cover;
  }

  .project-card-item__body {
    display: grid;
    gap: var(--space-sm);
  }

  .project-card-item__meta {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .status-badge {
    padding: 0.15rem 0.6rem;
    background: var(--color-secondary-soft);
    color: var(--color-secondary);
    border-radius: var(--radius-pill);
    font-weight: 700;
  }

  .project-card-item__title {
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.3;
  }

  .project-card-item__desc {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .project-card-item__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
    padding-top: var(--space-sm);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    background: var(--color-paper-2);
    color: var(--color-ink-2);
    font-size: var(--text-xs);
    font-weight: 600;
    transition: all var(--dur-micro) var(--ease-out);
  }

  .project-link:hover {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }
</style>
