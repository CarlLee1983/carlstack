      border-color: #fbbf24;
    }

    .elk-mobile-badge {
      font-size: 0.75rem;
      font-weight: 700;
      display: block;
      margin-bottom: 0.25rem;
    }

    .elk-mobile-badge--teal {
      color: #0f766e;
    }
    :global(:root[data-theme="dark"]) .elk-mobile-badge--teal {
      color: #2dd4bf;
    }

    .elk-mobile-badge--purple {
      color: #7e22ce;
    }
    :global(:root[data-theme="dark"]) .elk-mobile-badge--purple {
      color: #c084fc;
    }

    .elk-mobile-badge--cyan {
      color: #0891b2;
    }
    :global(:root[data-theme="dark"]) .elk-mobile-badge--cyan {
      color: #22d3ee;
    }

    .elk-mobile-badge--gold {
      color: #b45309;
    }
    :global(:root[data-theme="dark"]) .elk-mobile-badge--gold {
      color: #fbbf24;
    }

    .elk-mobile-card h4 {
      margin: 0 0 0.25rem 0;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--dg-ink);
    }
    :global(:root[data-theme="dark"]) .elk-mobile-card h4 {
      color: #f8fafc;
    }

    .elk-mobile-card p {
      margin: 0.25rem 0;
      font-size: 0.8125rem;
      color: var(--dg-ink-2);
      line-height: 1.4;
    }
    :global(:root[data-theme="dark"]) .elk-mobile-card p {
      color: #cbd5e1;
    }

    .elk-mobile-arrow {
      text-align: center;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--dg-muted);
      padding: 0.125rem 0;
    }
  }

  :global(:root[data-theme="dark"]) .elk-diagram__flow-line {
    stroke: #4bb3e8;
  }
  :global(:root[data-theme="dark"]) .elk-diagram__arrow-head {
    fill: #4bb3e8;
  }
</style>
