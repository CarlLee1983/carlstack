    stroke: #f97316;
    fill: #fff7ed;
  }
  :global(:root[data-theme="dark"]) .elk-diagram__subcard--orange {
    stroke: #ea580c;
    fill: #431407;
  }

  .elk-diagram__subcard--cyan {
    stroke: #22d3ee;
    fill: #ecfeff;
  }
  :global(:root[data-theme="dark"]) .elk-diagram__subcard--cyan {
    stroke: #0891b2;
    fill: #083344;
  }

  .elk-diagram__subcard--green {
    stroke: #10b981;
    fill: #f0fdf4;
  }
  :global(:root[data-theme="dark"]) .elk-diagram__subcard--green {
    stroke: #059669;
    fill: #064e3b;
  }

  .elk-diagram__header {
    font-size: 12px;
    font-weight: 700;
    fill: #0f172a;
  }
  :global(:root[data-theme="dark"]) .elk-diagram__header {
    fill: #f8fafc;
  }

