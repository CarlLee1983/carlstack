    fill: #0f766e;
  }
  :global(:root[data-theme="dark"]) .elk-diagram__header--teal {
    fill: #2dd4bf;
  }

  .elk-diagram__header--gold {
    fill: #b45309;
  }
  :global(:root[data-theme="dark"]) .elk-diagram__header--gold {
    fill: #fbbf24;
  }

  .elk-diagram__header--blue {
    fill: #0284c7;
  }
  :global(:root[data-theme="dark"]) .elk-diagram__header--blue {
    fill: #38bdf8;
  }

  .elk-diagram__header--purple {
    fill: #7e22ce;
  }
  :global(:root[data-theme="dark"]) .elk-diagram__header--purple {
    fill: #c084fc;
  }

  .elk-diagram__header--orange {
    fill: #c2410c;
  }
  :global(:root[data-theme="dark"]) .elk-diagram__header--orange {
    fill: #fb923c;
  }

  .elk-diagram__header--cyan {
    fill: #0e7490;
  }
  :global(:root[data-theme="dark"]) .elk-diagram__header--cyan {
    fill: #22d3ee;
  }

