  }
  :global(:root[data-theme="dark"]) .elk-diagram__desc {
    fill: #94a3b8;
  }

  .elk-diagram__flow-line {
    stroke: #0284c7;
    stroke-width: 2;
    fill: none;
    stroke-dasharray: 4, 4;
  }

  .elk-diagram__arrow-head {
    fill: #0284c7;
  }

  @media (max-width: 768px) {
