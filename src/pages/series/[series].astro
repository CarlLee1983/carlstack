---
import type { GetStaticPaths } from "astro";
import ArticleCard from "../../components/ArticleCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  collectTaxonomy,
  getSeriesPosts,
  getVisiblePosts,
} from "../../utils/collections";

import { estimateReadingMinutes } from "../../utils/content";

export const getStaticPaths = (async () => {
  const posts = await getVisiblePosts();
  return collectTaxonomy(posts, "series").map((series) => ({
    params: { series: series.slug },
    props: { series: { ...series, posts: getSeriesPosts(posts, series.name) } },
  }));
}) satisfies GetStaticPaths;

const { series } = Astro.props;

const totalReadingMinutes = series.posts.reduce((acc, p) => {
  const body = "body" in p && typeof p.body === "string" ? p.body : "";
  return acc + estimateReadingMinutes(body);
}, 0);
---

<BaseLayout
  title={`系列：${series.name}`}
  description={`CarlStack「${series.name}」系列文章。`}
>
  <div class="page shell">
    <div class="series-nav">
      <a class="back-link" href="/series/">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>返回所有系列</span>
      </a>
    </div>

    <header class="page-header series-detail-header">
      <div class="hero-eyebrow">
        <span class="eyebrow-dot"></span>
        <span>TECHNICAL CURRICULUM</span>
      </div>
      <h1>{series.name}</h1>
      <p>本系列依難度與架構脈絡由淺入深編排，建議依章節序號循序閱讀。</p>

      <div class="series-summary-bar">
        <div class="summary-pill">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"
            ></path>
          </svg>
          <span>共 {series.posts.length} 篇章節</span>
        </div>
        <div class="summary-pill">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span>預計研讀 {totalReadingMinutes} 分鐘</span>
        </div>
      </div>
    </header>

    <div class="article-list">
      {series.posts.map((post) => <ArticleCard post={post} variant="row" />)}
    </div>
  </div>
</BaseLayout>

<style>
  .series-nav {
    margin-block-end: var(--space-lg);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-muted);
    text-decoration: none;
    transition:
      color var(--dur-micro) var(--ease-out),
      gap var(--dur-micro) var(--ease-out);
  }

  .back-link:hover {
    color: var(--color-accent);
    gap: 0.6rem;
  }

  .series-detail-header {
    margin-block-end: var(--space-3xl);
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-accent);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: -0.25rem;
  }

  .eyebrow-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
  }

  .series-summary-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-block-start: var(--space-md);
  }

  .summary-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.85rem;
    background: var(--color-surface);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text);
  }

  .summary-pill svg {
    color: var(--color-accent);
  }
</style>
