---
import { getCollection } from "astro:content";
import ArticleCard from "../components/ArticleCard.astro";
import EmptyState from "../components/EmptyState.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { siteConfig } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { collectTaxonomy, getVisiblePosts } from "../utils/collections";
import { sortByPostCount } from "../utils/content";

const posts = await getVisiblePosts();
const latest = posts.slice(0, 5);
const featured = posts.filter((post) => post.data.featured).slice(0, 3);
const tags = collectTaxonomy(posts, "tags");
const topics = sortByPostCount(tags).slice(0, 8);
const allProjects = await getCollection("projects");
const projects = allProjects
  .filter((project) => project.data.featured)
  .sort((left, right) => left.data.name.localeCompare(right.data.name))
  .slice(0, 3);

// 側欄數字直接從內容集合算出，不另外維護一份會過期的描述文案。
const latestDate = latest[0]?.data.updatedDate ?? latest[0]?.data.publishDate;
const stats = [
  { value: posts.length, label: "篇文章" },
  { value: tags.length, label: "個主題標籤" },
  { value: allProjects.length, label: "個開源專案" },
];
const latestLabel = latestDate
  ? new Intl.DateTimeFormat("zh-TW", { month: "long", day: "numeric" }).format(
      latestDate,
    )
  : null;
---

<BaseLayout title={siteConfig.name}>
  <div class="shell home">
    <!-- Hero Section -->
    <section class="home-hero">
      <div class="home-hero__copy">
        <div class="hero-eyebrow">
          <span class="eyebrow-dot"></span>
          <span>SYSTEMS × AI ENGINEERING</span>
        </div>
        <h1>把系統做清楚，<br />也把取捨寫下來。</h1>
        <p class="home-hero__lede">
          {
            siteConfig.subtitle
          }。收錄能重現的實作、架構判斷與專案復盤，不追逐只在簡報裡成立的答案。
        </p>
        <div class="home-hero__actions">
          <a class="btn-primary" href="/blog/">
            <span>閱讀文章</span>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a class="btn-secondary" href="/about/">
            <span>認識李卡爾</span>
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>
        </div>
      </div>

      <!-- 站點速覽：數字來自內容集合 -->
      <aside class="hero-spec-card" aria-label="站點速覽">
        <div class="hero-spec-card__header">
          <span>站點速覽</span>
          <span class="spec-tag">GIT-NATIVE</span>
        </div>
        <dl class="hero-stats">
          {
            stats.map((stat) => (
              <div class="hero-stats__item">
                <dd>{stat.value}</dd>
                <dt>{stat.label}</dt>
              </div>
            ))
          }
        </dl>
        <p class="hero-spec-card__desc">
          {latestLabel && <span>最近更新 {latestLabel}。</span>}
          全部內容保存在 Git repository，每次發布皆為純靜態產物，可驗證、可離線重建。
        </p>
      </aside>
    </section>

    <!-- Latest Articles Section -->
    <section class="section home-latest" aria-labelledby="latest-heading">
      <div class="section-head">
        <h2 id="latest-heading">最新文章</h2>
        <a class="text-link" href="/blog/">
          <span>全部文章</span>
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
      {
        latest.length > 0 ? (
          <div class="article-list">
            {latest.map((post) => (
              <ArticleCard post={post} headingLevel="h3" variant="row" />
            ))}
          </div>
        ) : (
          <EmptyState
            title="正式文章正在整理"
            description="production build 不會顯示草稿。開發環境可預覽完整的 MDX、程式碼與 Mermaid 示範文章。"
            href="/rss.xml"
            action="先訂閱 RSS"
          />
        )
      }
    </section>

    <!-- Pair Section: Featured & Topics -->
    <div class="home-pair">
      <section class="section" aria-labelledby="featured-heading">
        <div class="section-head">
          <h2 id="featured-heading">精選文章</h2>
          <span class="muted">經過實作驗證的長期參考</span>
        </div>
        {
          featured.length > 0 ? (
            <div class="article-grid">
              {featured.map((post) => (
                <ArticleCard post={post} headingLevel="h3" />
              ))}
            </div>
          ) : (
            <EmptyState
              title="尚未標記精選文章"
              description="文章 frontmatter 設為 featured: true 後，會自動出現在這裡。"
            />
          )
        }
      </section>

      <section class="section home-topics" aria-labelledby="topics-heading">
        <div class="section-head">
          <h2 id="topics-heading">主要技術主題</h2>
          <a class="text-link" href="/tags/">
            <span>標籤總覽</span>
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
        {
          tags.length > 0 ? (
            <ul class="topic-cloud">
              {topics.map((tag) => (
                <li>
                  <a href={`/tags/${tag.slug}/`}>
                    <span>{tag.name}</span>
                    <span class="muted">{tag.posts.length}</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <EmptyState
              title="主題會隨文章長出來"
              description="標籤完全由已發布文章自動產生；不在元件內維護另一份分類清單。"
            />
          )
        }
      </section>
    </div>

    <!-- Projects Section -->
    <section class="section home-projects" aria-labelledby="projects-heading">
      <div class="section-head">
        <h2 id="projects-heading">精選開源專案</h2>
        <a class="text-link" href="/projects/">
          <span>全部專案</span>
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
      {
        projects.length > 0 ? (
          <div class="project-grid">
            {projects.map((project) => (
              <ProjectCard project={project} headingLevel="h3" />
            ))}
          </div>
        ) : (
          <EmptyState
            title="尚未設定精選專案"
            description="在 project frontmatter 設定 featured: true 即可加入首頁。"
          />
        )
      }
    </section>

    <!-- Connect / RSS Section -->
    <section class="home-connect" aria-labelledby="connect-heading">
      <div>
        <h2 id="connect-heading">跟上下一次發布</h2>
        <p>RSS 是第一版唯一的訂閱管道；不追蹤開信、不要求登入，純粹乾淨。</p>
      </div>
      <div class="home-connect__actions">
        <a class="btn-primary" href="/rss.xml">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 11a9 9 0 0 1 9 9"></path>
            <path d="M4 4a16 16 0 0 1 16 16"></path>
            <circle cx="5" cy="19" r="1"></circle>
          </svg>
          <span>訂閱 RSS</span>
        </a>
        <a class="btn-secondary" href={siteConfig.github} rel="me">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
            ></path>
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    padding-block-end: var(--space-4xl);
  }

  /* Hero Section */
  .home-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
    padding-block: var(--space-2xl) var(--space-3xl);
    border-block-end: var(--rule-hair) solid var(--color-rule);
  }

  .home-hero::before {
    position: absolute;
    z-index: -1;
    inset: 8% -4% 12% 42%;
    background:
      radial-gradient(
        circle at 70% 20%,
        var(--color-accent-soft),
        transparent 52%
      ),
      radial-gradient(
        circle at 26% 78%,
        var(--color-secondary-soft),
        transparent 46%
      );
    content: "";
    filter: blur(24px);
    opacity: 0.75;
    pointer-events: none;
  }

  .home-hero__copy {
    min-width: 0;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-md);
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    background: var(--color-accent);
    border-radius: 50%;
    animation: status-pulse 2.8s ease-in-out infinite;
  }

  .home-hero h1 {
    font-size: var(--text-display);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-md);
  }

  .home-hero__lede {
    max-width: 36rem;
    font-size: var(--text-md);
    color: var(--color-muted);
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    align-items: center;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-inline: var(--space-lg);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: #ffffff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(217, 93, 57, 0.25);
    transition: all var(--dur-micro) var(--ease-out);
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(217, 93, 57, 0.35);
  }

  .btn-primary:active,
  .btn-secondary:active {
    transform: translateY(0) scale(0.98);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding-inline: var(--space-md);
    border-radius: var(--radius-pill);
    background: var(--color-paper-2);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    text-decoration: none;
    white-space: nowrap;
    transition: all var(--dur-micro) var(--ease-out);
  }

  .btn-secondary:hover {
    background: var(--color-card);
    transform: translateY(-1px);
  }

  /* Hero Side Spec Widget */
  .hero-spec-card {
    background: var(--color-card);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl);
    box-shadow: var(--shadow-sm);
    position: relative;
  }

  .hero-spec-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: var(--space-2xl);
    right: var(--space-2xl);
    height: 3px;
    background: var(--color-accent);
    border-radius: 0 0 4px 4px;
  }

  .hero-spec-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: var(--space-sm);
  }

  .spec-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .hero-spec-card__desc {
    margin-block-start: var(--space-lg);
    padding-block-start: var(--space-md);
    border-block-start: var(--rule-hair) solid var(--color-rule);
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.7;
  }

  .hero-spec-card__desc span {
    color: var(--color-ink);
    font-weight: 600;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
    margin: var(--space-md) 0 0;
  }

  .hero-stats__item {
    display: grid;
    gap: var(--space-3xs);
  }

  .hero-stats dd {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .hero-stats dt {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  /* Sections */
  .home .section {
    border-block-start: 0;
  }

  .home .section-head h2 {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .home .section-head h2::after {
    width: 1.75rem;
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    content: "";
    transform-origin: left;
  }

  .home-latest {
    padding-block: var(--space-2xl);
  }

  .home-pair {
    display: grid;
    gap: var(--space-xl);
  }

  .home-projects {
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  .home-topics .topic-cloud a span.muted {
    transition:
      color var(--dur-micro) var(--ease-out),
      background-color var(--dur-micro) var(--ease-out),
      transform var(--dur-micro) var(--ease-out);
  }

  .home-topics .topic-cloud a:hover span.muted {
    background: var(--color-accent-soft);
    color: var(--color-accent);
    transform: translateX(-0.2rem);
  }

  .home-topics .topic-cloud a:active {
    transform: scale(0.98);
  }

  /* Connect CTA */
  .home-connect {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-xl);
    margin-block-start: var(--space-3xl);
    padding: var(--space-2xl);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-card);
    box-shadow: var(--shadow-sm);
  }

  .home-connect::before {
    position: absolute;
    z-index: -1;
    top: -7rem;
    right: -3rem;
    width: 16rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-accent-soft);
    content: "";
    filter: blur(20px);
    opacity: 0.8;
    pointer-events: none;
    animation: cta-drift 8s ease-in-out infinite alternate;
  }

  .home-connect h2 {
    font-size: var(--text-xl);
    font-weight: 800;
    margin-bottom: var(--space-2xs);
  }

  .home-connect p {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .home-connect__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .hero-eyebrow,
  .home-hero h1,
  .home-hero__lede,
  .home-hero__actions {
    animation: hero-rise 720ms var(--ease-out) both;
  }

  .home-hero h1 {
    animation-delay: 80ms;
  }

  .home-hero__lede {
    animation-delay: 160ms;
  }

  .home-hero__actions {
    animation-delay: 240ms;
  }

  .hero-spec-card {
    animation: hero-card-in 880ms var(--ease-out) 160ms both;
  }

  .hero-spec-card::before {
    transform: scaleX(0);
    transform-origin: left;
    animation: accent-line-in 680ms var(--ease-out) 520ms forwards;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  @keyframes status-pulse {
    50% {
      opacity: 0.55;
      transform: scale(0.72);
    }
  }

  @keyframes hero-card-in {
    from {
      opacity: 0;
      transform: translateY(1.25rem) scale(0.985);
    }
  }

  @keyframes accent-line-in {
    to {
      transform: scaleX(1);
    }
  }

  @keyframes section-reveal {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }

  @keyframes heading-rule-reveal {
    from {
      opacity: 0;
      transform: scaleX(0);
    }
  }

  @keyframes card-reveal {
    from {
      opacity: 0;
      scale: 0.99;
      translate: 0 1rem;
    }
  }

  @keyframes cta-drift {
    to {
      transform: translate3d(-2rem, 1rem, 0) scale(1.08);
    }
  }

  @supports (animation-timeline: view()) {
    .home-latest,
    .home-pair,
    .home-projects,
    .home-connect {
      animation: section-reveal both;
      animation-duration: 1ms;
      animation-timeline: view();
      animation-range: entry 8% cover 28%;
    }

    .home .section-head h2::after,
    .home :global(.article-card-item),
    .home :global(.project-card-item) {
      animation-duration: 1ms;
      animation-fill-mode: both;
      animation-timeline: view();
      animation-timing-function: var(--ease-out);
    }

    .home .section-head h2::after {
      animation-name: heading-rule-reveal;
      animation-range: entry 12% cover 30%;
    }

    .home :global(.article-card-item),
    .home :global(.project-card-item) {
      animation-name: card-reveal;
      animation-range: entry 4% cover 18%;
    }
  }

  @media (min-width: 54rem) {
    .home-hero {
      grid-template-columns: minmax(0, 1.25fr) minmax(20rem, 0.8fr);
      gap: var(--space-3xl);
      padding-block: var(--space-3xl);
    }

    .home-pair {
      grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
      gap: var(--space-2xl);
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-eyebrow,
    .eyebrow-dot,
    .home-hero h1,
    .home-hero__lede,
    .home-hero__actions,
    .hero-spec-card,
    .hero-spec-card::before,
    .home-latest,
    .home-pair,
    .home-projects,
    .home-connect {
      animation: none;
    }

    .home .section-head h2::after,
    .home :global(.article-card-item),
    .home :global(.project-card-item),
    .home-connect::before {
      animation: none;
    }

    .hero-spec-card::before,
    .btn-primary:hover,
    .btn-primary:active,
    .btn-secondary:hover,
    .btn-secondary:active,
    .home :global(.article-card-item:hover),
    .home :global(.project-card-item:hover),
    .home-topics .topic-cloud a:hover,
    .home-topics .topic-cloud a:active,
    .home-topics .topic-cloud a:hover span.muted {
      transform: none;
    }
  }
</style>
