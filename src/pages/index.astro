---
import { getCollection } from "astro:content";
import ArticleCard from "../components/ArticleCard.astro";
import EmptyState from "../components/EmptyState.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { siteConfig } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { collectTaxonomy, getVisiblePosts } from "../utils/collections";

const posts = await getVisiblePosts();
const latest = posts.slice(0, 5);
const featured = posts.filter((post) => post.data.featured).slice(0, 3);
const tags = collectTaxonomy(posts, "tags");
const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((left, right) => left.data.name.localeCompare(right.data.name))
  .slice(0, 3);
---

<BaseLayout title={siteConfig.name}>
  <div class="shell home">
    <!-- Hero Section -->
    <section class="home-hero">
      <div class="home-hero__copy">
        <div class="hero-eyebrow">
          <span class="eyebrow-dot"></span>
          <span>SYSTEMS × AI ENGINEERING</span>
        </div>
        <h1>把系統做清楚，<br />也把取捨寫下來。</h1>
        <p class="home-hero__lede">
          {
            siteConfig.subtitle
          }。收錄能重現的實作、架構判斷與專案復盤，不追逐只在簡報裡成立的答案。
        </p>
        <div class="home-hero__actions">
          <a class="btn-primary" href="/blog/">
            <span>閱讀文章</span>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a class="btn-secondary" href="/about/">
            <span>認識李卡爾</span>
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>
        </div>
      </div>

      <!-- Publishing Spec Side Widget (Clean SVG bullets, NO emojis) -->
      <div class="hero-spec-card">
        <div class="hero-spec-card__header">
          <span>發布原則與架構</span>
          <span class="spec-tag">GIT-NATIVE</span>
        </div>
        <p class="hero-spec-card__desc">
          所有內容保存在 Git repository
          中；每一次發布皆為純靜態產物，可隨時驗證、離線重建與跨平台遷移。
        </p>
        <ul class="hero-spec-card__list">
          <li>
            <div class="spec-icon-box">
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <div>
              <strong>Markdown / MDX</strong>
              <span>乾淨一手文字與程式碼原始碼</span>
            </div>
          </li>
          <li>
            <div class="spec-icon-box">
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <div>
              <strong>Astro 靜態渲染</strong>
              <span>輕量零膨脹、極致讀取速度</span>
            </div>
          </li>
          <li>
            <div class="spec-icon-box">
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <div>
              <strong>Edge 邊緣部署</strong>
              <span>全站純靜態，全球快速分發</span>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <!-- Latest Articles Section -->
    <section class="section home-latest" aria-labelledby="latest-heading">
      <div class="section-head">
        <h2 id="latest-heading">最新文章</h2>
        <a class="text-link" href="/blog/">
          <span>全部文章</span>
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
      {
        latest.length > 0 ? (
          <div class="article-list">
            {latest.map((post) => (
              <ArticleCard post={post} headingLevel="h3" />
            ))}
          </div>
        ) : (
          <EmptyState
            title="正式文章正在整理"
            description="production build 不會顯示草稿。開發環境可預覽完整的 MDX、程式碼與 Mermaid 示範文章。"
            href="/rss.xml"
            action="先訂閱 RSS"
          />
        )
      }
    </section>

    <!-- Pair Section: Featured & Topics -->
    <div class="home-pair">
      <section class="section" aria-labelledby="featured-heading">
        <div class="section-head">
          <h2 id="featured-heading">精選文章</h2>
          <span class="muted">經過實作驗證的長期參考</span>
        </div>
        {
          featured.length > 0 ? (
            <div class="article-grid">
              {featured.map((post) => (
                <ArticleCard post={post} headingLevel="h3" />
              ))}
            </div>
          ) : (
            <EmptyState
              title="尚未標記精選文章"
              description="文章 frontmatter 設為 featured: true 後，會自動出現在這裡。"
            />
          )
        }
      </section>

      <section class="section home-topics" aria-labelledby="topics-heading">
        <div class="section-head">
          <h2 id="topics-heading">主要技術主題</h2>
          <a class="text-link" href="/tags/">
            <span>標籤總覽</span>
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
        {
          tags.length > 0 ? (
            <ul class="topic-cloud">
              {tags.slice(0, 8).map((tag) => (
                <li>
                  <a href={`/tags/${tag.slug}/`}>
                    <span>{tag.name}</span>
                    <span class="muted">{tag.posts.length}</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <EmptyState
              title="主題會隨文章長出來"
              description="標籤完全由已發布文章自動產生；不在元件內維護另一份分類清單。"
            />
          )
        }
      </section>
    </div>

    <!-- Projects Section -->
    <section class="section home-projects" aria-labelledby="projects-heading">
      <div class="section-head">
        <h2 id="projects-heading">精選開源專案</h2>
        <a class="text-link" href="/projects/">
          <span>全部專案</span>
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
      {
        projects.length > 0 ? (
          <div class="project-grid">
            {projects.map((project) => (
              <ProjectCard project={project} headingLevel="h3" />
            ))}
          </div>
        ) : (
          <EmptyState
            title="尚未設定精選專案"
            description="在 project frontmatter 設定 featured: true 即可加入首頁。"
          />
        )
      }
    </section>

    <!-- Connect / RSS Section -->
    <section class="home-connect" aria-labelledby="connect-heading">
      <div>
        <h2 id="connect-heading">跟上下一次發布</h2>
        <p>RSS 是第一版唯一的訂閱管道；不追蹤開信、不要求登入，純粹乾淨。</p>
      </div>
      <div class="home-connect__actions">
        <a class="btn-primary" href="/rss.xml">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 11a9 9 0 0 1 9 9"></path>
            <path d="M4 4a16 16 0 0 1 16 16"></path>
            <circle cx="5" cy="19" r="1"></circle>
          </svg>
          <span>訂閱 RSS</span>
        </a>
        <a class="btn-secondary" href={siteConfig.github} rel="me">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
            ></path>
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    padding-block-end: var(--space-4xl);
  }

  /* Hero Section */
  .home-hero {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
    padding-block: var(--space-2xl) var(--space-3xl);
    border-block-end: var(--rule-hair) solid var(--color-rule);
  }

  .home-hero__copy {
    min-width: 0;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-md);
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    background: var(--color-accent);
    border-radius: 50%;
  }

  .home-hero h1 {
    font-size: var(--text-display);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.035em;
    margin-bottom: var(--space-md);
  }

  .home-hero__lede {
    max-width: 36rem;
    font-size: var(--text-md);
    color: var(--color-muted);
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    align-items: center;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-inline: var(--space-lg);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: #ffffff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 4px 14px rgba(217, 93, 57, 0.25);
    transition: all var(--dur-micro) var(--ease-out);
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(217, 93, 57, 0.35);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding-inline: var(--space-md);
    border-radius: var(--radius-pill);
    background: var(--color-paper-2);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    text-decoration: none;
    white-space: nowrap;
    transition: all var(--dur-micro) var(--ease-out);
  }

  .btn-secondary:hover {
    background: var(--color-card);
    transform: translateY(-1px);
  }

  /* Hero Side Spec Widget */
  .hero-spec-card {
    background: var(--color-card);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl);
    box-shadow: var(--shadow-sm);
    position: relative;
  }

  .hero-spec-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: var(--space-2xl);
    right: var(--space-2xl);
    height: 3px;
    background: var(--color-accent);
    border-radius: 0 0 4px 4px;
  }

  .hero-spec-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: var(--space-sm);
  }

  .spec-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .hero-spec-card__desc {
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.6;
    margin-bottom: var(--space-lg);
  }

  .hero-spec-card__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: 0;
  }

  .hero-spec-card__list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .spec-icon-box {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-secondary-soft);
    color: var(--color-secondary);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .hero-spec-card__list strong {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-ink);
  }

  .hero-spec-card__list span {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  /* Sections */
  .home .section {
    border-block-start: 0;
  }

  .home-latest {
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  .home-pair {
    display: grid;
    gap: var(--space-xl);
  }

  .home-projects {
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  /* Connect CTA */
  .home-connect {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-xl);
    margin-block-start: var(--space-3xl);
    padding: var(--space-2xl);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-card);
    box-shadow: var(--shadow-sm);
  }

  .home-connect h2 {
    font-size: var(--text-xl);
    font-weight: 800;
    margin-bottom: var(--space-2xs);
  }

  .home-connect p {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .home-connect__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  @media (min-width: 54rem) {
    .home-hero {
      grid-template-columns: minmax(0, 1.25fr) minmax(22rem, 0.85fr);
      gap: var(--space-3xl);
      padding-block: var(--space-3xl) var(--space-4xl);
    }

    .home-pair {
      grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
      gap: var(--space-2xl);
      align-items: start;
    }
  }
</style>
