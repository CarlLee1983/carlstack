---
import { getCollection } from "astro:content";
import ArticleCard from "../components/ArticleCard.astro";
import EmptyState from "../components/EmptyState.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { siteConfig } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { collectTaxonomy, getVisiblePosts } from "../utils/collections";

const posts = await getVisiblePosts();
const latest = posts.slice(0, 5);
const featured = posts.filter((post) => post.data.featured).slice(0, 3);
const tags = collectTaxonomy(posts, "tags");
const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((left, right) => left.data.name.localeCompare(right.data.name))
  .slice(0, 3);
---

<BaseLayout title={siteConfig.name}>
  <div class="shell home">
    <section class="home-hero">
      <div>
        <p class="eyebrow">Systems × AI Engineering</p>
        <h1>把系統做清楚，也把取捨寫下來。</h1>
      </div>
      <div class="home-hero__intro">
        <p>
          {
            siteConfig.subtitle
          }。這裡收錄能重現的實作、架構判斷與專案復盤，不追逐只在簡報裡成立的答案。
        </p>
        <p><a class="text-link" href="/about/">認識李卡爾 →</a></p>
      </div>
    </section>

    <section class="section" aria-labelledby="latest-heading">
      <div class="section-head">
        <h2 id="latest-heading">最新文章</h2>
        <a href="/blog/">全部文章 →</a>
      </div>
      {
        latest.length > 0 ? (
          <div class="article-list">
            {latest.map((post) => (
              <ArticleCard post={post} headingLevel="h3" />
            ))}
          </div>
        ) : (
          <EmptyState
            title="正式文章正在整理"
            description="production build 不會顯示草稿。開發環境可預覽完整的 MDX、程式碼與 Mermaid 示範文章。"
            href="/rss.xml"
            action="先訂閱 RSS"
          />
        )
      }
    </section>

    <section class="section" aria-labelledby="featured-heading">
      <div class="section-head">
        <h2 id="featured-heading">精選文章</h2>
        <span class="muted">經過實作驗證的長期參考</span>
      </div>
      {
        featured.length > 0 ? (
          <div class="article-grid">
            {featured.map((post) => (
              <ArticleCard post={post} headingLevel="h3" />
            ))}
          </div>
        ) : (
          <EmptyState
            title="尚未標記精選文章"
            description="文章 frontmatter 設為 featured: true 後，會自動出現在這裡。"
          />
        )
      }
    </section>

    <section class="section" aria-labelledby="topics-heading">
      <div class="section-head">
        <h2 id="topics-heading">主要技術主題</h2>
        <a href="/tags/">標籤總覽 →</a>
      </div>
      {
        tags.length > 0 ? (
          <ul class="topic-cloud">
            {tags.slice(0, 8).map((tag) => (
              <li>
                <a href={`/tags/${tag.slug}/`}>
                  <span>{tag.name}</span>
                  <span class="muted">{tag.posts.length}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <EmptyState
            title="主題會隨文章長出來"
            description="標籤完全由已發布文章自動產生；不在元件內維護另一份分類清單。"
          />
        )
      }
    </section>

    <section class="section" aria-labelledby="projects-heading">
      <div class="section-head">
        <h2 id="projects-heading">精選 GitHub 專案</h2>
        <a href="/projects/">全部專案 →</a>
      </div>
      {
        projects.length > 0 ? (
          <div class="project-grid">
            {projects.map((project) => (
              <ProjectCard project={project} headingLevel="h3" />
            ))}
          </div>
        ) : (
          <EmptyState
            title="尚未設定精選專案"
            description="在 project frontmatter 設定 featured: true 即可加入首頁。"
          />
        )
      }
    </section>

    <section class="home-connect" aria-labelledby="connect-heading">
      <h2 id="connect-heading">跟上下一次發布</h2>
      <p>RSS 是第一版唯一的訂閱管道；不追蹤開信、不要求登入。</p>
      <div>
        <a class="button-link" href="/rss.xml">訂閱 RSS</a>
        <a class="text-link" href={siteConfig.github} rel="me">GitHub →</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    padding-block-end: var(--space-4xl);
  }

  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
    gap: var(--space-2xl);
    align-items: end;
    padding-block: clamp(var(--space-xl), 6vw, var(--space-3xl))
      clamp(var(--space-2xl), 10vw, var(--space-4xl));
  }

  .home-hero h1 {
    max-width: 12ch;
    margin-block-start: var(--space-md);
    font-size: var(--text-display);
  }

  .home-hero__intro {
    display: grid;
    gap: var(--space-lg);
    padding-block-end: var(--space-xs);
    font-size: var(--text-md);
  }

  .home-connect {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.7fr);
    gap: var(--space-md) var(--space-2xl);
    align-items: center;
    margin-block-start: var(--space-2xl);
    padding: var(--space-xl);
    border: var(--rule-hair) solid var(--color-rule);
    background: var(--color-paper-2);
    color: var(--color-ink-2);
  }

  .home-connect h2 {
    font-size: var(--text-2xl);
  }

  .home-connect > div {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    align-items: center;
  }

  .button-link {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    padding-inline: var(--space-md);
    border-radius: var(--radius-sm);
    background: var(--color-ink);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .button-link:active {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  @media (max-width: 59.99rem) {
    .home-hero,
    .home-connect {
      grid-template-columns: minmax(0, 1fr);
    }

    .home-connect > div {
      grid-column: 1;
    }
  }
</style>
