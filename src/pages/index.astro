---
import { getCollection } from "astro:content";
import ArticleCard from "../components/ArticleCard.astro";
import EmptyState from "../components/EmptyState.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { siteConfig } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { collectTaxonomy, getVisiblePosts } from "../utils/collections";

const posts = await getVisiblePosts();
const latest = posts.slice(0, 5);
const featured = posts.filter((post) => post.data.featured).slice(0, 3);
const tags = collectTaxonomy(posts, "tags");
const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((left, right) => left.data.name.localeCompare(right.data.name))
  .slice(0, 3);
---

<BaseLayout title={siteConfig.name}>
  <div class="shell home">
    <section class="home-hero">
      <div class="home-hero__copy">
        <p class="eyebrow">Systems × AI Engineering</p>
        <h1>把系統做清楚，也把取捨寫下來。</h1>
        <p class="home-hero__lede">
          {
            siteConfig.subtitle
          }。收錄能重現的實作、架構判斷與專案復盤，不追逐只在簡報裡成立的答案。
        </p>
        <div class="home-hero__actions">
          <a class="button-link" href="/blog/">閱讀文章</a>
          <a class="text-link" href="/about/">認識李卡爾 →</a>
        </div>
      </div>

      <figure class="home-blueprint" aria-labelledby="blueprint-caption">
        <figcaption id="blueprint-caption">
          <span>Publishing path</span>
          <span>repository → reader</span>
        </figcaption>
        <ol class="home-blueprint__flow">
          <li>
            <span>Source</span>
            <strong>Markdown / MDX</strong>
          </li>
          <li>
            <span>Build</span>
            <strong>Astro / TypeScript</strong>
          </li>
          <li>
            <span>Ship</span>
            <strong>Static / Cloudflare</strong>
          </li>
        </ol>
        <p>內容留在 Git；每一次發布都能檢查、重建，也能離開框架。</p>
      </figure>
    </section>

    <section class="section home-latest" aria-labelledby="latest-heading">
      <div class="section-head">
        <h2 id="latest-heading">最新文章</h2>
        <a href="/blog/">全部文章 →</a>
      </div>
      {
        latest.length > 0 ? (
          <div class="article-list">
            {latest.map((post) => (
              <ArticleCard post={post} headingLevel="h3" />
            ))}
          </div>
        ) : (
          <EmptyState
            title="正式文章正在整理"
            description="production build 不會顯示草稿。開發環境可預覽完整的 MDX、程式碼與 Mermaid 示範文章。"
            href="/rss.xml"
            action="先訂閱 RSS"
          />
        )
      }
    </section>

    <div class="home-pair">
      <section class="section" aria-labelledby="featured-heading">
        <div class="section-head">
          <h2 id="featured-heading">精選文章</h2>
          <span class="muted">經過實作驗證的長期參考</span>
        </div>
        {
          featured.length > 0 ? (
            <div class="article-grid">
              {featured.map((post) => (
                <ArticleCard post={post} headingLevel="h3" />
              ))}
            </div>
          ) : (
            <EmptyState
              title="尚未標記精選文章"
              description="文章 frontmatter 設為 featured: true 後，會自動出現在這裡。"
            />
          )
        }
      </section>

      <section class="section home-topics" aria-labelledby="topics-heading">
        <div class="section-head">
          <h2 id="topics-heading">主要技術主題</h2>
          <a href="/tags/">標籤總覽 →</a>
        </div>
        {
          tags.length > 0 ? (
            <ul class="topic-cloud">
              {tags.slice(0, 8).map((tag) => (
                <li>
                  <a href={`/tags/${tag.slug}/`}>
                    <span>{tag.name}</span>
                    <span class="muted">{tag.posts.length}</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <EmptyState
              title="主題會隨文章長出來"
              description="標籤完全由已發布文章自動產生；不在元件內維護另一份分類清單。"
            />
          )
        }
      </section>
    </div>

    <section class="section home-projects" aria-labelledby="projects-heading">
      <div class="section-head">
        <h2 id="projects-heading">精選 GitHub 專案</h2>
        <a href="/projects/">全部專案 →</a>
      </div>
      {
        projects.length > 0 ? (
          <div class="project-grid">
            {projects.map((project) => (
              <ProjectCard project={project} headingLevel="h3" />
            ))}
          </div>
        ) : (
          <EmptyState
            title="尚未設定精選專案"
            description="在 project frontmatter 設定 featured: true 即可加入首頁。"
          />
        )
      }
    </section>

    <section class="home-connect" aria-labelledby="connect-heading">
      <h2 id="connect-heading">跟上下一次發布</h2>
      <p>RSS 是第一版唯一的訂閱管道；不追蹤開信、不要求登入。</p>
      <div>
        <a class="button-link" href="/rss.xml">訂閱 RSS</a>
        <a class="text-link" href={siteConfig.github} rel="me">GitHub →</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V4
   * Hallmark · genre: editorial · macrostructure: Split Studio · theme: Almanac
   * enrichment: E5 tier-A CSS system blueprint · nav: N13 retained · footer: Ft1 retained
   * tone: technical/editorial · audience: zh-Hant systems and AI engineers
   * use: read and explore projects · anchor hue: cobalt
   */
  .home {
    padding-block-end: var(--space-4xl);
  }

  .home-hero {
    display: grid;
    gap: var(--space-xl);
    min-height: clamp(34rem, 76dvh, 46rem);
    align-items: center;
    padding-block: var(--space-xl) var(--space-3xl);
    border-block-end: var(--rule-hair) solid var(--color-rule);
  }

  .home-hero__copy {
    min-width: 0;
  }

  .home-hero h1 {
    max-width: 11ch;
    margin-block-start: var(--space-md);
    font-size: var(--text-display);
    line-height: 1.03;
  }

  .home-hero__lede {
    max-width: 34rem;
    margin-block-start: var(--space-lg);
    font-size: var(--text-md);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    align-items: center;
    margin-block-start: var(--space-xl);
  }

  .home-blueprint {
    position: relative;
    display: grid;
    min-width: 0;
    gap: var(--space-lg);
    margin: 0;
    padding: var(--space-lg);
    border-block: var(--rule-hair) solid var(--color-rule-2);
    background-color: var(--color-paper-2);
    background-image:
      linear-gradient(
        var(--color-rule) var(--rule-hair),
        transparent var(--rule-hair)
      ),
      linear-gradient(
        90deg,
        var(--color-rule) var(--rule-hair),
        transparent var(--rule-hair)
      );
    background-size: var(--space-lg) var(--space-lg);
  }

  .home-blueprint figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
    padding-block-end: var(--space-sm);
    border-block-end: var(--rule-hair) solid var(--color-rule-2);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .home-blueprint__flow {
    display: grid;
    gap: var(--space-lg);
    padding: 0;
    list-style: none;
  }

  .home-blueprint__flow li {
    position: relative;
    display: grid;
    min-width: 0;
    gap: var(--space-xs);
    padding: var(--space-md);
    border: var(--rule-hair) solid var(--color-rule-2);
    background: var(--color-paper);
  }

  .home-blueprint__flow li:not(:last-child)::after {
    content: "↓";
    position: absolute;
    inset-block-end: calc(var(--space-lg) * -1);
    inset-inline-start: 50%;
    z-index: var(--z-raised);
    color: var(--color-accent);
    font-family: var(--font-mono);
    transform: translate(-50%, 50%);
  }

  .home-blueprint__flow span,
  .home-blueprint > p {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .home-blueprint__flow strong {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-sm);
  }

  .home-blueprint > p {
    max-width: 48ch;
  }

  .home .section {
    border-block-start: 0;
  }

  .home .section-head {
    align-items: flex-end;
  }

  .home .section-head h2 {
    font-size: var(--text-2xl);
  }

  .home-latest {
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  .home-pair {
    display: grid;
    gap: var(--space-xl);
  }

  .home-pair .section {
    padding: var(--space-xl);
    background: var(--color-paper-2);
  }

  .home-topics {
    align-self: start;
  }

  .home-projects {
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  .home-projects .project-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .home-connect {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-md) var(--space-2xl);
    align-items: center;
    margin-block-start: var(--space-2xl);
    padding: var(--space-xl) clamp(var(--space-lg), 5vw, var(--space-2xl));
    border: var(--rule-hair) solid var(--color-rule);
    background: var(--color-paper-2);
    color: var(--color-ink-2);
  }

  .home-connect h2 {
    font-size: var(--text-2xl);
  }

  .home-connect > div {
    grid-column: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    align-items: center;
  }

  .button-link {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    padding-inline: var(--space-md);
    border-radius: var(--radius-sm);
    background: var(--color-ink);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: transform var(--dur-micro) var(--ease-out);
  }

  .button-link:active {
    background: var(--color-accent);
    color: var(--color-accent-ink);
    transform: translateY(1px);
  }

  @media (hover: hover) and (pointer: fine) {
    .button-link:hover {
      transform: translateY(-1px);
    }
  }

  @media (min-width: 40rem) {
    .home-blueprint__flow {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-md);
    }

    .home-blueprint__flow li:not(:last-child)::after {
      content: "→";
      inset-block-end: auto;
      inset-block-start: 50%;
      inset-inline-start: auto;
      inset-inline-end: calc(var(--space-md) * -1);
      transform: translate(50%, -50%);
    }

    .home-projects .project-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
      align-items: start;
    }

    .home-projects .project-grid > :global(.project-card:nth-child(even)) {
      margin-block-start: var(--space-2xl);
    }
  }

  @media (min-width: 60rem) {
    .home-hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(24rem, 0.95fr);
      gap: var(--space-3xl);
      padding-block: var(--space-2xl) var(--space-4xl);
    }

    .home-pair {
      grid-template-columns: minmax(0, 1.2fr) minmax(20rem, 0.8fr);
      gap: var(--space-2xl);
      align-items: start;
    }

    .home-topics {
      margin-block-start: var(--space-3xl);
    }

    .home-connect {
      grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.7fr);
    }

    .home-connect > div {
      grid-column: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button-link {
      transition: none;
    }

    .button-link:hover,
    .button-link:active {
      transform: none;
    }
  }
</style>
