---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="找不到頁面"
  description="這個 CarlStack 頁面不存在或已移動。"
  noindex
>
  <div class="page shell not-found">
    <div class="not-found__layout">
      <div class="not-found__content">
        <div class="hero-eyebrow">
          <span class="eyebrow-dot"></span>
          <span>HTTP 404 · ROUTE UNRESOLVED</span>
        </div>
        <h1>這個路徑沒有內容。</h1>
        <p class="not-found__desc">
          可能是網址端點更新、文章尚未公開，或輸入了不存在的路由。您可以嘗試搜尋關鍵字，或從下方主要索引重新導向。
        </p>

        <form
          class="not-found__search"
          action="/search/"
          method="get"
          role="search"
        >
          <label class="visually-hidden" for="not-found-query"
            >搜尋 CarlStack</label
          >
          <svg
            class="not-found__search-icon"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            id="not-found-query"
            name="q"
            type="search"
            placeholder="搜尋技術名詞、架構或文章…"
            required
          />
          <button type="submit">搜尋</button>
        </form>

        <nav class="not-found__nav" aria-label="推薦導覽路徑">
          <span class="not-found__nav-label">推薦導向：</span>
          <div class="not-found__chips">
            <a class="nav-chip" href="/blog/">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path
                  d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"
                ></path>
              </svg>
              <span>文章索引</span>
            </a>
            <a class="nav-chip" href="/series/">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
              <span>技術系列</span>
            </a>
            <a class="nav-chip" href="/tags/">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path
                  d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"
                ></path>
                <line x1="7" y1="7" x2="7.01" y2="7"></line>
              </svg>
              <span>主題標籤</span>
            </a>
            <a class="nav-chip" href="/projects/">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
              <span>開源專案</span>
            </a>
          </div>
        </nav>
      </div>

      <div class="not-found__diagram-card" aria-hidden="true">
        <div class="diagram-card__header">
          <span class="diagram-card__dot"></span>
          <span class="diagram-card__title">ROUTING GRAPH STATUS</span>
        </div>
        <svg
          class="not-found__diagram"
          viewBox="0 0 320 220"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <!-- Grid Background lines -->
          <line
            x1="20"
            y1="50"
            x2="300"
            y2="50"
            stroke="var(--color-rule)"
            stroke-dasharray="3 3"></line>
          <line
            x1="20"
            y1="110"
            x2="300"
            y2="110"
            stroke="var(--color-rule)"
            stroke-dasharray="3 3"></line>
          <line
            x1="20"
            y1="170"
            x2="300"
            y2="170"
            stroke="var(--color-rule)"
            stroke-dasharray="3 3"></line>

          <!-- Paths from Gateway -->
          <!-- Path to target (broken) -->
          <path
            d="M 60 110 L 140 110 L 220 50"
            stroke="var(--color-error)"
            stroke-width="2"
            stroke-dasharray="4 4"></path>
          <!-- Path to Fallback -->
          <path
            d="M 140 110 L 220 170"
            stroke="var(--color-secondary)"
            stroke-width="2"></path>

          <!-- Node: Client Request -->
          <rect
            x="20"
            y="90"
            width="80"
            height="40"
            rx="8"
            fill="var(--color-paper-2)"
            stroke="var(--color-rule-2)"
            stroke-width="1.5"></rect>
          <text
            x="60"
            y="115"
            text-anchor="middle"
            fill="var(--color-ink)"
            font-family="var(--font-mono)"
            font-size="11"
            font-weight="600">REQ /uri</text
          >

          <!-- Router Midpoint -->
          <circle
            cx="140"
            cy="110"
            r="14"
            fill="var(--color-card)"
            stroke="var(--color-rule-2)"
            stroke-width="2"></circle>
          <path
            d="M 136 106 L 144 114 M 144 106 L 136 114"
            stroke="var(--color-muted)"
            stroke-width="1.5"
            stroke-linecap="round"></path>

          <!-- Node: 404 Missing Target -->
          <rect
            x="220"
            y="30"
            width="80"
            height="40"
            rx="8"
            fill="var(--color-card)"
            stroke="var(--color-error)"
            stroke-width="1.5"
            stroke-dasharray="3 3"></rect>
          <text
            x="260"
            y="55"
            text-anchor="middle"
            fill="var(--color-error)"
            font-family="var(--font-mono)"
            font-size="11"
            font-weight="700">404 NULL</text
          >

          <!-- Node: Fallback Index -->
          <rect
            x="220"
            y="150"
            width="80"
            height="40"
            rx="8"
            fill="var(--color-card)"
            stroke="var(--color-secondary)"
            stroke-width="1.5"></rect>
          <text
            x="260"
            y="175"
            text-anchor="middle"
            fill="var(--color-secondary)"
            font-family="var(--font-mono)"
            font-size="11"
            font-weight="600">INDEX OK</text
          >
        </svg>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--space-3xl) var(--space-4xl);
  }

  .not-found__layout {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .not-found__layout {
      grid-template-columns: minmax(0, 1.3fr) minmax(18rem, 1fr);
      gap: var(--space-3xl);
    }
  }

  .not-found__content {
    display: grid;
    gap: var(--space-md);
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    width: fit-content;
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .not-found h1 {
    font-size: clamp(2.2rem, 5vw, var(--text-3xl));
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .not-found__desc {
    max-width: 36rem;
    color: var(--color-muted);
    font-size: var(--text-md);
    line-height: 1.75;
    text-wrap: pretty;
  }

  .not-found__search {
    display: flex;
    align-items: center;
    max-width: 32rem;
    margin-block-start: var(--space-xs);
    padding: 0.35rem 0.45rem 0.35rem var(--space-md);
    border: var(--rule-hair) solid var(--color-rule-2);
    border-radius: var(--radius-pill);
    background: var(--color-card);
    box-shadow: var(--shadow-sm), var(--card-highlight);
    transition:
      border-color var(--dur-micro) var(--ease-out),
      box-shadow var(--dur-micro) var(--ease-out);
  }

  .not-found__search:focus-within {
    border-color: var(--color-focus);
    box-shadow:
      var(--shadow-md),
      0 0 0 3px var(--color-accent-soft);
  }

  .not-found__search-icon {
    flex-shrink: 0;
    color: var(--color-muted);
    margin-right: var(--space-xs);
  }

  .not-found__search input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    color: var(--color-ink);
    font-size: var(--text-sm);
    outline: none;
  }

  .not-found__search button {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem var(--space-md);
    border: none;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-size: var(--text-xs);
    font-weight: 700;
    cursor: pointer;
    transition:
      background-color var(--dur-micro) var(--ease-out),
      transform var(--dur-micro) var(--ease-out);
  }

  .not-found__search button:hover {
    background: var(--color-accent-hover);
    transform: translateY(-1px);
  }

  .not-found__search button:active {
    transform: translateY(0) scale(0.97);
  }

  .not-found__nav {
    display: grid;
    gap: var(--space-xs);
    margin-block-start: var(--space-md);
  }

  .not-found__nav-label {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-muted);
  }

  .not-found__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .nav-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.25rem;
    padding: 0.35rem 0.85rem;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-pill);
    background: var(--color-paper-2);
    color: var(--color-ink-2);
    font-size: var(--text-xs);
    font-weight: 600;
    text-decoration: none;
    transition: all var(--dur-micro) var(--ease-out);
  }

  .nav-chip:hover {
    background: var(--color-card);
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .nav-chip:active {
    transform: translateY(0) scale(0.98);
  }

  /* Diagram Card */
  .not-found__diagram-card {
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-card);
    padding: var(--space-lg);
    box-shadow: var(--shadow-md), var(--card-highlight);
    display: grid;
    gap: var(--space-sm);
  }

  .diagram-card__header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: var(--space-xs);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .diagram-card__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-error);
  }

  .diagram-card__title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .not-found__diagram {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
