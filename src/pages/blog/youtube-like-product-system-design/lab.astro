---
import VideoProductLabPublishGateDiagram from "../../../components/VideoProductLabPublishGateDiagram.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getVisiblePosts, postHref } from "../../../utils/collections";
import { getEntrySlug } from "../../../utils/content";

const articleSlug = "youtube-like-product-system-design";
const posts = await getVisiblePosts();
const article = posts.find((post) => getEntrySlug(post.id) === articleSlug);
if (!article) {
  throw new Error(`找不到機制實驗室對應的概念長文：${articleSlug}`);
}

const articleHref = postHref(article);
// 長文 §6 標題由 Astro 依標題文字產生的 id
const publishSectionHref = `${articleHref}#6-轉碼工作可以重跑發布只能接受仍有效的產物`;
---

<BaseLayout
  title="機制實驗室：設計 YouTube 類影音平台"
  description="動手操作〈設計 YouTube 類影音平台〉的關鍵機制：選一個故障情境，看舊 token 的產物如何在驗印閘門被擋下，讀數即時更新。"
  image={article.data.cover?.src}
  imageAlt={article.data.coverAlt}
>
  <div class="page shell lab-page">
    <header class="lab-header">
      <h1>機制實驗室：設計 YouTube 類影音平台</h1>
      <p class="lab-header__intro">
        這裡把<a href={articleHref}>概念長文</a>
        裡最容易讀過去的機制做成可以操作的圖。每張圖都有幾個情境按鈕，按下其中一個就能看零件依步驟動作，旁邊的讀數會同步更新；播完後有簡短說明，按重設可以回到起點。
      </p>
    </header>

    <section
      id="publish-gate"
      class="lab-section"
      aria-labelledby="publish-gate-title"
    >
      <h2 id="publish-gate-title">
        §6 發布閘門：舊 token 的產物進不了播放清單
      </h2>
      <VideoProductLabPublishGateDiagram />
      <p class="lab-section__back">
        <a href={publishSectionHref}>回到長文 §6，看完整的發布規則</a>
      </p>
    </section>

    <footer class="lab-footer">
      <a href={articleHref}>回到長文：{article.data.title}</a>
    </footer>
  </div>
</BaseLayout>

<style>
  .lab-page {
    max-width: var(--prose-width);
    margin-inline: auto;
    min-width: 0;
  }

  .lab-header {
    margin-block: var(--space-2xl) var(--space-xl);
  }

  .lab-header h1 {
    color: var(--color-ink);
    font-family: var(--font-display);
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .lab-header__intro {
    color: var(--color-ink-2);
    line-height: 1.9;
  }

  .lab-page a {
    color: var(--color-accent);
    text-underline-offset: 0.2em;
  }

  .lab-page a:hover {
    color: var(--color-accent-hover);
  }

  .lab-section {
    min-width: 0;
    margin-block: var(--space-2xl);
  }

  .lab-section h2 {
    color: var(--color-ink);
    font-family: var(--font-display);
    line-height: 1.3;
    scroll-margin-top: 5rem;
    padding-block-end: var(--space-xs);
    border-block-end: var(--rule-hair) solid var(--color-rule);
  }

  .lab-footer {
    margin-block: var(--space-2xl);
    padding-block-start: var(--space-lg);
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }
</style>
