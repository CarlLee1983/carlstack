---
import BlogArchive from "../../components/BlogArchive.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getVisiblePosts } from "../../utils/collections";
import { paginate } from "../../utils/pagination";

const posts = await getVisiblePosts();
const pagination = paginate(posts, 1);
---

<BaseLayout
  title="全部文章"
  description="CarlStack 的系統工程、AI 工程化、API 整合與專案復盤文章。"
>
  <BlogArchive pagination={pagination} totalPosts={posts.length} />
</BaseLayout>
