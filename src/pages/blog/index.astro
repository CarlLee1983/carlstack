---
import ArticleCard from "../../components/ArticleCard.astro";
import EmptyState from "../../components/EmptyState.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getVisiblePosts } from "../../utils/collections";

const posts = await getVisiblePosts();
---

<BaseLayout
  title="全部文章"
  description="CarlStack 的系統工程、AI 工程化、API 整合與專案復盤文章。"
>
  <div class="page shell blog-page">
    <header class="page-header blog-header">
      <p class="eyebrow">
        Writing archive / {String(posts.length).padStart(2, "0")}
      </p>
      <div class="blog-header__copy">
        <h1>文章索引</h1>
        <p>記錄系統設計、AI Agent 工作流，以及實際專案裡值得保留的技術取捨。</p>
      </div>
      <a class="text-link" href="/tags/">依主題瀏覽 →</a>
    </header>
    {
      posts.length > 0 ? (
        <ol class="blog-list">
          {posts.map((post) => (
            <li>
              <ArticleCard post={post} />
            </li>
          ))}
        </ol>
      ) : (
        <EmptyState
          title="還沒有正式文章"
          description="新增 Markdown 或 MDX 檔並將 draft 設為 false 後，文章會自動出現在這裡、RSS、Sitemap 與搜尋索引。"
          href="/rss.xml"
          action="訂閱 RSS"
        />
      )
    }
  </div>
</BaseLayout>

<style>
  .blog-header {
    grid-template-columns: minmax(0, 1fr) auto;
    max-width: none;
    align-items: end;
    margin-block-end: 0;
    padding-block-end: var(--space-xl);
    border-block-end: var(--rule-hair) solid var(--color-rule);
  }

  .blog-header .eyebrow {
    grid-column: 1 / -1;
  }

  .blog-header__copy {
    display: grid;
    min-width: 0;
    gap: var(--space-md);
  }

  .blog-header__copy p {
    max-width: 46rem;
  }

  .blog-list {
    display: grid;
    counter-reset: article;
    padding: 0;
    list-style: none;
  }

  .blog-list li {
    min-width: 0;
    counter-increment: article;
  }

  .blog-list :global(.article-card) {
    position: relative;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--space-xs) var(--space-lg);
    padding: var(--space-xl) var(--space-md);
    border-width: 0 0 var(--rule-hair);
    border-radius: 0;
    transition:
      background-color var(--dur-short) var(--ease-out),
      border-color var(--dur-short) var(--ease-out);
  }

  .blog-list :global(.article-card)::before {
    content: counter(article, decimal-leading-zero);
    grid-row: 1 / span 2;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  .blog-list :global(.article-card > div:first-of-type) {
    grid-column: 2;
    grid-row: 2;
    min-width: 0;
  }

  .blog-list :global(.article-card__meta) {
    grid-column: 2;
    grid-row: 1;
  }

  .blog-list :global(.article-card h2) {
    max-width: 28ch;
    font-size: clamp(1.45rem, 3vw, var(--text-2xl));
    text-wrap: balance;
  }

  .blog-list :global(.article-card p) {
    max-width: 65ch;
    margin-block-start: var(--space-sm);
    text-wrap: pretty;
  }

  @media (hover: hover) and (pointer: fine) {
    .blog-list :global(.article-card:hover) {
      border-color: var(--color-accent);
      background: var(--color-paper-2);
    }

    .blog-list :global(.article-card:hover::before),
    .blog-list :global(.article-card:hover h2) {
      color: var(--color-accent);
    }
  }

  @media (max-width: 40rem) {
    .blog-header {
      grid-template-columns: 1fr;
    }

    .blog-header .eyebrow {
      grid-column: auto;
    }

    .blog-header .text-link {
      justify-self: start;
    }

    .blog-list :global(.article-card) {
      grid-template-columns: 2.25rem minmax(0, 1fr);
      gap: var(--space-xs) var(--space-sm);
      padding-inline: 0;
    }

    .blog-list :global(.article-card h2) {
      font-size: var(--text-lg);
    }
  }
</style>
