---
import { getCollection } from "astro:content";
import EmptyState from "../../components/EmptyState.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = (await getCollection("projects")).sort((left, right) => {
  if (left.data.featured !== right.data.featured)
    return left.data.featured ? -1 : 1;
  return left.data.name.localeCompare(right.data.name);
});
---

<BaseLayout
  title="開源專案與作品"
  description="李卡爾的開源工具、API 文件工程與 release engineering 專案。"
>
  <div class="page shell">
    <header class="page-header">
      <h1>開源專案與作品</h1>
      <p>
        從 Agent 的資料存取、API 文件工程到 Git release
        護欄，這些工具都從實際工作流程裡長出來，並以可驗證、可自動化與最小權限為共同原則。
      </p>
    </header>
    {
      projects.length > 0 ? (
        <div class="project-grid">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      ) : (
        <EmptyState
          title="尚未加入專案"
          description="在 src/content/projects 新增 Markdown 後，專案會自動出現在這裡。"
        />
      )
    }
  </div>
</BaseLayout>

<style>
  .project-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    align-items: start;
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-grid :global(.project-card-item) {
      animation: project-card-enter 520ms both var(--ease-out);
    }

    .project-grid :global(.project-card-item:nth-child(2)) {
      animation-delay: 70ms;
    }

    .project-grid :global(.project-card-item:nth-child(3)) {
      animation-delay: 140ms;
    }

    .project-grid :global(.project-card-item:nth-child(4)) {
      animation-delay: 210ms;
    }
  }

  @keyframes project-card-enter {
    from {
      opacity: 0;
      transform: translateY(1rem) rotate(-0.35deg);
    }
  }
</style>
