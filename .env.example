# 正式 canonical、RSS、Sitemap 與社群分享 URL。未設定時使用保留的 .example 網域。
SITE_URL=https://blog.example.com

# Giscus：四個必要值都設定後才會顯示留言區。
PUBLIC_GISCUS_REPO=CarlLee1983/carlstack
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=

# Cloudflare Web Analytics（選填；也可在 Cloudflare 控制台啟用）。
PUBLIC_CF_ANALYTICS_TOKEN=
